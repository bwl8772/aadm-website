{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://mcp.aadm.io/schemas/aadm-config.v1.schema.json",
	"title": "AADM Config v1.0",
	"description": "Shared governance configuration for agentic coders (Claude Code, Cursor, GitHub Actions, custom agents). Single source of truth for AADM enforcement context.",
	"type": "object",
	"required": ["version", "metadata", "aadm_server", "repo_governance"],
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string",
			"description": "JSON Schema URL for IDE validation"
		},
		"version": {
			"type": "string",
			"enum": ["1.0"],
			"description": "Config schema version; breaking changes increment major version"
		},
		"metadata": { "$ref": "#/definitions/metadata" },
		"aadm_server": { "$ref": "#/definitions/aadm_server" },
		"repo_governance": { "$ref": "#/definitions/repo_governance" },
		"enforcement": { "$ref": "#/definitions/enforcement" },
		"attestation": { "$ref": "#/definitions/attestation" },
		"tool_routing": { "$ref": "#/definitions/tool_routing" },
		"tool_specific": { "$ref": "#/definitions/tool_specific" },
		"discovery": { "$ref": "#/definitions/discovery" }
	},
	"definitions": {
		"auth_id": {
			"type": "string",
			"pattern": "^AUTH-\\d{2}$",
			"description": "AADM AUTH control ID (AUTH-00 through AUTH-47)"
		},
		"seam_id": {
			"type": "string",
			"pattern": "^SEAM-\\d{2}$",
			"description": "AADM SEAM archetype ID (SEAM-00 through SEAM-15)"
		},
		"udali_layer": {
			"type": "string",
			"pattern": "^L([1-9]|1[0-9]|2[0-2])$",
			"description": "UDALI layer ID (L1 through L22)"
		},
		"gate_type": {
			"type": "string",
			"enum": ["pre-commit", "pre-merge", "on-save", "ci", "release"]
		},
		"severity": {
			"type": "string",
			"enum": ["must-enforce", "advisory", "optional"]
		},
		"auth_method": {
			"type": "string",
			"enum": ["bearer", "oauth", "none"]
		},
		"lane": {
			"type": "string",
			"enum": ["delivery", "defect", "assurance"]
		},
		"assurance_depth": {
			"type": "string",
			"enum": ["narrow", "standard", "expansive"]
		},
		"metadata": {
			"type": "object",
			"required": [
				"repo_name",
				"repo_url",
				"maintained_by",
				"last_updated",
				"description"
			],
			"additionalProperties": false,
			"properties": {
				"repo_name": { "type": "string", "description": "Repository name" },
				"repo_url": {
					"type": "string",
					"format": "uri",
					"description": "Repository URL"
				},
				"maintained_by": {
					"type": "string",
					"format": "email",
					"description": "Team contact email"
				},
				"last_updated": {
					"type": "string",
					"format": "date-time",
					"description": "ISO 8601 timestamp"
				},
				"description": {
					"type": "string",
					"maxLength": 200,
					"description": "One-line governance intent"
				}
			}
		},
		"aadm_server": {
			"type": "object",
			"required": ["endpoint", "auth"],
			"additionalProperties": false,
			"properties": {
				"endpoint": {
					"type": "string",
					"format": "uri",
					"description": "AADM MCP endpoint URL"
				},
				"version": {
					"type": "string",
					"description": "Minimum AADM version (e.g., '>=1.0.0')"
				},
				"auth": {
					"type": "object",
					"required": ["method"],
					"additionalProperties": false,
					"properties": {
						"method": { "$ref": "#/definitions/auth_method" },
						"header": {
							"type": "string",
							"description": "Auth header template (e.g., 'Authorization: Bearer ${AADM_TOKEN}')"
						},
						"oauth_provider": {
							"type": "string",
							"format": "uri",
							"description": "OAuth authorization server URL"
						}
					}
				},
				"timeout_ms": {
					"type": "integer",
					"minimum": 1000,
					"maximum": 30000,
					"default": 5000
				}
			}
		},
		"repo_governance": {
			"type": "object",
			"required": ["udali_ownership"],
			"additionalProperties": false,
			"properties": {
				"udali_ownership": {
					"type": "object",
					"required": ["patterns"],
					"additionalProperties": false,
					"properties": {
						"description": { "type": "string" },
						"patterns": {
							"type": "object",
							"description": "Glob patterns mapped to UDALI layers",
							"additionalProperties": {
								"type": "array",
								"items": { "$ref": "#/definitions/udali_layer" },
								"minItems": 1
							}
						}
					}
				},
				"team_ownership": {
					"type": "object",
					"required": ["roles"],
					"additionalProperties": false,
					"properties": {
						"description": { "type": "string" },
						"roles": {
							"type": "object",
							"description": "Layer range to team mapping",
							"additionalProperties": {
								"type": "object",
								"required": ["team", "approval_required"],
								"additionalProperties": false,
								"properties": {
									"team": { "type": "string" },
									"approval_required": { "type": "boolean" },
									"github_team": { "type": "string" },
									"slack_channel": { "type": "string" }
								}
							}
						}
					}
				},
				"required_auth_controls": {
					"type": "object",
					"required": ["rules"],
					"additionalProperties": false,
					"properties": {
						"description": { "type": "string" },
						"rules": {
							"type": "array",
							"items": {
								"type": "object",
								"required": [
									"auth_id",
									"applies_to_layers",
									"severity",
									"gate"
								],
								"additionalProperties": false,
								"properties": {
									"auth_id": { "$ref": "#/definitions/auth_id" },
									"applies_to_layers": {
										"type": "array",
										"items": { "$ref": "#/definitions/udali_layer" },
										"minItems": 1
									},
									"applies_to_files": {
										"type": "array",
										"items": { "type": "string" }
									},
									"severity": { "$ref": "#/definitions/severity" },
									"gate": { "$ref": "#/definitions/gate_type" }
								}
							}
						}
					}
				},
				"seam_ownership": {
					"type": "object",
					"required": ["crossings"],
					"additionalProperties": false,
					"properties": {
						"description": { "type": "string" },
						"crossings": {
							"type": "array",
							"items": {
								"type": "object",
								"required": [
									"seam_id",
									"description",
									"owned_by",
									"must_trace"
								],
								"additionalProperties": false,
								"properties": {
									"seam_id": { "$ref": "#/definitions/seam_id" },
									"description": { "type": "string" },
									"owned_by": { "type": "string" },
									"must_trace": { "type": "boolean" }
								}
							}
						}
					}
				},
				"enabled_workflows": {
					"type": "object",
					"required": ["lanes"],
					"additionalProperties": false,
					"properties": {
						"description": { "type": "string" },
						"lanes": {
							"type": "array",
							"items": { "$ref": "#/definitions/lane" },
							"minItems": 1
						},
						"delivery_required": { "type": "boolean", "default": true },
						"defect_required": { "type": "boolean", "default": true },
						"assurance_required": { "type": "boolean", "default": false },
						"assurance_depth": { "$ref": "#/definitions/assurance_depth" }
					}
				}
			}
		},
		"gate_config": {
			"type": "object",
			"required": ["enabled", "tool", "checks", "block_on_failure"],
			"additionalProperties": false,
			"properties": {
				"enabled": { "type": "boolean" },
				"tool": {
					"type": "string",
					"description": "Tool running this gate (husky, pre-commit, github-action, etc.)"
				},
				"checks": {
					"type": "array",
					"items": { "type": "string" }
				},
				"block_on_failure": { "type": "boolean" },
				"timeout_minutes": { "type": "integer", "minimum": 1 },
				"show_inline_diagnostics": { "type": "boolean" }
			}
		},
		"enforcement": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"description": { "type": "string" },
				"gates": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"pre_commit": { "$ref": "#/definitions/gate_config" },
						"pre_merge": { "$ref": "#/definitions/gate_config" },
						"on_save": { "$ref": "#/definitions/gate_config" },
						"ci": { "$ref": "#/definitions/gate_config" },
						"release": { "$ref": "#/definitions/gate_config" }
					}
				}
			}
		},
		"attestation": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"description": { "type": "string" },
				"artifact_dir": { "type": "string", "default": ".aadm/attestations" },
				"format": {
					"type": "string",
					"enum": ["json", "jsonl", "yaml"],
					"default": "json"
				},
				"retention_days": { "type": "integer", "minimum": 1, "default": 365 },
				"required_fields": {
					"type": "array",
					"items": { "type": "string" }
				},
				"on_release": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"auto_attest": { "type": "boolean", "default": true },
						"depth": { "$ref": "#/definitions/assurance_depth" },
						"create_artifact": { "type": "boolean", "default": true },
						"tag_commit": { "type": "boolean", "default": true }
					}
				}
			}
		},
		"tool_routing": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"description": { "type": "string" },
				"user_intent_to_tools": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["primary", "sequence"],
						"additionalProperties": false,
						"properties": {
							"primary": { "type": "string" },
							"sequence": {
								"type": "array",
								"items": { "type": "string" }
							},
							"note": { "type": "string" }
						}
					}
				},
				"lane_tool_availability": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"primary_tools": {
								"type": "array",
								"items": { "type": "string" }
							},
							"always_available": {
								"type": "array",
								"items": { "type": "string" }
							},
							"not_available": {
								"type": "array",
								"items": { "type": "string" }
							}
						}
					}
				},
				"phase_guidance": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"recommended_tools": {
								"type": "array",
								"items": { "type": "string" }
							},
							"gate_questions": {
								"type": "array",
								"items": { "type": "string" }
							}
						}
					}
				},
				"contextual_routing": {
					"type": "object",
					"additionalProperties": true
				}
			}
		},
		"tool_specific": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"description": { "type": "string" },
				"claude_code": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"enabled": { "type": "boolean", "default": true },
						"hooks_dir": { "type": "string" },
						"session_start_action": {
							"type": "string",
							"enum": [
								"orient_on_lane_with_tool_routing",
								"show_governance_checklist",
								"none"
							]
						},
						"stop_hook_action": {
							"type": "string",
							"enum": ["report_governance_gaps", "none"]
						},
						"evidence_gates": { "type": "boolean", "default": true },
						"skill_context": {
							"type": "string",
							"enum": [
								"include_aadm_recommendations_and_tool_routing",
								"minimal"
							]
						},
						"tool_selection_enabled": { "type": "boolean", "default": true }
					}
				},
				"cursor": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"enabled": { "type": "boolean", "default": true },
						"composer_config": { "type": "string" },
						"auto_route_issues": { "type": "boolean" },
						"enforce_evidence_gates": { "type": "boolean" },
						"tool_selection_enabled": { "type": "boolean", "default": true }
					}
				},
				"github_actions": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"enabled": { "type": "boolean", "default": true },
						"workflow_dir": { "type": "string" },
						"pre_merge_check": { "type": "string" },
						"post_merge_attestation": { "type": "boolean" },
						"use_tool_routing": { "type": "boolean", "default": true }
					}
				},
				"custom_agents": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"enabled": { "type": "boolean", "default": false },
						"discovery_endpoint": { "type": "string" },
						"tool_selection_enabled": { "type": "boolean", "default": true }
					}
				}
			}
		},
		"discovery": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"description": { "type": "string" },
				"readme_link": { "type": "string" },
				"validate_schema": { "type": "boolean", "default": true },
				"validate_auth_ids": { "type": "boolean", "default": true },
				"validate_seam_ids": { "type": "boolean", "default": true },
				"validate_udali_layers": { "type": "boolean", "default": true },
				"auto_refresh": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"enabled": { "type": "boolean", "default": true },
						"interval_hours": { "type": "integer", "minimum": 1 },
						"on_branch_change": { "type": "boolean" }
					}
				}
			}
		}
	}
}
