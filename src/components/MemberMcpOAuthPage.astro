---
import { maskMcpOAuthClientId } from '../lib/site-urls';

interface Props {
	clientId: string;
	mcpRpcUrl: string;
}

const { clientId, mcpRpcUrl } = Astro.props;
const masked = maskMcpOAuthClientId(clientId);
---

<div class="max-w-xl">
	<h2 class="font-display text-lg font-bold text-slate-900">MCP OAuth</h2>
	<p class="mt-2 text-sm text-slate-600">
		Using OAuth for Claude Code or claude.ai Connectors? Paste this <strong>client ID</strong> when asked.
		Leave Client Secret empty. For Cursor or curl, use an <code class="font-mono text-xs">ak_…</code> API key from the{' '}
		<strong>API keys</strong> tab instead.
	</p>

	{
		clientId ? (
			<div class="mt-4 flex flex-wrap items-center gap-3">
				<code
					class="min-w-0 flex-1 break-all rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-sm text-slate-800"
					title="Full Client ID is copied when you use Copy"
				>
					{masked}
				</code>
				<button
					type="button"
					class="shrink-0 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500"
					data-copy-oauth-id={clientId}
				>
					Copy client ID
				</button>
			</div>
		) : (
			<div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-4">
				<p class="text-sm text-amber-900">
					OAuth Client ID is not configured on this deploy. Set <code class="font-mono text-xs">CLERK_OAUTH_CLIENT_ID</code>{' '}
					on Railway (same Clerk OAuth app as the MCP server).
				</p>
			</div>
		)
	}

	<p class="mt-4 text-xs text-slate-500">
		MCP server URL: <code class="font-mono text-xs text-violet-700">{mcpRpcUrl}</code>
	</p>
</div>

<script>
	document.querySelectorAll('[data-copy-oauth-id]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const id = btn.getAttribute('data-copy-oauth-id');
			if (!id) return;
			void navigator.clipboard.writeText(id).then(() => {
				const label = btn.textContent;
				btn.textContent = 'Copied';
				window.setTimeout(() => {
					btn.textContent = label;
				}, 2000);
			});
		});
	});
</script>
