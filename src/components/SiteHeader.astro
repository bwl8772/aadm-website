---
import { Show, SignOutButton } from "@clerk/astro/components";
import { getAccountPortalUrls } from "../lib/account-portal-urls";
import { CLERK_ACCOUNTS_SIGN_IN } from "../lib/clerk-portal-urls";

type ActiveNav =
	| "home"
	| "about"
	| "mcp"
	| "why"
	| "tools"
	| "ides"
	| "enterprise"
	| "standard"
	| "stories"
	| null;

interface Props {
	/** Public MCP marketing page (production: `https://aadm.io/mcp`). */
	urlMcpMarketing: string;
	/** When set, highlights the matching nav control. */
	activeNav?: ActiveNav;
	/** Override href for the MCP nav chip (e.g. `/mcp#mcp-hero-heading` on the MCP sales page). */
	mcpNavHref?: string;
}

const {
	activeNav = null,
	mcpNavHref: mcpNavHrefProp,
	urlMcpMarketing,
} = Astro.props;

const mcpNavHref = mcpNavHrefProp ?? urlMcpMarketing;

const ringActive = (color: string) =>
	`ring-1 ring-${color}/60 ring-offset-2 ring-offset-surface-deep`;

const standardChip = activeNav === "standard" ? ringActive("emerald-300") : "";
const aboutChip = activeNav === "about" ? ringActive("emerald-300") : "";
const whyChip = activeNav === "why" ? ringActive("amber-300") : "";
const mcpChip = activeNav === "mcp" ? ringActive("emerald-300") : "";
const toolsChip = activeNav === "tools" ? ringActive("emerald-300") : "";
const idesChip = activeNav === "ides" ? ringActive("emerald-300") : "";
const enterpriseChip =
	activeNav === "enterprise" ? ringActive("amber-300") : "";
const storiesChip = activeNav === "stories" ? ringActive("emerald-300") : "";

const ghostChipClasses =
	"shrink-0 whitespace-nowrap rounded-none border border-white/15 bg-transparent px-2.5 py-1.5 text-xs font-semibold text-white transition hover:border-white/30 hover:bg-white/[0.04] sm:px-3 sm:py-2 sm:text-sm md:px-4";

const secondaryGhostChipClasses =
	"shrink-0 whitespace-nowrap rounded-none border border-white/10 bg-transparent px-2.5 py-1.5 text-xs font-medium text-slate-300 transition hover:border-white/25 hover:bg-white/[0.04] hover:text-white sm:px-3 sm:py-2 sm:text-sm md:px-4";

const baseChipClasses =
	"shrink-0 whitespace-nowrap rounded-none border border-white/15 px-2.5 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/30 hover:bg-white/[0.04] hover:text-white sm:px-3 sm:py-2 sm:text-sm md:px-4";
const joinChipClasses =
	"shrink-0 whitespace-nowrap rounded-none border border-emerald-300/30 bg-emerald-950/30 px-2.5 py-1.5 text-xs font-semibold text-emerald-100 transition hover:border-emerald-300/60 hover:bg-emerald-900/40 sm:px-3 sm:py-2 sm:text-sm md:px-4";

const { signInUrl, signUpUrl, memberAreaUrl } = getAccountPortalUrls(
	import.meta.env,
);

type NavItem = {
	key: Exclude<ActiveNav, "home" | null>;
	href: string;
	label: string;
	ariaLabel: string;
	chip: string;
	className: string;
};

const navItems: NavItem[] = [
	{
		key: "about",
		href: "/about",
		label: "About",
		ariaLabel: "About — agentic engineering, the discipline behind AADM",
		chip: aboutChip,
		className:
			"border border-white/10 bg-transparent text-slate-300 hover:border-white/25 hover:bg-white/[0.04] hover:text-white",
	},
	{
		key: "why",
		href: "/why-aadm",
		label: "Why AADM",
		ariaLabel: "Why AADM — governance vs raw agent loops",
		chip: whyChip,
		className:
			"border border-amber-300/30 bg-transparent text-amber-100 hover:border-amber-300/60 hover:bg-amber-500/[0.06]",
	},
	{
		key: "standard",
		href: "/standard",
		label: "Open standard",
		ariaLabel: "Open AADM standard — read and adopt",
		chip: standardChip,
		className:
			"border border-white/15 bg-transparent text-white hover:border-white/30 hover:bg-white/[0.04]",
	},
	{
		key: "mcp",
		href: mcpNavHref,
		label: "Hosted MCP",
		ariaLabel: "MCP marketing — overview and access (aadm.io/mcp)",
		chip: mcpChip,
		className:
			"border border-transparent bg-white text-slate-950 shadow-sm hover:bg-emerald-200",
	},
	{
		key: "ides",
		href: "/ides",
		label: "IDEs",
		ariaLabel: "IDE clients that connect to AADM MCP",
		chip: idesChip,
		className:
			"border border-white/10 bg-transparent text-slate-300 hover:border-white/25 hover:bg-white/[0.04] hover:text-white",
	},
	{
		key: "tools",
		href: "/tools",
		label: "Tools",
		ariaLabel: "AADM MCP typed tools catalog",
		chip: toolsChip,
		className:
			"border border-white/10 bg-transparent text-slate-300 hover:border-white/25 hover:bg-white/[0.04] hover:text-white",
	},
	{
		key: "stories",
		href: "/case-studies",
		label: "Stories",
		ariaLabel: "AADM stories — patterns from the field",
		chip: storiesChip,
		className:
			"border border-white/10 bg-transparent text-slate-300 hover:border-white/25 hover:bg-white/[0.04] hover:text-white",
	},
	{
		key: "enterprise",
		href: "/enterprise",
		label: "Enterprise",
		ariaLabel: "AADM for the enterprise",
		chip: enterpriseChip,
		className:
			"border border-white/10 bg-transparent text-slate-300 hover:border-white/25 hover:bg-white/[0.04] hover:text-white",
	},
];

const desktopChipClass = (item: NavItem) =>
	item.key === "mcp"
		? "shrink-0 whitespace-nowrap rounded-none px-2.5 py-1.5 text-xs font-semibold transition sm:px-3 sm:py-2 sm:text-sm md:px-4"
		: item.key === "why"
			? "shrink-0 whitespace-nowrap rounded-none px-2.5 py-1.5 text-xs font-semibold transition sm:px-3 sm:py-2 sm:text-sm md:px-4"
			: item.key === "standard"
				? ghostChipClasses
				: secondaryGhostChipClasses;

const mobileLinkClass =
	"block min-h-[3rem] border-b border-white/[0.06] px-5 py-4 font-display text-base font-semibold tracking-tight text-white transition hover:bg-white/[0.04] focus:outline-none focus-visible:bg-white/[0.06] focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-inset";
---

<header
	class="site-header sticky top-0 z-40 border-b border-white/[0.08] bg-surface-deep/95 backdrop-blur-md pt-[env(safe-area-inset-top,0px)]"
	data-site-header
>
	<div class="mx-auto flex min-h-14 max-w-7xl items-center gap-3 px-3 py-2 sm:h-16 sm:gap-4 sm:px-6 sm:py-0 lg:px-8">
		<a
			href="/"
			aria-label="AADM — home"
			aria-current={activeNav === "home" ? "page" : undefined}
			class="relative z-10 shrink-0 rounded font-display text-base font-bold tracking-tight text-white transition hover:text-emerald-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 sm:text-lg"
		>
			AADM
		</a>

		<!--
		  Full chip row only from xl (1280px). Below that, hamburger — md/lg
		  used to show every chip and they collided with the logo.
		-->
		<nav
			class="hidden min-w-0 flex-1 flex-nowrap items-center justify-end gap-2 xl:flex xl:gap-2.5"
			aria-label="Primary"
		>
			{
				navItems.map((item) => (
					<a
						href={item.href}
						aria-label={item.ariaLabel}
						aria-current={activeNav === item.key ? "page" : undefined}
						class:list={[desktopChipClass(item), item.className, item.chip]}
					>
						{item.label}
					</a>
				))
			}
			<Show when="signed-out">
				<a
					href={signInUrl}
					class:list={[baseChipClasses, "inline-flex items-center justify-center"]}
				>
					Sign in
				</a>
				<a
					href={signUpUrl}
					class:list={[joinChipClasses, "inline-flex items-center justify-center"]}
				>
					Create account
				</a>
			</Show>
			<Show when="signed-in">
				<a
					href={memberAreaUrl}
					class:list={[
						baseChipClasses,
						"inline-flex items-center justify-center border-emerald-300/30 bg-emerald-950/20 hover:bg-emerald-900/30",
					]}
					title="Member area — API keys, profile, MCP OAuth"
				>
					Member
				</a>
			</Show>
		</nav>

		<!-- Compact: MCP chip + hamburger until xl -->
		<div class="relative z-50 ml-auto flex items-center gap-2 xl:hidden">
			<a
				href={mcpNavHref}
				aria-label="Hosted MCP — overview and access"
				aria-current={activeNav === "mcp" ? "page" : undefined}
				class:list={[
					"inline-flex min-h-11 shrink-0 items-center rounded-none bg-white px-3 py-2 text-xs font-semibold text-slate-950 shadow-sm transition hover:bg-emerald-200",
					mcpChip,
				]}
			>
				MCP
			</a>
			<button
				type="button"
				class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-none border border-white/15 bg-surface-deep text-white transition hover:border-white/30 hover:bg-white/[0.04] focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300"
				aria-label="Open navigation menu"
				aria-expanded="false"
				aria-controls="site-mobile-menu"
				data-menu-toggle
			>
				<svg
					width="20"
					height="20"
					viewBox="0 0 20 20"
					fill="none"
					aria-hidden="true"
					data-menu-icon-open
				>
					<path
						d="M3 5h14M3 10h14M3 15h14"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="square"></path>
				</svg>
				<svg
					width="20"
					height="20"
					viewBox="0 0 20 20"
					fill="none"
					aria-hidden="true"
					class="hidden"
					data-menu-icon-close
				>
					<path
						d="M5 5l10 10M15 5L5 15"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="square"></path>
				</svg>
			</button>
		</div>
	</div>
</header>

<!-- Mobile menu: sibling of header (ported to body on init — avoids sticky/fixed stacking traps) -->
<div
	id="site-mobile-menu"
	class="site-mobile-menu fixed inset-0 z-[120] hidden touch-none xl:hidden"
	aria-hidden="true"
	data-mobile-menu
	inert
>
	<div
		class="absolute inset-0 bg-black/70 backdrop-blur-sm"
		data-menu-backdrop
		aria-hidden="true"
	></div>
	<div
		class="site-mobile-menu-panel absolute inset-y-0 right-0 flex w-[min(100%,20rem)] flex-col border-l border-white/[0.08] bg-surface-deep shadow-2xl pb-[env(safe-area-inset-bottom,0px)]"
		role="dialog"
		aria-modal="true"
		aria-label="Site navigation"
	>
		<div
			class="flex items-center justify-between border-b border-white/[0.08] px-5 pb-4 pt-[max(1rem,env(safe-area-inset-top,0px))]"
		>
			<p class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">
				Navigation
			</p>
			<button
				type="button"
				class="inline-flex h-11 w-11 items-center justify-center rounded-none border border-white/15 text-white transition hover:border-white/30 hover:bg-white/[0.04] focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300"
				aria-label="Close navigation menu"
				data-menu-close
			>
				<svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path
						d="M5 5l10 10M15 5L5 15"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="square"></path>
				</svg>
			</button>
		</div>

		<nav class="flex-1 overflow-y-auto overscroll-contain" aria-label="Mobile primary">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						aria-label={item.ariaLabel}
						aria-current={activeNav === item.key ? "page" : undefined}
						class:list={[
							mobileLinkClass,
							activeNav === item.key ? "bg-white/[0.04] text-emerald-200" : "",
						]}
						data-mobile-nav-link
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="border-t border-white/[0.08] p-5">
			{/*
			  Auth actions pinned under the drawer (best practice):
			  signed-out → Sign in + Create account; signed-in → Member + Log out.
			*/}
			<Show when="signed-out">
				<div class="flex flex-col gap-2">
					<a
						href={signInUrl}
						class="block min-h-11 rounded-none border border-white/15 px-4 py-3 text-center text-sm font-semibold leading-none text-white transition hover:border-white/30 hover:bg-white/[0.04]"
						data-mobile-nav-link
					>
						Sign in
					</a>
					<a
						href={signUpUrl}
						class="block min-h-11 rounded-none border border-emerald-300/30 bg-emerald-950/30 px-4 py-3 text-center text-sm font-semibold leading-none text-emerald-100 transition hover:border-emerald-300/60 hover:bg-emerald-900/40"
						data-mobile-nav-link
					>
						Create account
					</a>
				</div>
			</Show>
			<Show when="signed-in">
				<div class="flex flex-col gap-2">
					<a
						href={memberAreaUrl}
						class="block min-h-11 rounded-none border border-emerald-300/30 bg-emerald-950/20 px-4 py-3 text-center text-sm font-semibold leading-none text-emerald-100 transition hover:bg-emerald-900/30"
						title="Member area — API keys, profile, MCP OAuth"
						data-mobile-nav-link
					>
						Member area
					</a>
					<SignOutButton redirectUrl={CLERK_ACCOUNTS_SIGN_IN} asChild>
						<button
							type="button"
							class="block min-h-11 w-full rounded-none border border-white/15 px-4 py-3 text-center text-sm font-semibold leading-none text-slate-300 transition hover:border-white/30 hover:bg-white/[0.04] hover:text-white"
							data-mobile-nav-link
						>
							Log out
						</button>
					</SignOutButton>
				</div>
			</Show>
		</div>
	</div>
</div>

<script is:inline>
	(function initSiteMobileNav() {
		const header = document.querySelector("[data-site-header]");
		const menu = document.getElementById("site-mobile-menu");
		if (!header || !menu) return;

		// Port overlay to <body> so position:fixed is never clipped by sticky/isolate ancestors.
		if (menu.parentElement !== document.body) {
			document.body.appendChild(menu);
		}

		const toggle = header.querySelector("[data-menu-toggle]");
		const closeBtn = menu.querySelector("[data-menu-close]");
		const backdrop = menu.querySelector("[data-menu-backdrop]");
		const panel = menu.querySelector(".site-mobile-menu-panel");
		const iconOpen = header.querySelector("[data-menu-icon-open]");
		const iconClose = header.querySelector("[data-menu-icon-close]");

		if (!toggle) return;

		let isOpen = false;
		let scrollY = 0;

		function lockScroll() {
			scrollY = window.scrollY;
			document.body.classList.add("site-mobile-nav-open");
			document.body.style.position = "fixed";
			document.body.style.top = "-" + scrollY + "px";
			document.body.style.left = "0";
			document.body.style.right = "0";
			document.body.style.width = "100%";
		}

		function unlockScroll() {
			document.body.classList.remove("site-mobile-nav-open");
			document.body.style.position = "";
			document.body.style.top = "";
			document.body.style.left = "";
			document.body.style.right = "";
			document.body.style.width = "";
			window.scrollTo(0, scrollY);
		}

		function setOpen(open) {
			isOpen = open;
			menu.classList.toggle("hidden", !open);
			menu.classList.toggle("touch-none", open);
			menu.setAttribute("aria-hidden", open ? "false" : "true");
			if (open) {
				menu.removeAttribute("inert");
			} else {
				menu.setAttribute("inert", "");
			}
			toggle.setAttribute("aria-expanded", open ? "true" : "false");
			if (open) {
				lockScroll();
				closeBtn?.focus();
			} else {
				unlockScroll();
				toggle.focus();
			}
			iconOpen?.classList.toggle("hidden", open);
			iconClose?.classList.toggle("hidden", !open);
		}

		toggle.addEventListener("click", function () {
			setOpen(!isOpen);
		});

		closeBtn?.addEventListener("click", function () {
			setOpen(false);
		});

		backdrop?.addEventListener("click", function () {
			setOpen(false);
		});

		panel?.addEventListener("click", function (event) {
			event.stopPropagation();
		});

		document.addEventListener("keydown", function (event) {
			if (event.key === "Escape" && isOpen) {
				setOpen(false);
			}
		});

		menu.addEventListener("click", function (event) {
			const target = event.target;
			if (!(target instanceof Element)) return;
			if (target.closest("[data-mobile-nav-link]")) {
				setOpen(false);
			}
		});

		window.matchMedia("(min-width: 1280px)").addEventListener("change", function (event) {
			if (event.matches && isOpen) {
				setOpen(false);
			}
		});
	})();
</script>

<style is:global>
	body.site-mobile-nav-open {
		overflow: hidden;
		overscroll-behavior: none;
	}

	.site-mobile-menu:not(.hidden) .site-mobile-menu-panel {
		animation: site-mobile-panel-in 0.22s ease-out both;
	}

	@keyframes site-mobile-panel-in {
		from {
			transform: translateX(100%);
		}
		to {
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-mobile-menu:not(.hidden) .site-mobile-menu-panel {
			animation: none;
		}
	}
</style>
