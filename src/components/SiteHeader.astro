---
import { Show } from '@clerk/astro/components';
import { getAccountPortalUrls } from '../lib/account-portal-urls';

type ActiveNav = 'home' | 'mcp' | null;

interface Props {
	urlStandard: string;
	/** Public MCP marketing page (production: `https://aadm.io/mcp`). */
	urlMcpMarketing: string;
	/** When set, highlights the matching nav control. */
	activeNav?: ActiveNav;
	/** Override href for the MCP nav chip (e.g. `/mcp#mcp-hero-heading` on the MCP sales page). */
	mcpNavHref?: string;
}

const { activeNav = null, mcpNavHref: mcpNavHrefProp, urlStandard, urlMcpMarketing } = Astro.props;

const mcpNavHref = mcpNavHrefProp ?? urlMcpMarketing;

const standardChip =
	activeNav === 'home'
		? 'ring-2 ring-accent-violet/60 ring-offset-2 ring-offset-surface-deep'
		: '';
const mcpChip =
	activeNav === 'mcp'
		? 'ring-2 ring-white/40 ring-offset-2 ring-offset-surface-deep'
		: '';

const baseChipClasses =
	'shrink-0 whitespace-nowrap rounded-lg border border-border-subtle px-2.5 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-slate-500/50 hover:bg-surface-card/60 hover:text-white sm:px-3 sm:py-2 sm:text-sm md:px-4';
const joinChipClasses =
	'shrink-0 whitespace-nowrap rounded-lg border border-violet-500/40 bg-violet-950/40 px-2.5 py-1.5 text-xs font-semibold text-white transition hover:border-violet-400/60 hover:bg-violet-900/50 sm:px-3 sm:py-2 sm:text-sm md:px-4';

const { signInUrl, signUpUrl, accountUserUrl, accountMcpOAuthUrl } = getAccountPortalUrls(import.meta.env);

---

<header class="sticky top-0 z-40 border-b border-border-subtle bg-surface-deep/80 backdrop-blur-md">
	<div class="mx-auto flex min-h-14 max-w-6xl items-center gap-2 px-3 py-2 sm:h-16 sm:gap-4 sm:px-6 sm:py-0">
		<a
			href="/"
			aria-label="AADM — home"
			aria-current={activeNav === 'home' ? 'page' : undefined}
			class="shrink-0 rounded font-display text-base font-bold tracking-tight text-white transition hover:text-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 sm:text-lg"
		>
			AADM
		</a>
		<nav
			class="scrollbar-none flex min-w-0 flex-1 flex-nowrap items-center justify-end gap-1.5 overflow-x-auto pb-0.5 sm:gap-2 sm:overflow-visible sm:pb-0 md:gap-3 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
			aria-label="Primary"
		>
			<a
				href={urlStandard}
				aria-label="Open AADM standard — read and adopt"
				class:list={[
					'shrink-0 whitespace-nowrap rounded-lg border border-border-subtle bg-surface-card/80 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:border-slate-500/40 hover:bg-surface-mid sm:px-3 sm:py-2 sm:text-sm md:px-4',
					standardChip,
				]}
			>
				<span class="md:hidden">Standard</span>
				<span class="hidden md:inline">Open standard</span>
			</a>
			<a
				href={mcpNavHref}
				aria-label="MCP marketing — overview and access (aadm.io/mcp)"
				aria-current={activeNav === 'mcp' ? 'page' : undefined}
				class:list={[
					'shrink-0 whitespace-nowrap rounded-lg bg-gradient-to-r from-violet-600 to-blue-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-lg shadow-violet-900/30 transition hover:brightness-110 sm:px-3 sm:py-2 sm:text-sm md:px-4',
					mcpChip,
				]}
			>
				<span class="md:hidden">MCP</span>
				<span class="hidden md:inline">Hosted MCP</span>
			</a>
			<Show when="signed-out">
				<a href={signInUrl} class:list={[baseChipClasses, 'inline-flex items-center justify-center']}>Sign in to AADM</a>
				<a href={signUpUrl} class:list={[joinChipClasses, 'inline-flex items-center justify-center']}>
					<span class="sm:hidden">Join</span>
					<span class="hidden sm:inline">Create account</span>
				</a>
			</Show>
			<Show when="signed-in">
				<a
					href={accountMcpOAuthUrl}
					class:list={[
						baseChipClasses,
						'inline-flex items-center justify-center border-violet-500/40 bg-violet-950/30 hover:bg-violet-900/40',
					]}
					title="Shared OAuth client_id — same for all subscribers"
				>
					<span class="sm:hidden">OAuth ID</span>
					<span class="hidden sm:inline">OAuth Client ID</span>
				</a>
				<a
					href={accountUserUrl}
					class:list={[baseChipClasses, 'inline-flex items-center justify-center']}
					title="Clerk Account Portal — profile and API keys (ak_…)"
				>
					<span class="sm:hidden">API keys</span>
					<span class="hidden sm:inline">API keys</span>
				</a>
			</Show>
		</nav>
	</div>
</header>
