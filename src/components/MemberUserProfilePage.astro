---
/**
 * Member credentials — Astro owns tabs; Clerk is content-only.
 *
 * Hard bans (blank-pane regressions):
 * - No UserProfile.Page custom content
 * - No UserProfile.Link for OAuth
 * - No innerHTML / portal / MutationObserver into .cl-pageScrollBox
 *
 * OAuth is pure Astro SSR. API keys use Clerk <APIKeys />. Profile/Security use
 * UserProfile with sidenav hidden via appearance.
 */
import { APIKeys, UserProfile } from "@clerk/astro/components";
import {
	MEMBER_ACCOUNT_SEGMENT,
	MEMBER_API_KEYS_SEGMENT,
	MEMBER_AREA_PATH,
	MEMBER_MCP_OAUTH_SEGMENT,
	MEMBER_SECURITY_SEGMENT,
	memberAreaPathFromEnv,
} from "../lib/member-area";
import { MEMBER_CLERK_CONTENT_ONLY_APPEARANCE } from "../lib/member-clerk-appearance";
import { primaryOAuthClientIdFromEnv } from "../lib/member-oauth-client-ids";
import { getSiteUrlConfig, maskMcpOAuthClientId } from "../lib/site-urls";
import MemberConnectionHelp from "./MemberConnectionHelp.astro";
import MemberNavTabs from "./MemberNavTabs.astro";

const memberPath = memberAreaPathFromEnv(import.meta.env);
const oauthClientId = primaryOAuthClientIdFromEnv(import.meta.env);
const { urlMcpRpcUrl } = getSiteUrlConfig(import.meta.env);
const maskedClientId = maskMcpOAuthClientId(oauthClientId);

const pathname = Astro.url.pathname.replace(/\/+$/, "") || MEMBER_AREA_PATH;
const onOauth = pathname.endsWith(`/${MEMBER_MCP_OAUTH_SEGMENT}`);
const onAccount = pathname.endsWith(`/${MEMBER_ACCOUNT_SEGMENT}`);
const onSecurity = pathname.endsWith(`/${MEMBER_SECURITY_SEGMENT}`);
const onApiKeys =
	!onOauth &&
	!onAccount &&
	!onSecurity &&
	(pathname === memberPath ||
		pathname.endsWith(`/${MEMBER_API_KEYS_SEGMENT}`) ||
		pathname.endsWith("/api-keys"));

const cursorBearerJson = `{
  "mcpServers": {
    "aadm": {
      "type": "http",
      "url": "${urlMcpRpcUrl}",
      "headers": {
        "Authorization": "Bearer ak_…"
      }
    }
  }
}`;

const curlBearerSnippet = `curl -sS -X POST ${urlMcpRpcUrl} \\
  -H "Authorization: Bearer ak_…" \\
  -H "Content-Type: application/json" \\
  -H "Accept: application/json, text/event-stream" \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}'`;

const copyOnClick = `const id=this.getAttribute('data-copy-text');if(!id)return;navigator.clipboard.writeText(id).then(()=>{const t=this.textContent;this.textContent='Copied';setTimeout(()=>{this.textContent=t},2000)}).catch(()=>{})`;

const clerkAppearance = MEMBER_CLERK_CONTENT_ONLY_APPEARANCE;
---

<div
	class="member-area-card min-w-0 max-w-full overflow-hidden rounded-2xl border border-border-subtle bg-white shadow-sm"
	data-member-area-root
	data-member-panel={onOauth
		? MEMBER_MCP_OAUTH_SEGMENT
		: onAccount
			? MEMBER_ACCOUNT_SEGMENT
			: onSecurity
				? MEMBER_SECURITY_SEGMENT
				: MEMBER_API_KEYS_SEGMENT}
>
	<MemberNavTabs />

	<div class="member-area-panel min-w-0 p-4 sm:p-6">
		{
			onApiKeys && (
				<section
					class="member-cred-panel text-slate-900"
					aria-labelledby="api-keys-guide-heading"
					data-cred-panel={MEMBER_API_KEYS_SEGMENT}
				>
					<h2
						id="api-keys-guide-heading"
						class="font-display text-lg font-bold text-slate-900"
					>
						Use your API key as a Bearer token
					</h2>
					<p class="mt-2 text-sm leading-relaxed text-slate-600">
						Best for <strong class="font-semibold text-slate-900">Cursor</strong>,{" "}
						<strong class="font-semibold text-slate-900">Windsurf</strong>,{" "}
						<strong class="font-semibold text-slate-900">Codex</strong>, and{" "}
						<strong class="font-semibold text-slate-900">curl</strong>. Create a personal{" "}
						<code class="rounded bg-slate-100 px-1 font-mono text-violet-800">ak_…</code> key
						below, then paste it as a Bearer token — not an OAuth Client ID.
					</p>
					<ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-slate-600">
						<li>
							Create a key in the Clerk section below. Copy the full{" "}
							<code class="font-mono text-violet-800">ak_…</code> value once (shown only at
							creation).
						</li>
						<li>
							In Cursor, edit <code class="font-mono text-slate-800">~/.cursor/mcp.json</code> (or
							project <code class="font-mono text-slate-800">.cursor/mcp.json</code>) with the JSON
							below — replace <code class="font-mono text-violet-800">ak_…</code> with your key.
						</li>
						<li>Reload MCP in Cursor, then call a tool (for example tools list).</li>
					</ol>

					<div class="mt-5">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-500">
								Cursor · mcp.json
							</p>
							<button
								type="button"
								class="shrink-0 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-800"
								data-copy-text={cursorBearerJson}
								onclick={copyOnClick}
							>
								Copy JSON
							</button>
						</div>
						<pre class="mt-2 max-w-full overflow-x-auto rounded-lg border border-slate-200 bg-slate-50 p-3 font-mono text-xs leading-relaxed text-slate-800"><code>{cursorBearerJson}</code></pre>
					</div>

					<div class="mt-5">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-500">
								Header · curl
							</p>
							<button
								type="button"
								class="shrink-0 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-800"
								data-copy-text={curlBearerSnippet}
								onclick={copyOnClick}
							>
								Copy curl
							</button>
						</div>
						<pre class="mt-2 max-w-full overflow-x-auto rounded-lg border border-slate-200 bg-slate-50 p-3 font-mono text-xs leading-relaxed text-slate-800"><code>{curlBearerSnippet}</code></pre>
					</div>

					<p class="mt-4 text-xs text-slate-500">
						Header form:{" "}
						<code class="font-mono text-violet-800">Authorization: Bearer ak_…</code>. Claude Code /
						claude.ai should use <strong class="font-semibold text-slate-700">Connectors OAuth</strong>{" "}
						instead.
					</p>

					<div
						class="member-clerk-widget mt-6 min-w-0 rounded-xl border border-slate-200 bg-slate-50/80 p-3 sm:p-4"
						data-clerk-widget="api-keys"
					>
						<APIKeys appearance={clerkAppearance} />
					</div>

					<MemberConnectionHelp idPrefix="api-keys" />
				</section>
			)
		}

		{
			onOauth && (
				<section
					class="member-cred-panel member-cred-panel--oauth max-w-xl text-slate-900"
					aria-labelledby="oauth-heading"
					data-cred-panel={MEMBER_MCP_OAUTH_SEGMENT}
				>
					<h2 id="oauth-heading" class="font-display text-lg font-bold text-slate-900">
						Connectors OAuth
					</h2>
					<p class="mt-2 text-sm leading-relaxed text-slate-600">
						For <strong class="font-semibold text-slate-900">Claude Code</strong> and{" "}
						<strong class="font-semibold text-slate-900">claude.ai Connectors</strong> only. Copy the
						Client ID below and paste it when Claude asks for an OAuth Client ID. Leave Client Secret
						blank.
					</p>
					{oauthClientId ? (
						<div class="mt-4 flex flex-wrap items-center gap-3">
							<code
								class="min-w-0 flex-1 break-all rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-sm text-slate-800"
								title="Full Client ID is copied when you use Copy"
							>
								{maskedClientId}
							</code>
							<button
								type="button"
								class="shrink-0 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500"
								data-copy-text={oauthClientId}
								onclick={copyOnClick}
							>
								Copy client ID
							</button>
						</div>
					) : (
						<div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-4">
							<p class="text-sm text-amber-950">
								OAuth Client ID is not available yet. Contact us if this persists.
							</p>
						</div>
					)}
					{urlMcpRpcUrl ? (
						<p class="mt-4 text-xs text-slate-500">
							MCP server URL to paste alongside the Client ID:{" "}
							<code class="break-all font-mono text-xs text-violet-700">{urlMcpRpcUrl}</code>
						</p>
					) : null}
					<p class="mt-4 text-xs text-slate-500">
						Using Cursor or curl? Open{" "}
						<strong class="font-semibold text-slate-700">API keys</strong>, create an{" "}
						<code class="font-mono text-violet-800">ak_…</code> key, and use it as a Bearer token.
					</p>

					<MemberConnectionHelp idPrefix="oauth" />
				</section>
			)
		}

		{
			onAccount && (
				<section
					class="member-clerk-widget min-w-0 text-slate-900"
					aria-labelledby="profile-heading"
					data-cred-panel={MEMBER_ACCOUNT_SEGMENT}
				>
					<h2 id="profile-heading" class="sr-only">
						Profile
					</h2>
					<UserProfile
						path={memberPath || MEMBER_AREA_PATH}
						routing="path"
						appearance={clerkAppearance}
					>
						<UserProfile.Page label="account" />
					</UserProfile>
				</section>
			)
		}

		{
			onSecurity && (
				<section
					class="member-clerk-widget min-w-0 text-slate-900"
					aria-labelledby="security-heading"
					data-cred-panel={MEMBER_SECURITY_SEGMENT}
				>
					<h2 id="security-heading" class="sr-only">
						Security
					</h2>
					<UserProfile
						path={memberPath || MEMBER_AREA_PATH}
						routing="path"
						appearance={clerkAppearance}
					>
						<UserProfile.Page label="security" />
					</UserProfile>
				</section>
			)
		}
	</div>
</div>

<style>
	.member-area-card :global(.cl-rootBox),
	.member-area-card :global(.cl-cardBox) {
		width: 100% !important;
		max-width: 100%;
		min-width: 0;
	}

	.member-area-card :global(.cl-navbar),
	.member-area-card :global(.cl-navbarMobileMenuRow),
	.member-area-card :global(.cl-navbarMobileMenuButton) {
		display: none !important;
	}

	.member-area-card :global(.cl-profileSectionContent svg),
	.member-area-card :global(.cl-emptyStateIcon svg),
	.member-area-card :global([class*="emptyState"] svg) {
		max-width: 4rem;
		max-height: 4rem;
	}
</style>
