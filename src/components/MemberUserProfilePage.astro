---
import { UserProfile } from "@clerk/astro/components";
import {
	MEMBER_API_KEYS_SEGMENT,
	MEMBER_AREA_PATH,
	MEMBER_MCP_OAUTH_SEGMENT,
	memberAreaPathFromEnv,
} from "../lib/member-area";
import { primaryOAuthClientIdFromEnv } from "../lib/member-oauth-client-ids";
import { getSiteUrlConfig, maskMcpOAuthClientId } from "../lib/site-urls";
import MemberConnectionHelp from "./MemberConnectionHelp.astro";

const memberPath = memberAreaPathFromEnv(import.meta.env);
const oauthClientId = primaryOAuthClientIdFromEnv(import.meta.env);
const { urlMcpRpcUrl } = getSiteUrlConfig(import.meta.env);
const maskedClientId = maskMcpOAuthClientId(oauthClientId);

const pathname = Astro.url.pathname.replace(/\/+$/, "") || MEMBER_AREA_PATH;
const onOauth = pathname.endsWith(`/${MEMBER_MCP_OAUTH_SEGMENT}`);
/** Clerk path routing: first tab (apiKeys) is `/member` or `/member/api-keys`. */
const onApiKeys =
	!onOauth &&
	(pathname === memberPath ||
		pathname.endsWith(`/${MEMBER_API_KEYS_SEGMENT}`) ||
		pathname.endsWith("/api-keys"));

const oauthHref = `${memberPath}/${MEMBER_MCP_OAUTH_SEGMENT}`;

const cursorBearerJson = `{
  "mcpServers": {
    "aadm": {
      "type": "http",
      "url": "${urlMcpRpcUrl}",
      "headers": {
        "Authorization": "Bearer ak_…"
      }
    }
  }
}`;

const curlBearerSnippet = `curl -sS -X POST ${urlMcpRpcUrl} \\
  -H "Authorization: Bearer ak_…" \\
  -H "Content-Type: application/json" \\
  -H "Accept: application/json, text/event-stream" \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}'`;

const copyOnClick = `const id=this.getAttribute('data-copy-text');if(!id)return;navigator.clipboard.writeText(id).then(()=>{const t=this.textContent;this.textContent='Copied';setTimeout(()=>{this.textContent=t},2000)}).catch(()=>{})`;
---

<div
	class:list={[
		"clerk-member-profile rounded-2xl border border-border-subtle bg-surface-card/40 p-2 sm:p-4",
		onOauth && "clerk-member-profile--oauth-panel",
	]}
	data-member-cred-root
	data-api-keys-seg={MEMBER_API_KEYS_SEGMENT}
	data-oauth-seg={MEMBER_MCP_OAUTH_SEGMENT}
>
	{/*
	  API keys guide sits above Clerk's native key UI.
	  OAuth panel is portaled into Clerk's .cl-pageScrollBox (right column).
	*/}
	<section
		class="member-cred-panel mb-4 rounded-xl border border-slate-200 bg-white p-5 text-slate-900 sm:p-6"
		aria-labelledby="api-keys-guide-heading"
		data-cred-panel={MEMBER_API_KEYS_SEGMENT}
		hidden={!onApiKeys}
	>
		<h2 id="api-keys-guide-heading" class="font-display text-lg font-bold text-slate-900">
			Use your API key as a Bearer token
		</h2>
		<p class="mt-2 text-sm leading-relaxed text-slate-600">
			Best for <strong class="font-semibold text-slate-900">Cursor</strong>,{" "}
			<strong class="font-semibold text-slate-900">Windsurf</strong>, and{" "}
			<strong class="font-semibold text-slate-900">curl</strong>. Create a personal{" "}
			<code class="rounded bg-slate-100 px-1 font-mono text-violet-800">ak_…</code> key below, then
			paste it as a Bearer token — not an OAuth Client ID.
		</p>
		<ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-slate-600">
			<li>
				Create a key in the Clerk section below. Copy the full{" "}
				<code class="font-mono text-violet-800">ak_…</code> value once (shown only at creation).
			</li>
			<li>
				In Cursor, edit <code class="font-mono text-slate-800">~/.cursor/mcp.json</code> (or project{" "}
				<code class="font-mono text-slate-800">.cursor/mcp.json</code>) with the JSON below — replace{" "}
				<code class="font-mono text-violet-800">ak_…</code> with your key.
			</li>
			<li>Reload MCP in Cursor, then call a tool (for example tools list).</li>
		</ol>

		<div class="mt-5">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-500">
					Cursor · mcp.json
				</p>
				<button
					type="button"
					class="shrink-0 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-800"
					data-copy-text={cursorBearerJson}
					onclick={copyOnClick}
				>
					Copy JSON
				</button>
			</div>
			<pre class="mt-2 overflow-x-auto rounded-lg border border-slate-200 bg-slate-50 p-3 font-mono text-xs leading-relaxed text-slate-800"><code>{cursorBearerJson}</code></pre>
		</div>

		<div class="mt-5">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-500">
					Header · curl
				</p>
				<button
					type="button"
					class="shrink-0 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-800"
					data-copy-text={curlBearerSnippet}
					onclick={copyOnClick}
				>
					Copy curl
				</button>
			</div>
			<pre class="mt-2 overflow-x-auto rounded-lg border border-slate-200 bg-slate-50 p-3 font-mono text-xs leading-relaxed text-slate-800"><code>{curlBearerSnippet}</code></pre>
		</div>

		<p class="mt-4 text-xs text-slate-500">
			Header form: <code class="font-mono text-violet-800">Authorization: Bearer ak_…</code>. Claude Code /
			claude.ai should use <strong class="font-semibold text-slate-700">Connectors OAuth</strong> instead.
		</p>

		<MemberConnectionHelp idPrefix="api-keys" />
	</section>

	{/* Parking spot when OAuth is not the active tab (panel is moved into Clerk's right column when active). */}
	<div data-oauth-home hidden>
		<section
			class="member-cred-panel member-cred-panel--oauth p-5 text-slate-900 sm:p-6"
			aria-labelledby="oauth-heading"
			data-cred-panel={MEMBER_MCP_OAUTH_SEGMENT}
			hidden={!onOauth}
		>
			<h2 id="oauth-heading" class="font-display text-lg font-bold text-slate-900">
				Connectors OAuth
			</h2>
			<p class="mt-2 text-sm leading-relaxed text-slate-600">
				For <strong class="font-semibold text-slate-900">Claude Code</strong> and{" "}
				<strong class="font-semibold text-slate-900">claude.ai Connectors</strong> only. Copy the Client ID
				below and paste it when Claude asks for an OAuth Client ID. Leave Client Secret blank.
			</p>
			{
				oauthClientId ? (
					<div class="mt-4 flex flex-wrap items-center gap-3">
						<code
							class="min-w-0 flex-1 break-all rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-sm text-slate-800"
							title="Full Client ID is copied when you use Copy"
						>
							{maskedClientId}
						</code>
						<button
							type="button"
							class="shrink-0 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500"
							data-copy-text={oauthClientId}
							onclick={copyOnClick}
						>
							Copy client ID
						</button>
					</div>
				) : (
					<div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-4">
						<p class="text-sm text-amber-950">
							OAuth Client ID is not available yet. Contact us if this persists.
						</p>
					</div>
				)
			}
			{
				urlMcpRpcUrl ? (
					<p class="mt-4 text-xs text-slate-500">
						MCP server URL to paste alongside the Client ID:{" "}
						<code class="font-mono text-xs text-violet-700">{urlMcpRpcUrl}</code>
					</p>
				) : null
			}
			<p class="mt-4 text-xs text-slate-500">
				Using Cursor or curl? Open <strong class="font-semibold text-slate-700">API keys</strong>, create an{" "}
				<code class="font-mono text-violet-800">ak_…</code> key, and use it as a Bearer token.
			</p>

			<MemberConnectionHelp idPrefix="oauth" />
		</section>
	</div>

	{/*
	  Four tabs: API keys, Connectors OAuth, Profile, Security.
	  OAuth uses Link (not Page) — Clerk Astro custom Page mounts leave a blank pane.
	*/}
	<UserProfile path={memberPath} routing="path">
		<UserProfile.Page label="apiKeys" />
		<UserProfile.Link label="Connectors OAuth" url={oauthHref}>
			<svg
				slot="label-icon"
				xmlns="http://www.w3.org/2000/svg"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
				<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
			</svg>
		</UserProfile.Link>
		<UserProfile.Page label="account" />
		<UserProfile.Page label="security" />
	</UserProfile>
</div>

<script>
	function syncMemberCredPanels() {
		const root = document.querySelector("[data-member-cred-root]");
		if (!(root instanceof HTMLElement)) return;
		const keysSeg = root.dataset.apiKeysSeg || "api-keys";
		const oauthSeg = root.dataset.oauthSeg || "mcp-oauth";
		const path = location.pathname.replace(/\/+$/, "") || "/";
		const onOauth = path.endsWith(`/${oauthSeg}`);
		const onAccountOrSecurity =
			path.endsWith("/account") || path.endsWith("/security");
		const onKeys =
			!onOauth &&
			!onAccountOrSecurity &&
			(path === "/member" || path.endsWith(`/${keysSeg}`) || path.endsWith("/api-keys"));

		const keysPanel = root.querySelector(`[data-cred-panel="${keysSeg}"]`);
		if (keysPanel instanceof HTMLElement) {
			keysPanel.hidden = !onKeys;
		}

		const oauthPanel = root.querySelector(`[data-cred-panel="${oauthSeg}"]`);
		const oauthHome = root.querySelector("[data-oauth-home]");
		const scrollBox =
			root.querySelector(".cl-pageScrollBox") || root.querySelector(".cl-scrollBox");

		if (oauthPanel instanceof HTMLElement && oauthHome instanceof HTMLElement) {
			if (onOauth && scrollBox instanceof HTMLElement) {
				// Fill Clerk's right column — do not stack above the card.
				if (oauthPanel.parentElement !== scrollBox) {
					scrollBox.replaceChildren(oauthPanel);
				}
				oauthPanel.hidden = false;
				oauthHome.setAttribute("hidden", "");
			} else {
				if (oauthPanel.parentElement !== oauthHome) {
					oauthHome.replaceChildren(oauthPanel);
				}
				oauthPanel.hidden = true;
				oauthHome.setAttribute("hidden", "");
			}
		}

		root.classList.toggle("clerk-member-profile--oauth-panel", onOauth);
	}

	function scheduleSync() {
		queueMicrotask(syncMemberCredPanels);
		requestAnimationFrame(syncMemberCredPanels);
		setTimeout(syncMemberCredPanels, 50);
		setTimeout(syncMemberCredPanels, 250);
	}

	syncMemberCredPanels();
	scheduleSync();
	window.addEventListener("popstate", scheduleSync);
	const wrapHistory = (fn) =>
		function (...args) {
			const ret = fn.apply(this, args);
			scheduleSync();
			return ret;
		};
	history.pushState = wrapHistory(history.pushState.bind(history));
	history.replaceState = wrapHistory(history.replaceState.bind(history));
	document.addEventListener("click", scheduleSync);

	const root = document.querySelector("[data-member-cred-root]");
	if (root) {
		const mo = new MutationObserver(scheduleSync);
		mo.observe(root, { childList: true, subtree: true });
	}
</script>

<style>
	.clerk-member-profile :global(.cl-rootBox) {
		width: 100%;
	}

	.clerk-member-profile :global(.cl-navbarButtonIcon svg),
	.clerk-member-profile :global(.cl-navbarButton svg) {
		width: 1rem;
		height: 1rem;
		max-width: 1rem;
		max-height: 1rem;
		flex-shrink: 0;
	}

	.clerk-member-profile :global(svg[slot="label-icon"]) {
		width: 1rem !important;
		height: 1rem !important;
		max-width: 1rem;
		max-height: 1rem;
	}

	/* OAuth content lives inside Clerk's right scroll column. */
	.clerk-member-profile--oauth-panel :global(.cl-pageScrollBox),
	.clerk-member-profile--oauth-panel :global(.cl-scrollBox) {
		display: block !important;
		background: #fff;
		min-height: 16rem;
	}

	.clerk-member-profile :global(.member-cred-panel--oauth) {
		box-sizing: border-box;
		width: 100%;
		max-width: 40rem;
	}

	.clerk-member-profile :global(.cl-profileSectionContent svg),
	.clerk-member-profile :global(.cl-emptyStateIcon svg),
	.clerk-member-profile :global([class*="emptyState"] svg) {
		max-width: 4rem;
		max-height: 4rem;
	}
</style>
