---
import { UserProfile } from "@clerk/astro/components";
import {
	MEMBER_MCP_OAUTH_SEGMENT,
	memberAreaPathFromEnv,
} from "../lib/member-area";
import { primaryOAuthClientIdFromEnv } from "../lib/member-oauth-client-ids";
import { getSiteUrlConfig } from "../lib/site-urls";
import MemberOAuthClientIdPage from "./MemberOAuthClientIdPage.astro";
import MemberOAuthTabIcon from "./MemberOAuthTabIcon.astro";

const memberPath = memberAreaPathFromEnv(import.meta.env);
/** One shared AADM OAuth app — same Client ID for every member (server-configured). */
const oauthClientId = primaryOAuthClientIdFromEnv(import.meta.env);
const { urlMcpRpcUrl } = getSiteUrlConfig(import.meta.env);
---

<div class="clerk-member-profile rounded-2xl border border-border-subtle bg-surface-card/40 p-2 sm:p-4">
	<UserProfile path={memberPath} routing="path">
		<UserProfile.Page label="apiKeys" />
		<UserProfile.Page label="Connectors OAuth" url={MEMBER_MCP_OAUTH_SEGMENT}>
			<MemberOAuthTabIcon />
			<MemberOAuthClientIdPage
				title="Connectors OAuth"
				lead="AADM uses <strong>one</strong> shared OAuth application for all members. This Client ID is configured on our servers — it is <strong>not</strong> personal or per-user. Paste it for <strong>Claude Code</strong>, <strong>claude.ai Connectors</strong>, and other OAuth MCP clients; leave Client Secret empty. For Cursor or curl, use an <code>ak_…</code> key from <strong>API keys</strong> instead."
				clientId={oauthClientId}
				mcpRpcUrl={urlMcpRpcUrl}
			/>
		</UserProfile.Page>
		<UserProfile.Page label="account" />
		<UserProfile.Page label="security" />
	</UserProfile>
</div>

<style>
	.clerk-member-profile :global(.cl-rootBox) {
		width: 100%;
	}
</style>
