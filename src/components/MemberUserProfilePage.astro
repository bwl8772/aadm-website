---
/**
 * Member credentials — Astro owns tabs; Clerk is content-only.
 *
 * Theme: inherits site surface tokens (`surface-card`, `border-subtle`, slate
 * text on `surface-deep` body) — not a forced light panel. Clerk widgets use
 * matching dark appearance variables.
 *
 * Hard bans (blank-pane regressions):
 * - No UserProfile.Page custom content
 * - No UserProfile.Link for OAuth
 * - No innerHTML / portal / MutationObserver into .cl-pageScrollBox
 */
import { APIKeys, UserProfile } from "@clerk/astro/components";
import {
	MEMBER_ACCOUNT_SEGMENT,
	MEMBER_API_KEYS_SEGMENT,
	MEMBER_AREA_PATH,
	MEMBER_MCP_OAUTH_SEGMENT,
	MEMBER_SECURITY_SEGMENT,
	memberAreaPathFromEnv,
} from "../lib/member-area";
import { MEMBER_CLERK_CONTENT_ONLY_APPEARANCE } from "../lib/member-clerk-appearance";
import { primaryOAuthClientIdFromEnv } from "../lib/member-oauth-client-ids";
import { getSiteUrlConfig, maskMcpOAuthClientId } from "../lib/site-urls";
import MemberConnectionHelp from "./MemberConnectionHelp.astro";
import MemberNavTabs from "./MemberNavTabs.astro";

const memberPath = memberAreaPathFromEnv(import.meta.env);
const oauthClientId = primaryOAuthClientIdFromEnv(import.meta.env);
const { urlMcpRpcUrl } = getSiteUrlConfig(import.meta.env);
const maskedClientId = maskMcpOAuthClientId(oauthClientId);
const mcpUrl = urlMcpRpcUrl || "https://mcp.aadm.io/mcp";
// Default path: URL only. The client identifies itself to Clerk (CIMD) and the
// member signs in on Clerk's consent screen. No client ID to copy.
const cursorUrlJson = `{
  "mcpServers": {
    "aadm": {
      "url": "${mcpUrl}"
    }
  }
}`;
const claudeCodeCommand = `claude mcp add --transport http aadm ${mcpUrl}`;
// Fallback for clients that cannot identify themselves and ask for a client ID.
const cursorOAuthJson = `{
  "mcpServers": {
    "aadm": {
      "url": "${mcpUrl}",
      "auth": {
        "CLIENT_ID": "${oauthClientId || "<your client ID>"}",
        "scopes": ["openid", "profile", "email", "offline_access"]
      }
    }
  }
}`;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || MEMBER_AREA_PATH;
const onOauth = pathname.endsWith(`/${MEMBER_MCP_OAUTH_SEGMENT}`);
const onAccount = pathname.endsWith(`/${MEMBER_ACCOUNT_SEGMENT}`);
const onSecurity = pathname.endsWith(`/${MEMBER_SECURITY_SEGMENT}`);
const onApiKeys =
	!onOauth &&
	!onAccount &&
	!onSecurity &&
	(pathname === memberPath ||
		pathname.endsWith(`/${MEMBER_API_KEYS_SEGMENT}`) ||
		pathname.endsWith("/api-keys"));

const cursorBearerJson = `{
  "mcpServers": {
    "aadm": {
      "type": "http",
      "url": "${urlMcpRpcUrl}",
      "headers": {
        "Authorization": "Bearer ak_…"
      }
    }
  }
}`;

const curlBearerSnippet = `curl -sS -X POST ${urlMcpRpcUrl} \\
  -H "Authorization: Bearer ak_…" \\
  -H "Content-Type: application/json" \\
  -H "Accept: application/json, text/event-stream" \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}'`;

const copyOnClick = `const id=this.getAttribute('data-copy-text');if(!id)return;navigator.clipboard.writeText(id).then(()=>{const t=this.textContent;this.textContent='Copied';setTimeout(()=>{this.textContent=t},2000)}).catch(()=>{})`;

const clerkAppearance = MEMBER_CLERK_CONTENT_ONLY_APPEARANCE;
---

<div
	class="member-area-card min-w-0 max-w-full overflow-hidden rounded-2xl border border-border-subtle bg-surface-card/80 text-slate-200 shadow-sm"
	data-member-area-root
	data-member-panel={onOauth
		? MEMBER_MCP_OAUTH_SEGMENT
		: onAccount
			? MEMBER_ACCOUNT_SEGMENT
			: onSecurity
				? MEMBER_SECURITY_SEGMENT
				: MEMBER_API_KEYS_SEGMENT}
>
	<MemberNavTabs />

	<div class="member-area-panel min-w-0 p-4 sm:p-6">
		{
			onApiKeys && (
				<section
					class="member-cred-panel"
					aria-labelledby="api-keys-guide-heading"
					data-cred-panel={MEMBER_API_KEYS_SEGMENT}
				>
					<h2
						id="api-keys-guide-heading"
						class="font-display text-lg font-bold text-slate-100"
					>
						Use your API key as a Bearer token
					</h2>
					<p class="mt-2 text-sm leading-relaxed text-slate-400">
						Best for <strong class="font-semibold text-slate-100">Cursor</strong>,{" "}
						<strong class="font-semibold text-slate-100">Windsurf</strong>,{" "}
						<strong class="font-semibold text-slate-100">Codex</strong>, and{" "}
						<strong class="font-semibold text-slate-100">curl</strong>. Create a personal{" "}
						<code class="rounded bg-white/5 px-1 font-mono text-accent-violet">ak_…</code> key
						below, then paste it as a Bearer token — not an OAuth Client ID.
					</p>
					<ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-slate-400">
						<li>
							Create a key in the Clerk section below. Copy the full{" "}
							<code class="font-mono text-accent-violet">ak_…</code> value once (shown only at
							creation).
						</li>
						<li>
							In Cursor, edit <code class="font-mono text-slate-300">~/.cursor/mcp.json</code> (or
							project <code class="font-mono text-slate-300">.cursor/mcp.json</code>) with the JSON
							below — replace <code class="font-mono text-accent-violet">ak_…</code> with your key.
						</li>
						<li>Reload MCP in Cursor, then call a tool (for example tools list).</li>
					</ol>

					<div class="mt-5">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<p class="font-mono text-[13px] normal-case tracking-[0.01em] text-slate-400">
								Cursor · mcp.json
							</p>
							<button
								type="button"
								class="shrink-0 rounded-md border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white hover:bg-white/15"
								data-copy-text={cursorBearerJson}
								onclick={copyOnClick}
							>
								Copy JSON
							</button>
						</div>
						<pre class="mt-2 max-w-full overflow-x-auto rounded-lg border border-border-subtle bg-surface-mid p-3 font-mono text-xs leading-relaxed text-slate-300"><code>{cursorBearerJson}</code></pre>
					</div>

					<div class="mt-5">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<p class="font-mono text-[13px] normal-case tracking-[0.01em] text-slate-400">
								Header · curl
							</p>
							<button
								type="button"
								class="shrink-0 rounded-md border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white hover:bg-white/15"
								data-copy-text={curlBearerSnippet}
								onclick={copyOnClick}
							>
								Copy curl
							</button>
						</div>
						<pre class="mt-2 max-w-full overflow-x-auto rounded-lg border border-border-subtle bg-surface-mid p-3 font-mono text-xs leading-relaxed text-slate-300"><code>{curlBearerSnippet}</code></pre>
					</div>

					<p class="mt-4 text-xs text-slate-400">
						Header form:{" "}
						<code class="font-mono text-accent-violet">Authorization: Bearer ak_…</code>. Claude Code
						/ claude.ai should use{" "}
						<strong class="font-semibold text-slate-300">Connectors OAuth</strong> instead.
					</p>

					<div
						class="member-clerk-widget mt-6 min-w-0 rounded-xl border border-border-subtle bg-surface-mid/80 p-3 sm:p-4"
						data-clerk-widget="api-keys"
					>
						<APIKeys appearance={clerkAppearance} />
					</div>

					<MemberConnectionHelp idPrefix="api-keys" />
				</section>
			)
		}

		{
			onOauth && (
				<section
					class="member-cred-panel member-cred-panel--oauth max-w-xl"
					aria-labelledby="oauth-heading"
					data-cred-panel={MEMBER_MCP_OAUTH_SEGMENT}
				>
					<h2 id="oauth-heading" class="font-display text-lg font-bold text-slate-100">
						Connect with your AADM login
					</h2>
					<p class="mt-2 text-sm leading-relaxed text-slate-400">
						Give your client this one URL. It will send you to AADM's sign-in page; sign in with the account
						you use here and click <strong class="font-semibold text-slate-100">Allow</strong>. There is no client ID
						or secret to copy.
					</p>
					<div class="mt-4 flex flex-wrap items-center gap-3">
						<code class="min-w-0 flex-1 break-all rounded-lg border border-border-subtle bg-surface-mid px-3 py-2 font-mono text-sm text-slate-200">
							{mcpUrl}
						</code>
						<button
							type="button"
							class="shrink-0 rounded-lg bg-accent-violet px-4 py-2 text-sm font-semibold text-surface-deep hover:bg-accent-violet/90"
							data-copy-text={mcpUrl}
							onclick={copyOnClick}
						>
							Copy URL
						</button>
					</div>

					<h3 class="mt-8 font-display text-base font-bold text-slate-100">Where to paste it</h3>
					<dl class="mt-3 space-y-4 text-sm leading-relaxed text-slate-400">
						<div>
							<dt class="font-semibold text-slate-100">Cursor</dt>
							<dd class="mt-1">
								Cursor Settings → <strong class="font-semibold text-slate-300">Tools &amp; MCP</strong> →{" "}
								<strong class="font-semibold text-slate-300">New MCP Server</strong>, paste the JSON below, then click{" "}
								<strong class="font-semibold text-slate-300">Needs login</strong>.
							</dd>
							<dd class="mt-2 flex justify-end">
								<button
									type="button"
									class="shrink-0 rounded-lg border border-white/15 px-3 py-1.5 text-sm font-semibold text-slate-200 hover:bg-white/5"
									data-copy-text={cursorUrlJson}
									onclick={copyOnClick}
								>
									Copy JSON
								</button>
							</dd>
							<dd>
								<pre class="mt-2 max-w-full overflow-x-auto rounded-lg border border-border-subtle bg-surface-mid p-3 font-mono text-xs leading-relaxed text-slate-300"><code>{cursorUrlJson}</code></pre>
							</dd>
						</div>
						<div>
							<dt class="font-semibold text-slate-100">Claude Code</dt>
							<dd class="mt-1">
								Run the command below, then type <code class="font-mono text-slate-300">/mcp</code> in Claude Code and
								choose <strong class="font-semibold text-slate-300">Authenticate</strong>.
							</dd>
							<dd>
								<pre class="mt-2 max-w-full overflow-x-auto rounded-lg border border-border-subtle bg-surface-mid p-3 font-mono text-xs leading-relaxed text-slate-300"><code>{claudeCodeCommand}</code></pre>
							</dd>
						</div>
						<div>
							<dt class="font-semibold text-slate-100">claude.ai and Claude Desktop</dt>
							<dd class="mt-1">
								Settings → <strong class="font-semibold text-slate-300">Connectors</strong> →{" "}
								<strong class="font-semibold text-slate-300">Add custom connector</strong>. Paste the URL, leave the
								advanced OAuth fields blank, and click <strong class="font-semibold text-slate-300">Connect</strong>.
							</dd>
						</div>
						<div>
							<dt class="font-semibold text-slate-100">ChatGPT, Windsurf, and other MCP clients</dt>
							<dd class="mt-1">
								Add a remote MCP server with the URL and choose OAuth when asked. The sign-in page is the same.
							</dd>
						</div>
					</dl>

					<details class="mt-8 rounded-lg border border-border-subtle bg-surface-mid/40 p-4">
						<summary class="cursor-pointer text-sm font-semibold text-slate-200">
							My client asks for a Client ID
						</summary>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">
							Some older clients cannot identify themselves and ask for an OAuth Client ID. Use this one, shared by
							all members. Leave Client Secret blank.
						</p>
						{oauthClientId ? (
							<div class="mt-3 flex flex-wrap items-center gap-3">
								<code
									class="min-w-0 flex-1 break-all rounded-lg border border-border-subtle bg-surface-mid px-3 py-2 font-mono text-sm text-slate-200"
									title="Full Client ID is copied when you use Copy"
								>
									{maskedClientId}
								</code>
								<button
									type="button"
									class="shrink-0 rounded-lg border border-white/15 px-3 py-1.5 text-sm font-semibold text-slate-200 hover:bg-white/5"
									data-copy-text={oauthClientId}
									onclick={copyOnClick}
								>
									Copy client ID
								</button>
							</div>
						) : (
							<div class="mt-3 rounded-lg border border-amber-500/40 bg-amber-500/10 p-4">
								<p class="text-sm text-amber-100">
									Client ID is not available yet. Contact us if this persists.
								</p>
							</div>
						)}
						<p class="mt-4 text-sm leading-relaxed text-slate-400">
							Cursor with a fixed client ID, if the default JSON above does not connect:
						</p>
						<div class="mt-2 flex justify-end">
							<button
								type="button"
								class="shrink-0 rounded-lg border border-white/15 px-3 py-1.5 text-sm font-semibold text-slate-200 hover:bg-white/5"
								data-copy-text={cursorOAuthJson}
								onclick={copyOnClick}
							>
								Copy JSON
							</button>
						</div>
						<pre class="mt-2 max-w-full overflow-x-auto rounded-lg border border-border-subtle bg-surface-mid p-3 font-mono text-xs leading-relaxed text-slate-300"><code>{cursorOAuthJson}</code></pre>
					</details>
					<p class="mt-4 text-xs text-slate-400">
						Using curl? Open <strong class="font-semibold text-slate-300">API keys</strong> and use an{" "}
						<code class="font-mono text-accent-violet">ak_…</code> key as a Bearer token.
					</p>

					<MemberConnectionHelp idPrefix="oauth" />
				</section>
			)
		}

		{
			onAccount && (
				<section
					class="member-clerk-widget min-w-0"
					aria-labelledby="profile-heading"
					data-cred-panel={MEMBER_ACCOUNT_SEGMENT}
				>
					<h2 id="profile-heading" class="sr-only">
						Profile
					</h2>
					<UserProfile
						path={memberPath || MEMBER_AREA_PATH}
						routing="path"
						appearance={clerkAppearance}
					>
						<UserProfile.Page label="account" />
					</UserProfile>
				</section>
			)
		}

		{
			onSecurity && (
				<section
					class="member-clerk-widget min-w-0"
					aria-labelledby="security-heading"
					data-cred-panel={MEMBER_SECURITY_SEGMENT}
				>
					<h2 id="security-heading" class="sr-only">
						Security
					</h2>
					<UserProfile
						path={memberPath || MEMBER_AREA_PATH}
						routing="path"
						appearance={clerkAppearance}
					>
						<UserProfile.Page label="security" />
					</UserProfile>
				</section>
			)
		}
	</div>
</div>

<style>
	.member-area-card {
		color-scheme: dark;
	}

	.member-area-card :global(.cl-rootBox),
	.member-area-card :global(.cl-cardBox) {
		width: 100% !important;
		max-width: 100%;
		min-width: 0;
	}

	.member-area-card :global(.cl-navbar),
	.member-area-card :global(.cl-navbarMobileMenuRow),
	.member-area-card :global(.cl-navbarMobileMenuButton) {
		display: none !important;
	}

	.member-area-card :global(.cl-profileSectionContent svg),
	.member-area-card :global(.cl-emptyStateIcon svg),
	.member-area-card :global([class*="emptyState"] svg) {
		max-width: 4rem;
		max-height: 4rem;
	}
</style>
