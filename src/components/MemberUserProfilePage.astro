---
import { UserProfile } from "@clerk/astro/components";
import {
	MEMBER_MCP_OAUTH_SEGMENT,
	memberAreaPathFromEnv,
} from "../lib/member-area";
import { primaryOAuthClientIdFromEnv } from "../lib/member-oauth-client-ids";
import { getSiteUrlConfig, maskMcpOAuthClientId } from "../lib/site-urls";

const memberPath = memberAreaPathFromEnv(import.meta.env);
/** One shared AADM OAuth app — same Client ID for every member (server-configured). */
const oauthClientId = primaryOAuthClientIdFromEnv(import.meta.env);
const { urlMcpRpcUrl } = getSiteUrlConfig(import.meta.env);
const maskedClientId = maskMcpOAuthClientId(oauthClientId);
/** Inline — Clerk UserProfile custom pages do not run Astro `<script>` bundles. */
const copyOnClick = `const id=this.getAttribute('data-copy-oauth-id');if(!id)return;navigator.clipboard.writeText(id).then(()=>{const t=this.textContent;this.textContent='Copied';setTimeout(()=>{this.textContent=t},2000)}).catch(()=>{})`;
---

<div class="clerk-member-profile rounded-2xl border border-border-subtle bg-surface-card/40 p-2 sm:p-4">
	{/*
	  Custom page children must be DIRECT under UserProfile.Page (Clerk Astro docs).
	  Nested Astro components break slot="label-icon" forwarding → blank page body.
	*/}
	<UserProfile path={memberPath} routing="path">
		<UserProfile.Page label="apiKeys" />
		<UserProfile.Page label="Connectors OAuth" url={MEMBER_MCP_OAUTH_SEGMENT}>
			{/*
			  Sized icon required — unsized SVGs can fill the profile panel if Clerk
			  mounts them into page content. Use a plug/link mark, not a padlock.
			*/}
			<svg
				slot="label-icon"
				xmlns="http://www.w3.org/2000/svg"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
				<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
			</svg>
			{/* Light Clerk panel — dark text (not marketing dark-theme colors). */}
			<div class="clerk-oauth-panel max-w-xl text-slate-900">
				<h2 class="font-display text-lg font-bold text-slate-900">Connectors OAuth</h2>
				<p class="mt-2 text-sm leading-relaxed text-slate-600">
					Use this Client ID when you connect AADM in{" "}
					<strong class="font-semibold text-slate-900">Claude Code</strong> or{" "}
					<strong class="font-semibold text-slate-900">claude.ai Connectors</strong>. Leave the Client
					Secret blank. Prefer{" "}
					<strong class="font-semibold text-slate-900">Cursor</strong> or{" "}
					<strong class="font-semibold text-slate-900">curl</strong>? Create an{" "}
					<code class="rounded bg-slate-100 px-1 font-mono text-violet-800">ak_…</code> key under{" "}
					<strong class="font-semibold text-slate-900">API keys</strong> instead — you don't need OAuth
					there.
				</p>
				{
					oauthClientId ? (
						<div class="mt-4 flex flex-wrap items-center gap-3">
							<code
								class="min-w-0 flex-1 break-all rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-sm text-slate-800"
								title="Full Client ID is copied when you use Copy"
							>
								{maskedClientId}
							</code>
							<button
								type="button"
								class="shrink-0 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500"
								data-copy-oauth-id={oauthClientId}
								onclick={copyOnClick}
							>
								Copy client ID
							</button>
						</div>
					) : (
						<div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-4">
							<p class="text-sm text-amber-950">
								OAuth Client ID is not configured on this deploy yet. It should match the OAuth
								application used by the MCP server — contact us if this persists.
							</p>
						</div>
					)
				}
				{
					urlMcpRpcUrl ? (
						<p class="mt-4 text-xs text-slate-500">
							MCP server URL:{" "}
							<code class="font-mono text-xs text-violet-700">{urlMcpRpcUrl}</code>
						</p>
					) : null
				}
			</div>
		</UserProfile.Page>
		<UserProfile.Page label="account" />
		<UserProfile.Page label="security" />
	</UserProfile>
</div>

<style>
	.clerk-member-profile :global(.cl-rootBox) {
		width: 100%;
	}

	/* Keep sidenav / leaked icons from expanding into the content pane. */
	.clerk-member-profile :global(.cl-navbarButtonIcon svg),
	.clerk-member-profile :global(.cl-navbarButton svg) {
		width: 1rem;
		height: 1rem;
		max-width: 1rem;
		max-height: 1rem;
		flex-shrink: 0;
	}

	.clerk-member-profile :global(.cl-profilePage > svg),
	.clerk-member-profile :global(.cl-profilePage > div > svg:first-child),
	.clerk-member-profile :global(svg[slot="label-icon"]) {
		width: 1rem !important;
		height: 1rem !important;
		max-width: 1rem;
		max-height: 1rem;
	}

	/* Clerk empty-state illustrations — cap size if theme CSS stretches them. */
	.clerk-member-profile :global(.cl-profileSectionContent svg),
	.clerk-member-profile :global(.cl-emptyStateIcon svg),
	.clerk-member-profile :global([class*="emptyState"] svg) {
		max-width: 4rem;
		max-height: 4rem;
	}
</style>
