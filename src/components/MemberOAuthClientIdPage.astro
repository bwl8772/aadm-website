---
import { maskMcpOAuthClientId } from "../lib/site-urls";

interface Props {
	title: string;
	lead: string;
	clientId: string;
	mcpRpcUrl?: string;
	envVarHint?: string;
}

const {
	title,
	lead,
	clientId,
	mcpRpcUrl,
	envVarHint = "CLERK_OAUTH_CLIENT_ID",
} = Astro.props;
const masked = maskMcpOAuthClientId(clientId);
const copyId = `copy-oauth-${title.toLowerCase().replace(/\s+/g, "-")}`;
---

<div class="max-w-xl">
	<h2 class="font-display text-lg font-bold text-white">{title}</h2>
	<p class="mt-2 text-sm text-slate-300" set:html={lead} />
	<p class="mt-2 text-xs text-slate-500">
		Operator env: <code class="font-mono">{envVarHint}</code> — one OAuth app for all subscribers.
	</p>

	{
		clientId ? (
			<div class="mt-4 flex flex-wrap items-center gap-3">
				<code
					class="min-w-0 flex-1 break-all rounded-lg border border-border-subtle bg-surface-deep px-3 py-2 font-mono text-sm text-slate-100"
					title="Full Client ID is copied when you use Copy"
				>
					{masked}
				</code>
				<button
					type="button"
					class="shrink-0 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500"
					data-copy-oauth-id={clientId}
					data-copy-feedback={copyId}
				>
					Copy client ID
				</button>
			</div>
		) : (
			<div class="mt-4 rounded-lg border border-amber-500/40 bg-amber-950/40 p-4">
				<p class="text-sm text-amber-100">
					OAuth Client ID is not configured on this deploy. Set{" "}
					<code class="font-mono text-xs">{envVarHint}</code> on Railway (same Clerk OAuth app as the MCP server).
				</p>
			</div>
		)
	}

	{
		mcpRpcUrl ? (
			<p class="mt-4 text-xs text-slate-400">
				MCP server URL: <code class="font-mono text-xs text-violet-300">{mcpRpcUrl}</code>
			</p>
		) : null
	}
</div>

<script>
	document.querySelectorAll("[data-copy-oauth-id]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const id = btn.getAttribute("data-copy-oauth-id");
			if (!id) return;
			void navigator.clipboard.writeText(id).then(() => {
				const label = btn.textContent;
				btn.textContent = "Copied";
				window.setTimeout(() => {
					btn.textContent = label;
				}, 2000);
			});
		});
	});
</script>
