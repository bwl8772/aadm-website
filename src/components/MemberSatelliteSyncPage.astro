---
import {
	getAccountPortalUrls,
	getMemberSignInUrl,
} from "../lib/account-portal-urls";

interface Props {
	/** When set, Account Portal `redirect_url` returns here after sign-in. Default: member area. */
	returnPath?: string;
}

const { returnPath } = Astro.props;
const signInUrl = returnPath
	? getAccountPortalUrls(import.meta.env, returnPath).signInUrl
	: getMemberSignInUrl(import.meta.env);
/** Handshake wait only. First visits never reach this page (middleware redirects). */
const syncTimeoutMs = 4_000;
---

<div
	class="rounded-2xl border border-border-subtle bg-surface-card/40 p-8 text-center sm:p-12"
	aria-live="polite"
	data-sign-in-url={signInUrl}
>
	<p class="font-display text-lg font-semibold text-foreground">Syncing your session</p>
	<p class="mt-2 text-sm text-muted-foreground">
		Returning from <strong class="text-text-secondary">accounts.aadm.io</strong>. This usually takes a
		few seconds.
	</p>
	<p class="mt-6 text-xs text-muted-foreground" id="member-sync-status">
		Finishing authentication…
	</p>
	<a class="sr-only" href={signInUrl} data-sync-sign-in>Sign in</a>
</div>

<script is:inline define:vars={{ signInUrl, syncTimeoutMs }}>
	async function waitForSatelliteSync() {
		const statusEl = document.getElementById("member-sync-status");
		const deadline = Date.now() + syncTimeoutMs;

		while (Date.now() < deadline) {
			try {
				const clerk = window.Clerk;
				if (clerk) {
					if (typeof clerk.load === "function") {
						const remaining = Math.max(250, deadline - Date.now());
						await Promise.race([
							clerk.load(),
							new Promise((_, reject) =>
								setTimeout(() => reject(new Error("load-timeout")), remaining),
							),
						]).catch(() => {});
					}
					if (clerk.user) {
						const url = new URL(window.location.href);
						url.searchParams.delete("__clerk_synced");
						window.location.replace(url.toString());
						return;
					}
					// clerk-js is up and there is no session — do not keep polling.
					break;
				}
			} catch {
				/* retry until timeout */
			}
			await new Promise((resolve) => setTimeout(resolve, 200));
		}

		if (statusEl) {
			statusEl.textContent = "Redirecting to sign-in…";
		}
		window.location.replace(signInUrl);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", () => void waitForSatelliteSync(), {
			once: true,
		});
	} else {
		void waitForSatelliteSync();
	}
</script>
