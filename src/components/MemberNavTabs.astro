---
/**
 * Astro-owned member navigation — top tabs on every viewport.
 * Colors inherit site surface tokens (see `src/styles/global.css`), not hardcoded light.
 */
import {
	MEMBER_API_KEYS_SEGMENT,
	MEMBER_AREA_PATH,
	MEMBER_MCP_OAUTH_SEGMENT,
	memberAreaPathFromEnv,
} from "../lib/member-area";

const memberPath = memberAreaPathFromEnv(import.meta.env);
const pathname = Astro.url.pathname.replace(/\/+$/, "") || MEMBER_AREA_PATH;

const tabs = [
	{
		id: "api-keys",
		label: "API keys",
		href: `${memberPath}/${MEMBER_API_KEYS_SEGMENT}`,
		active:
			pathname === memberPath ||
			pathname.endsWith(`/${MEMBER_API_KEYS_SEGMENT}`) ||
			pathname.endsWith("/api-keys"),
	},
	{
		id: "mcp-oauth",
		label: "Connectors OAuth",
		href: `${memberPath}/${MEMBER_MCP_OAUTH_SEGMENT}`,
		active: pathname.endsWith(`/${MEMBER_MCP_OAUTH_SEGMENT}`),
	},
	{
		id: "account",
		label: "Profile",
		href: `${memberPath}/account`,
		active: pathname.endsWith("/account"),
	},
	{
		id: "security",
		label: "Security",
		href: `${memberPath}/security`,
		active: pathname.endsWith("/security"),
	},
] as const;
---

<nav class="member-nav-tabs" aria-label="Member area sections">
	<div class="member-nav-tabs__scroll" role="tablist">
		{
			tabs.map((tab) => (
				<a
					id={`member-tab-${tab.id}`}
					href={tab.href}
					role="tab"
					aria-selected={tab.active ? "true" : "false"}
					class:list={[
						"member-nav-tabs__tab",
						tab.active && "member-nav-tabs__tab--active",
					]}
					data-member-tab={tab.id}
				>
					{tab.label}
				</a>
			))
		}
	</div>
</nav>

<style>
	.member-nav-tabs {
		min-width: 0;
		width: 100%;
		border-bottom: 1px solid var(--color-border-subtle);
		background: transparent;
	}

	.member-nav-tabs__scroll {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.25rem;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		padding: 0.5rem 0.75rem 0;
	}

	.member-nav-tabs__tab {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.625rem 0.875rem;
		margin-bottom: -1px;
		border-bottom: 2px solid transparent;
		border-radius: 0.375rem 0.375rem 0 0;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.25;
		color: rgb(148 163 184);
		text-decoration: none;
		white-space: nowrap;
	}

	.member-nav-tabs__tab:hover {
		color: rgb(241 245 249);
		background: rgb(255 255 255 / 0.04);
	}

	.member-nav-tabs__tab--active {
		color: rgb(241 245 249);
		border-bottom-color: var(--color-accent-violet);
	}

	.member-nav-tabs__tab:focus-visible {
		outline: 2px solid var(--color-accent-violet);
		outline-offset: 2px;
	}
</style>
