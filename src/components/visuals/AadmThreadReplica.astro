---
/**
 * Non-interactive "live session" replica of an editor agent thread calling AADM.
 * Decorative: aria-hidden panel + sr-only summary; pointer events off.
 * A small script plays the thread step by step and loops; reduced motion shows it static.
 */
type Step =
	| { kind: "user"; text: string }
	| { kind: "think"; label: string; ms: number }
	| { kind: "agent"; text: string }
	| { kind: "tool"; icon: "read" | "run" | "edit"; text: string }
	| { kind: "divider"; label: string }
	| {
			kind: "aadm";
			tool: string;
			status: string;
			lines: string[];
			chips?: string[];
	  };

const steps: Step[] = [
	{
		kind: "user",
		text: "Checkout returns 500 for some EU customers since this morning's deploy. Can you fix it?",
	},
	{ kind: "think", label: "Thought for 2s", ms: 1600 },
	{
		kind: "agent",
		text: "This is a defect, so I'll route it through AADM before touching code.",
	},
	{
		kind: "aadm",
		tool: "debug_defect",
		status: "Investigator · Recon",
		lines: [
			"Halt before fix. Root cause not classified yet.",
			"Next action: reproduce one failing request and capture the stack line.",
			"Not allowed yet: timeout bumps, retries, multi-file edits.",
		],
		chips: ["L13 Logic", "AUTH-11"],
	},
	{
		kind: "tool",
		icon: "run",
		text: "Ran curl POST /checkout  (country=IE)  → 500",
	},
	{
		kind: "tool",
		icon: "read",
		text: "Read src/services/TaxService.ts  L70–95",
	},
	{
		kind: "agent",
		text: "Reproduced. Stack: TaxService.ts:88, vatRate is undefined for “IE”.",
	},
	{
		kind: "aadm",
		tool: "debug_defect",
		status: "Evidence accepted · Diagnose",
		lines: [
			"Classified: missing rate in the tax table. The deploy only exposed it.",
			"Proof required: one IE checkout test, failing first, then passing.",
		],
		chips: ["Classified", "1 file · 1 test"],
	},
	{ kind: "tool", icon: "edit", text: "Edited config/tax-rates.ts  +1 line" },
	{ kind: "tool", icon: "run", text: "Ran npm test checkout.ie  ✗ → ✓" },
	{
		kind: "agent",
		text: "IE rate added. The new test failed first, now passes. One file changed.",
	},
	{ kind: "user", text: "Nice. Safe to ship?" },
	{ kind: "think", label: "Thought for 1s", ms: 1100 },
	{
		kind: "aadm",
		tool: "predone_review",
		status: "Ready with residual",
		lines: [
			"Ship the IE fix.",
			"Residual: other EU rates unverified. Logged as a follow-up, not hidden.",
		],
	},
	{
		kind: "agent",
		text: "Shipped. Follow-up opened to verify the remaining EU rates.",
	},

	// Scenario 2 — a long-running integration suite with ~90 failures.
	{ kind: "divider", label: "Later · integration-suite" },
	{
		kind: "user",
		text: "Integration suite has been running 5h 14m. ~55 files with failures, 80–96 failing tests, 67 look like timeouts at 30s/60s/180s. Plus hard errors in llm-gateway and signal ingest. Where do I even start?",
	},
	{ kind: "think", label: "Thought for 3s", ms: 2200 },
	{
		kind: "agent",
		text: "That much red is rarely one cause. Routing to AADM before I touch timeouts or tests.",
	},
	{
		kind: "aadm",
		tool: "triage_bug",
		status: "Investigator · Triage",
		lines: [
			"Not one bug. Four clusters.",
			"67 timeouts: the worker used 7 min of CPU in 5 h. Tests are waiting, not spinning.",
			"Hard errors: llm-gateway (undefined adapter response), signal ingest (FK after row gone), unique index.",
			"Whole-file wipeouts: l3-pack01, l3-pack02, stale-block-instance.409, lexi_topic_fill_all_3.",
		],
		chips: ["4 clusters", "Timeout rule active"],
	},
	{
		kind: "tool",
		icon: "read",
		text: "Read ~/Desktop/f1-step3-integration.txt  L1–420",
	},
	{
		kind: "tool",
		icon: "run",
		text: "Ran grep -l DrizzleQueryError  → 6 files, all SELECT … FOR UPDATE or forge_audit_log inserts",
	},
	{
		kind: "agent",
		text: "Timeouts cluster on L3, Edge and lock tests. The hard errors fail fast, in under 2 seconds.",
	},
	{
		kind: "aadm",
		tool: "debug_defect",
		status: "Halt · No timeout inflation",
		lines: [
			"Forbidden right now: raising timeouts, re-running the full suite, touching 55 files.",
			"Proof required for one timed-out test: last successful DB call and the exact wait that hung.",
			"Single next action: run edge-asset-production-routes-approval-occ alone with query tracing.",
		],
		chips: ["L13 Logic", "AUTH-24", "1 test · traced"],
	},
	{
		kind: "tool",
		icon: "run",
		text: "Ran vitest edge-asset-production-routes-approval-occ --trace  → 4 failed · waiting on SELECT … FOR UPDATE for 180s",
	},
	{
		kind: "agent",
		text: "Found it. Every timed-out test waits on a row lock held by a transaction another worker never commits. The suite isn't slow; it's deadlocked.",
	},
	{ kind: "user", text: "And the hard errors?" },
	{ kind: "think", label: "Thought for 2s", ms: 1500 },
	{
		kind: "aadm",
		tool: "classify_bug",
		status: "Classified · 2 defects, 1 hygiene",
		lines: [
			"Lock leak in the test harness: one defect behind all 67 timeouts.",
			"llm-gateway: embed adapter returns undefined on its error path. Second defect, separate change.",
			"Unique-index and FK failures: fixtures run out of order. Test hygiene, not product bugs.",
		],
		chips: ["Classified", "Targeted rerun, not full CI"],
	},
	{
		kind: "tool",
		icon: "edit",
		text: "Edited test/harness/db.ts  +3 lines  (release lock on teardown)",
	},
	{
		kind: "tool",
		icon: "run",
		text: "Ran vitest --changed  ✓ 61 passed · 12 min, not 5 h",
	},
	{
		kind: "agent",
		text: "Harness fix released the locks: 61 timeouts gone in one targeted run. No timeout was raised. llm-gateway is next, as its own change.",
	},

	// Scenario 2, continued — the llm-gateway cluster, one cluster at a time.
	{
		kind: "agent",
		text: "Starting with the llm-gateway cluster: it already has stack frames and fails in 2 seconds. I'll classify it with AADM, then fix and prove one cluster at a time.",
	},
	{
		kind: "tool",
		icon: "read",
		text: "Read server/services/llm/llm-gateway.integration.test.ts  + provider-registry.ts",
	},
	{
		kind: "agent",
		text: "The stack points at overlay adapters returning undefined. Looks like isolate:false: a first-bound provider mock skips the overlay table, so complete, stream and embed all return undefined.",
	},
	{
		kind: "aadm",
		tool: "debug_defect",
		status: "Hold · Not yet classified",
		lines: [
			"Plausible, not proven. Suite-order pollution and a standalone break look identical from here.",
			"Single next action: run llm-gateway.integration.test.ts alone.",
			"Forbidden right now: changing the registry before the isolated run.",
		],
		chips: ["UNCLASSIFIED", "1 file · isolated"],
	},
	{
		kind: "tool",
		icon: "run",
		text: "Ran vitest run llm-gateway.integration.test.ts  (isolated)  → 1 failed | 7 passed · 6.39s",
	},
	{
		kind: "agent",
		text: "Isolated run: the four contract tests pass, so the suite failures are first-bind pollution. The one remaining fail is the embed-dimension boot check.",
	},
	{
		kind: "aadm",
		tool: "debug_defect",
		status: "Classified · 2 fixes, 1 file each",
		lines: [
			"Root cause: isolate:false first-binds a leftover vendor mock that never consults the provider overlay.",
			"Fix 1: the registry consults the overlay table before any first-bound adapter.",
			"Fix 2: feed the real column dimension through the db mock so the boot check cannot skip.",
		],
		chips: ["Classified", "L13 Logic", "AUTH-24"],
	},
	{
		kind: "tool",
		icon: "edit",
		text: "Edited provider-registry.ts  +9 lines  (overlay always wins)",
	},
	{
		kind: "tool",
		icon: "edit",
		text: "Edited llm-gateway.integration.test.ts  +4 lines  (dim-check mock stamp)",
	},
	{
		kind: "tool",
		icon: "run",
		text: "Ran vitest run llm-gateway.integration.test.ts  ✓ 8 passed · 5.38s",
	},
	{
		kind: "tool",
		icon: "run",
		text: "Ran 4 neighbouring LLM specs  ✓ 6 · ✓ 7 · ✓ 6 · ✓ 1 passed",
	},
	{
		kind: "agent",
		text: "Cluster 2 is proven. Next is the unique-index cluster: reproduce it in isolation, then classify before changing anything.",
	},

	// Scenario 3 — assessing an inherited, vibe-coded app before an architecture meeting.
	{ kind: "divider", label: "Later · inherited-app" },
	{
		kind: "user",
		text: "We inherited an app a contractor vibe-coded. Hundreds of services, two schemas, no tests. Leadership wants to know if we keep building on it. Where do we even start?",
	},
	{
		kind: "agent",
		text: "Tell me what you want to do with it. Ship it as is, harden it, or decide whether to rebuild?",
	},
	{ kind: "user", text: "Decide. We have one architecture meeting next week." },
	{ kind: "think", label: "Thought for 2s", ms: 1600 },
	{
		kind: "agent",
		text: "I'll start with AADM's repo-mapping path: route the work, pull the map contract, then collect evidence from this repo.",
	},
	{
		kind: "aadm",
		tool: "route_lane",
		status: "Lane · assurance",
		lines: [
			"The question is prove what exists, not build or fix. Sentinel.",
			"Scope & frame → Trace & bind evidence → Attest readiness.",
			"Recommended skills: survey-context, then review-architecture.",
		],
		chips: ["Sentinel", "survey-context"],
	},
	{
		kind: "aadm",
		tool: "repo_architecture_map",
		status: "Contract · bring evidence",
		lines: [
			"I do not scan your repo. You collect; I check the shape.",
			"Each responsibility L1–L22: where it lives, proof kind (source · runtime · test), or unknown.",
			"Missing proof stays unknown. Layer numbers are placement, not scores.",
		],
		chips: ["map contract", "no repo scan"],
	},
	{
		kind: "tool",
		icon: "read",
		text: "Read docs/ENGINEERING_RULES.md + docs/DECISION_LOG.md  → the intended contract already exists",
	},
	{
		kind: "tool",
		icon: "run",
		text: "Ran grep -rln 'x-organization-id|hasPermission|@shared/schema' src/  → 4 trust files · 208 leftover-schema importers · 21 raw fetch files",
	},
	{
		kind: "tool",
		icon: "read",
		text: "Read apiClient.ts, chainDefinitions.ts, Documents.tsx, knowledge.routes.ts",
	},
	{
		kind: "agent",
		text: "Walked one journey: login → hub → documents → knowledge. Three things decide trust, one decides scope. Submitting the map.",
	},
	{
		kind: "aadm",
		tool: "repo_architecture_map",
		status: "Checked · 15 placed, 7 unknown",
		lines: [
			"Two live paths for one product: the intended path and a leftover one. The map shows both.",
			"The documents page is a UI stub; a knowledge API is already live behind it.",
			"Unknown (no proof): authorization policy, audit trail, release gate, verification.",
		],
		chips: ["Mermaid ready", "7 unknown", "static-only ≠ verified"],
	},
	{
		kind: "tool",
		icon: "edit",
		text: "Wrote docs/architecture-map.md  (intended path vs leftover path)",
	},
	{ kind: "user", text: "So what's actually broken?" },
	{
		kind: "aadm",
		tool: "sentinel_handoff_hint",
		status: "3 findings · 2 defects, 1 inventory",
		lines: [
			"Tenant: the client names the org, the server prefers the header. confirmed_defect, AUTH-32 → Investigator.",
			"Admin gate: hasPermission returns true. confirmed_defect, AUTH-34 → Investigator.",
			"208 files import the leftover schema. An inventory, not a rewrite list → Navigator, later.",
		],
		chips: ["AUTH-32", "AUTH-34", "do not open schema"],
	},
	{
		kind: "agent",
		text: "Honest version: AADM did not find these. Reading the source did. AADM named the map, linted the plan, and gave the room a shared agenda. The hard part was never the bugs; it is telling live product from leftover code so nobody boils the ocean.",
	},
	{
		kind: "aadm",
		tool: "interrogate_plan",
		status: "Plan holds · 2 stop rules",
		lines: [
			"First slice: tenant header, then admin gate. One owner, proof of done per fix.",
			"Out of scope for wave 1: schema migration, RAG, the leftover route tree.",
			"Stop rule: a fix that touches more than the four trust files goes back to the room.",
		],
		chips: ["T1 → T2", "stop rules", "5–8 pages, one picture"],
	},
	{
		kind: "agent",
		text: "For the meeting: one diagram, a three-row risk register with file and line, the inventory counted but not scheduled, and a first-slice RFC. Ninety minutes in the room.",
	},
	{ kind: "user", text: "How long would that have taken us without this?" },
	{
		kind: "agent",
		text: "About three weeks: a week of orientation for whoever is new to the repo, then one to two weeks of audit and sign-off paper. This thread took fifteen minutes. 120 working hours to a quarter of one, roughly 480×, for the same three findings.",
	},
];

const toolIcon = {
	read: "M2 3h8l4 4v8H2z M10 3v4h4",
	run: "M4 3l9 5-9 5z",
	edit: "M3 13l1-4 7-7 3 3-7 7z",
};
---

<figure class="aadm-replica relative mx-auto w-full max-w-3xl select-none" style="pointer-events:none">
	<p class="sr-only">
		Illustration of a live editor agent session with three threads. First, a developer reports a checkout error; the agent calls
		AADM, which holds the fix until the failure is reproduced, classifies the root cause from evidence, requires one test, and
		marks the release ready with one residual risk logged. Second, a five-hour integration suite shows about ninety failures;
		AADM sorts them into four clusters, forbids raising timeouts, requires a trace of one hung test, which reveals a lock leak
		in the test harness, and a targeted rerun clears sixty-one timeouts. The agent then isolates the llm-gateway cluster, AADM holds until an isolated run separates suite-order pollution from a real break, two one-file fixes land, and the cluster is proven green. Third, a team inherits a vibe-coded app with two schemas and no tests; AADM routes it to assurance, hands over the map contract without scanning the repo, the agent walks one user journey and submits the map, three findings come back with controls and owners, and the agent says plainly that source reading found the bugs while AADM named the map and gave the meeting a shared agenda and stop rules, in fifteen minutes instead of the three weeks a formal audit would take.
	</p>
	<div aria-hidden="true" inert class="overflow-hidden rounded-xl border border-white/10 bg-[#0b0d14] shadow-[0_40px_120px_-40px_rgba(16,185,129,0.25)]">
		<div class="flex items-center gap-3 border-b border-white/[0.07] bg-[#0e1119] px-4 py-2.5">
			<span class="flex gap-1.5">
				<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
				<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
				<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
			</span>
			<span class="text-[13px] text-slate-400">Agent · 3 threads</span>
			<span class="ml-auto inline-flex items-center gap-1.5 text-[12px] text-rose-200">
				<span class="aadm-live-dot h-1.5 w-1.5 rounded-full bg-rose-400"></span> Live session
			</span>
			<span class="hidden items-center gap-1.5 rounded border border-emerald-400/30 px-2 py-0.5 text-[12px] text-emerald-200 sm:inline-flex">
				<img src="/favicon.svg" alt="" width="12" height="12" class="h-3 w-3" /> aadm
			</span>
		</div>

		<div data-replica-viewport class="relative h-[30rem] overflow-hidden sm:h-[34rem]">
			<div data-replica-thread class="space-y-4 px-4 py-5 transition-opacity duration-700 sm:px-6">
				{steps.map((m) =>
					m.kind === "user" ? (
						<div data-step="user" class="aadm-step flex justify-end">
							<p class="max-w-[85%] rounded-lg bg-white/[0.07] px-4 py-2.5 text-[14px] leading-relaxed text-slate-100">
								<span class="text-[11.5px] font-semibold text-slate-400">You · agentic engineer</span><br />
								<span data-type={m.text}>{m.text}</span>
							</p>
						</div>
					) : m.kind === "think" ? (
						<p data-step="think" data-ms={m.ms} class="aadm-step text-[13px] italic text-slate-500">
							<span data-live>Thinking<span class="aadm-dots"></span></span>
							<span data-done class="aadm-hidden">{m.label}</span>
						</p>
					) : m.kind === "agent" ? (
						<p data-step="agent" class="aadm-step max-w-[90%] text-[14px] leading-relaxed text-slate-300">
							<span data-type={m.text}>{m.text}</span>
						</p>
					) : m.kind === "divider" ? (
						<p data-step="divider" class="aadm-step flex items-center gap-3 pt-4 text-[12px] text-slate-500">
							<span class="h-px flex-1 bg-white/10"></span>
							<span>{m.label}</span>
							<span class="h-px flex-1 bg-white/10"></span>
						</p>
					) : m.kind === "tool" ? (
						<p data-step="tool" class="aadm-step flex items-center gap-2 font-mono text-[12.5px] text-slate-400">
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" class="shrink-0 text-slate-500"><path d={toolIcon[m.icon]} /></svg>
							{m.text}
						</p>
					) : (
						<div data-step="aadm" class="aadm-step aadm-call rounded-lg border border-emerald-400/30 bg-emerald-400/[0.05] px-4 py-3">
							<div class="flex flex-wrap items-center gap-2 text-[12px]">
								<img src="/favicon.svg" alt="" width="18" height="18" class="aadm-mark h-[18px] w-[18px]" />
								<span class="font-semibold text-emerald-200">AADM</span>
								<code class="text-slate-400">{m.tool}</code>
								<span data-running class="ml-auto inline-flex items-center gap-1.5 text-slate-400">
									<span class="aadm-spin h-3 w-3 rounded-full border border-emerald-300/30 border-t-emerald-300"></span> Working
								</span>
								<span data-status class="ml-auto aadm-hidden rounded border border-violet-400/30 px-1.5 py-0.5 text-violet-200">{m.status}</span>
							</div>
							<ul class="mt-2 space-y-1 text-[13.5px] leading-relaxed text-slate-200">
								{m.lines.map((l) => <li data-line>{l}</li>)}
							</ul>
							{m.chips && (
								<div data-line class="mt-2.5 flex flex-wrap gap-1.5">
									{m.chips.map((c) => (
										<span class="rounded border border-white/10 px-1.5 py-0.5 text-[11.5px] text-slate-400">{c}</span>
									))}
								</div>
							)}
						</div>
					),
				)}
			</div>
			<div class="pointer-events-none absolute inset-x-0 top-0 h-12 bg-gradient-to-b from-[#0b0d14] to-transparent"></div>
		</div>

		<div class="flex items-center gap-2 border-t border-white/[0.07] px-4 py-3">
			<span data-composer class="flex-1 truncate rounded-md border border-white/10 bg-white/[0.03] px-3 py-2 text-[13px] text-slate-500">Ask the agent…</span>
		</div>
	</div>
	<figcaption class="mt-4 text-center text-[13px] text-slate-500">
		Replica of a real session in Cursor or Claude Code. Highlighted turns are AADM at work.
	</figcaption>
</figure>

<script>
	const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
	for (const fig of document.querySelectorAll<HTMLElement>(".aadm-replica")) {
		const viewport = fig.querySelector<HTMLElement>("[data-replica-viewport]");
		const thread = fig.querySelector<HTMLElement>("[data-replica-thread]");
		const composer = fig.querySelector<HTMLElement>("[data-composer]");
		const steps = Array.from(fig.querySelectorAll<HTMLElement>("[data-step]"));
		if (!viewport || !thread || !composer) continue;
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) continue;

		const follow = () => viewport.scrollTo({ top: viewport.scrollHeight, behavior: "smooth" });
		const typeInto = async (el: HTMLElement, text: string, perChar: number, byWord = false) => {
			el.textContent = "";
			const parts = byWord ? text.split(/(\s+)/) : Array.from(text);
			for (const p of parts) {
				el.textContent += p;
				await sleep(byWord ? perChar * 3 : perChar);
			}
		};
		const reset = () => {
			for (const s of steps) {
				s.classList.add("aadm-hidden");
				for (const l of s.querySelectorAll<HTMLElement>("[data-line]")) l.classList.add("aadm-hidden");
				s.querySelector("[data-running]")?.classList.remove("aadm-hidden");
				s.querySelector("[data-status]")?.classList.add("aadm-hidden");
				s.querySelector("[data-live]")?.classList.remove("aadm-hidden");
				s.querySelector("[data-done]")?.classList.add("aadm-hidden");
				s.classList.remove("aadm-active");
			}
			viewport.scrollTop = 0;
		};

		const play = async () => {
			for (;;) {
				reset();
				thread.style.opacity = "1";
				await sleep(900);
				for (const s of steps) {
					const kind = s.dataset.step;
					const typed = s.querySelector<HTMLElement>("[data-type]");
					if (kind === "user" && typed) {
						const text = typed.dataset.type ?? "";
						await typeInto(composer, text, 18);
						await sleep(350);
						composer.textContent = "Ask the agent…";
						typed.textContent = text;
						s.classList.remove("aadm-hidden");
						follow();
						await sleep(600);
					} else if (kind === "think") {
						s.classList.remove("aadm-hidden");
						follow();
						await sleep(Number(s.dataset.ms ?? 1200));
						s.querySelector("[data-live]")?.classList.add("aadm-hidden");
						s.querySelector("[data-done]")?.classList.remove("aadm-hidden");
					} else if (kind === "agent" && typed) {
						s.classList.remove("aadm-hidden");
						follow();
						await typeInto(typed, typed.dataset.type ?? "", 22, true);
						await sleep(500);
					} else if (kind === "tool") {
						s.classList.remove("aadm-hidden");
						follow();
						await sleep(700);
					} else if (kind === "divider") {
						await sleep(1800);
						s.classList.remove("aadm-hidden");
						follow();
						await sleep(1200);
					} else if (kind === "aadm") {
						s.classList.remove("aadm-hidden");
						s.classList.add("aadm-active");
						follow();
						await sleep(1500);
						s.querySelector("[data-running]")?.classList.add("aadm-hidden");
						s.querySelector("[data-status]")?.classList.remove("aadm-hidden");
						for (const l of s.querySelectorAll<HTMLElement>("[data-line]")) {
							l.classList.remove("aadm-hidden");
							follow();
							await sleep(550);
						}
						await sleep(700);
						s.classList.remove("aadm-active");
					}
				}
				await sleep(4500);
				thread.style.opacity = "0";
				await sleep(800);
			}
		};

		const start = new IntersectionObserver((entries) => {
			if (entries.some((e) => e.isIntersecting)) {
				start.disconnect();
				play();
			}
		});
		start.observe(fig);
	}
</script>

