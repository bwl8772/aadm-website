---
type ToneCounts = {
	violet: number;
	amber: number;
	sky: number;
	emerald: number;
};

type Props = {
	vignetteCount: number;
	toneCounts: ToneCounts;
	hoursLowTotal: number;
	hoursHighTotal: number;
	variant?: "tall" | "wide";
};

const { vignetteCount, toneCounts, hoursLowTotal, hoursHighTotal, variant = "wide" } =
	Astro.props;

const lanes = [
	{ key: "violet", label: "Delivery", count: toneCounts.violet, stroke: "stroke-violet-400/50", fill: "fill-violet-400/15", text: "fill-violet-200/80" },
	{ key: "amber", label: "Defect", count: toneCounts.amber, stroke: "stroke-amber-300/50", fill: "fill-amber-300/12", text: "fill-amber-200/80" },
	{ key: "sky", label: "Triage", count: toneCounts.sky, stroke: "stroke-sky-400/50", fill: "fill-sky-400/12", text: "fill-sky-200/80" },
	{ key: "emerald", label: "Assurance", count: toneCounts.emerald, stroke: "stroke-emerald-400/50", fill: "fill-emerald-400/12", text: "fill-emerald-200/80" },
] as const;
---

<div
	class="group relative flex h-full min-h-[240px] flex-col overflow-hidden p-6 sm:p-7 lg:min-h-0"
	aria-hidden="true"
>
	<div
		class="pointer-events-none absolute -left-16 -bottom-16 h-56 w-56 rounded-full bg-emerald-400/10 opacity-60 blur-3xl transition duration-700 group-hover:opacity-100"
	></div>

	<div class="relative flex flex-1 flex-col">
		<p class="font-mono-cta text-[10px] uppercase tracking-[0.24em] text-emerald-200/80">
			Field patterns
		</p>

		<div class="relative mt-4 flex flex-1 flex-col justify-center gap-5">
			<div class="flex items-baseline gap-3">
				<p class="font-display text-[3.5rem] font-extralight leading-none tracking-tight text-emerald-300/90 sm:text-[4rem]">
					{vignetteCount}
				</p>
				<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-500">
					vignettes · fictional apps
				</p>
			</div>

			<div class:list={["grid gap-2", variant === "wide" ? "grid-cols-4" : "grid-cols-2"]}>
				{
					lanes.map((lane) => (
						<div class:list={["border px-3 py-2.5", lane.stroke.replace("stroke-", "border-").replace("/50", "/30")]}>
							<p class="font-mono-cta text-[9px] uppercase tracking-[0.18em] text-slate-500">{lane.label}</p>
							<p class:list={["font-display mt-1 text-2xl font-bold", lane.text.replace("fill-", "text-").replace("/80", "/90")]}>
								{lane.count}
							</p>
						</div>
					))
				}
			</div>

			<svg
				viewBox="0 0 200 48"
				class="w-full max-w-[280px] opacity-80"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<line x1="4" y1="40" x2="196" y2="40" stroke="rgba(255,255,255,0.1)" stroke-width="1" />
				{
					lanes.map((lane, i) => {
						const x = 8 + i * 48;
						const h = 8 + lane.count * 3;
						return (
							<g>
								<rect
									x={x}
									y={40 - h}
									width="32"
									height={h}
									rx="2"
									class:list={[lane.stroke, lane.fill]}
									stroke-width="1"
								/>
								<text
									x={x + 16}
									y="44"
									text-anchor="middle"
									class="fill-slate-600 font-mono text-[6px]"
								>
									{lane.count}
								</text>
							</g>
						);
					})
				}
			</svg>
		</div>

		<div class="relative mt-auto border-t border-white/[0.06] pt-4">
			<p class="font-display text-sm font-semibold tracking-tight text-white/90">
				{hoursLowTotal}–{hoursHighTotal} hrs saved (illustrative)
			</p>
			<p class="mt-1 font-mono-cta text-[10px] uppercase tracking-[0.18em] text-slate-500">
				wrong path vs governed agent session
			</p>
		</div>
	</div>
</div>
