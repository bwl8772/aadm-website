---
type Props = {
	variant?: "tall" | "wide";
	mcpRpcUrl: string;
};

const { variant = "tall", mcpRpcUrl } = Astro.props;
const host = mcpRpcUrl.replace(/\/mcp\/?$/, "").replace(/^https?:\/\//, "");
---

<div
	class="group relative flex h-full min-h-[240px] flex-col overflow-hidden p-6 sm:p-7 lg:min-h-0"
	aria-hidden="true"
>
	<div
		class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-brand-mcp-bg opacity-60 blur-3xl transition duration-700 group-hover:opacity-100"
	></div>

	<div class="relative flex flex-1 flex-col">
		<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">
			Streamable HTTP
		</p>

		<div class="relative mt-4 flex flex-1 items-center justify-center">
			<svg
				viewBox="0 0 220 160"
				class:list={["w-full max-w-[240px]", variant === "wide" ? "max-w-[320px]" : ""]}
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<rect x="12" y="56" width="56" height="32" rx="2" class="stroke-muted-foreground/40 fill-muted-foreground/10" stroke-width="1.2" />
				<text x="40" y="76" text-anchor="middle" class="fill-muted-foreground font-mono text-[7px]">client</text>

				<line x1="68" y1="72" x2="88" y2="72" class="stroke-brand-mcp-border" stroke-width="1" />
				<polygon points="88,68 96,72 88,76" class="fill-brand-mcp" />

				<rect x="96" y="48" width="72" height="48" rx="2" class="stroke-brand-mcp-border fill-brand-mcp-bg" stroke-width="1.2" />
				<text x="132" y="68" text-anchor="middle" class="fill-brand-mcp font-mono text-[7px]">POST /mcp</text>
				<text x="132" y="82" text-anchor="middle" class="fill-brand-mcp/80 font-mono text-[6px]">JSON-RPC</text>

				<line x1="132" y1="96" x2="132" y2="112" class="stroke-brand-mcp-border" stroke-width="1" stroke-dasharray="3 3" />
				<rect x="108" y="112" width="48" height="20" rx="2" class="stroke-brand-mcp-border fill-brand-mcp-bg" stroke-width="1" />
				<text x="132" y="125" text-anchor="middle" class="fill-brand-mcp font-mono text-[6px]">SSE stream</text>

				<line x1="168" y1="72" x2="188" y2="72" class="stroke-brand-warn-border" stroke-width="1" />
				<polygon points="188,68 196,72 188,76" class="fill-brand-warn" />
				<rect x="188" y="56" width="24" height="32" rx="2" class="stroke-brand-warn-border fill-brand-warn-bg" stroke-width="1" />
				<text x="200" y="76" text-anchor="middle" class="fill-brand-warn font-mono text-[6px]">406</text>
				<text x="200" y="98" text-anchor="middle" class="fill-muted-foreground font-mono text-[5px]">GET w/o</text>
				<text x="200" y="106" text-anchor="middle" class="fill-muted-foreground font-mono text-[5px]">Accept</text>

				<rect x="12" y="16" width="96" height="22" rx="2" class="stroke-brand-mcp-border fill-hover" stroke-width="1" />
				<text x="60" y="30" text-anchor="middle" class="fill-brand-mcp font-mono text-[6px]">GET /health</text>

				<rect x="116" y="16" width="92" height="22" rx="2" class="stroke-brand-mcp-border fill-hover" stroke-width="1" />
				<text x="162" y="30" text-anchor="middle" class="fill-brand-mcp font-mono text-[6px]">GET / discovery</text>

				<text x="110" y="152" text-anchor="middle" class="fill-muted-foreground font-mono text-[6px]">{host}</text>
			</svg>
		</div>

		<div class="relative mt-auto border-t border-border pt-4">
			<p class="font-display text-sm font-semibold tracking-tight text-foreground/90">One endpoint, two transports</p>
			<p class="mt-1 font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">
				initialize · tools/list · resources/read
			</p>
		</div>
	</div>
</div>
