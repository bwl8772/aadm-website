---
interface Props {
	/** Shorter line under the MCP sales page. */
	variant?: 'default' | 'mcp';
}

const { variant = 'default' } = Astro.props;
const tagline =
	variant === 'mcp'
		? 'AADM MCP is paid subscriber infrastructure—your production AUTH, gateways, and CI stay authoritative.'
		: 'Static site — Astro. Not a substitute for organizational sign-off or audits.';
---

<footer class="border-t border-border-subtle py-10">
	<div
		class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 text-center text-sm text-slate-500 sm:flex-row sm:text-left sm:px-6"
	>
		<span class="font-display font-semibold text-slate-400">AADM</span>
		<p>{tagline}</p>
	</div>
</footer>
