---
interface Props {
	/** Shorter line under the MCP sales page. */
	variant?: "default" | "mcp";
}

const { variant = "default" } = Astro.props;
const tagline =
	variant === "mcp"
		? "AADM MCP works with your existing code. Your production AUTH, gateways, and CI stay authoritative."
		: "Not a substitute for organizational sign-off or audits.";

const year = new Date().getFullYear();
---

<footer class="relative border-t border-border bg-background">
	<div class="mx-auto max-w-7xl px-4 py-14 sm:px-8 sm:py-16">
		<!-- Editorial top row -->
		<div class="grid grid-cols-12 gap-6 border-b border-border pb-10">
			<div class="col-span-12 sm:col-span-4">
				<a
					href="/"
					class="font-display inline-flex items-baseline gap-3 text-2xl font-bold tracking-tight text-foreground transition hover:text-brand-mcp"
				>
					<img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8 self-center" />
					AADM
					<span class="font-mono-cta text-[13px] font-medium normal-case tracking-[0.01em] text-muted-foreground">
						/ Agentic Authority Delivery Model
					</span>
				</a>
				<p class="mt-4 max-w-xs text-sm leading-relaxed text-muted-foreground">
					An operating model for agentic engineering: an open standard for governed agent-assisted delivery, plus a hosted MCP
					that keeps your tooling versioned, online, and maintained.
				</p>
			</div>
			<nav class="col-span-12 grid grid-cols-2 gap-x-6 gap-y-8 sm:col-span-8 sm:grid-cols-4" aria-label="Footer navigation">
				<div>
					<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">Product</p>
					<ul class="mt-4 space-y-2.5 text-sm">
						<li><a href="/mcp" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Hosted MCP</a></li>
						<li><a href="/field" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Field</a></li>
						<li><a href="/tools" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Tools catalog</a></li>
						<li><a href="/ides" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">IDEs</a></li>
						<li><a href="/stacks" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Compatible stacks</a></li>
					</ul>
				</div>
				<div>
					<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-warn">Read</p>
					<ul class="mt-4 space-y-2.5 text-sm">
						<li><a href="/about" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Agentic engineering</a></li>
						<li><a href="/why-aadm" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Why AADM</a></li>
						<li><a href="/standard" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Open standard</a></li>
						<li><a href="/case-studies" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Stories</a></li>
					</ul>
				</div>
				<div>
					<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-violet">Connect</p>
					<ul class="mt-4 space-y-2.5 text-sm">
						<li><a href="/cursor" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">AADM + Cursor</a></li>
						<li><a href="/claude-code" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">AADM + Claude Code</a></li>
						<li><a href="/governance" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Init your repo</a></li>
					</ul>
				</div>
				<div>
					<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-sky">Buyer</p>
					<ul class="mt-4 space-y-2.5 text-sm">
						<li><a href="/enterprise" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Enterprise</a></li>
						<li><a href="/mcp#two-ways" class="text-text-secondary underline-offset-[6px] transition hover:text-foreground hover:underline">Get access</a></li>
					</ul>
				</div>
			</nav>
		</div>

		<!-- Colophon row -->
		<div class="mt-10 grid grid-cols-12 gap-6">
			<div class="col-span-12 lg:col-span-8">
				<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">
					<span class="text-brand-warn">▸</span> Honest boundary
				</p>
				<p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground">{tagline}</p>
			</div>
			<div class="col-span-12 lg:col-span-4 lg:text-right">
				<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">
					<span class="text-muted-foreground">© {year} AADM</span> · Streamable HTTP / MCP
				</p>
			</div>
		</div>
	</div>
</footer>
