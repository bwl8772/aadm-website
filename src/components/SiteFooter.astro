---
interface Props {
	/** Shorter line under the MCP sales page. */
	variant?: "default" | "mcp";
}

const { variant = "default" } = Astro.props;
const tagline =
	variant === "mcp"
		? "AADM MCP works with your existing code. Your production AUTH, gateways, and CI stay authoritative."
		: "Not a substitute for organizational sign-off or audits.";
---

<footer class="border-t border-border-subtle py-10">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
			<a
				href="/"
				class="font-display font-semibold text-slate-400 transition-colors hover:text-white hover:underline"
			>
				AADM
			</a>
			<nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer navigation">
				<a
					href="/mcp"
					class="text-sm text-slate-400 underline-offset-4 transition-colors hover:text-white hover:underline"
				>Hosted MCP</a>
				<a
					href="/cursor"
					class="text-sm text-slate-400 underline-offset-4 transition-colors hover:text-white hover:underline"
				>AADM + Cursor</a>
				<a
					href="/claude-code"
					class="text-sm text-slate-400 underline-offset-4 transition-colors hover:text-white hover:underline"
				>AADM + Claude Code</a>
			</nav>
		</div>
		<p class="mt-6 text-xs text-slate-400 sm:mt-4">{tagline}</p>
	</div>
</footer>
