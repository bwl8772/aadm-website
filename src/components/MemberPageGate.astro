---
/**
 * Renders member credentials only when SSR auth is present.
 * Unsigned /member with unverifiable cookies shows the session gate (recover or
 * stop) — no UserProfile, no secrets. Without cookies the middleware has
 * already redirected to the Account Portal.
 */
import MemberUserProfilePage from "./MemberUserProfilePage.astro";
import SessionGatePage from "./SessionGatePage.astro";

const { userId } = Astro.locals.auth();
const gate = Astro.locals.sessionGate;
---

{userId ? <MemberUserProfilePage /> : gate ? <SessionGatePage gate={gate} /> : null}
