---
import { maskPublicMcpOAuthClientId } from '../lib/site-urls';

interface Props {
	clientId: string;
	mcpRpcUrl: string;
	accountUserUrl: string;
}

const { clientId, mcpRpcUrl, accountUserUrl } = Astro.props;
const masked = maskPublicMcpOAuthClientId(clientId);
---

<section
	class="rounded-2xl border border-violet-500/35 bg-surface-card/90 p-6"
	aria-labelledby="oauth-client-id-heading"
>
	<h2 id="oauth-client-id-heading" class="font-display text-lg font-bold text-white">OAuth Client ID</h2>
	<p class="mt-2 text-sm text-slate-400">
		Shared for all AADM accounts. Paste into Claude Code or claude.ai Connectors when asked for{' '}
		<code class="font-mono-cta text-xs">client_id</code>. Leave <strong class="text-slate-300">Client Secret</strong> empty.
	</p>

	{
		clientId ? (
			<div class="mt-4 flex flex-wrap items-center gap-3">
				<code
					class="min-w-0 flex-1 break-all rounded-xl border border-border-subtle bg-surface-mid px-4 py-3 font-mono-cta text-sm text-slate-200"
					title="Full Client ID is copied when you use Copy"
					data-masked-oauth-id
				>
					{masked}
				</code>
				<button
					type="button"
					class="shrink-0 rounded-xl bg-gradient-to-r from-violet-600 to-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:brightness-110"
					data-copy-oauth-id={clientId}
				>
					Copy
				</button>
			</div>
		) : (
			<div class="mt-4 rounded-xl border border-amber-500/40 bg-amber-950/30 p-4">
				<p class="text-sm text-amber-100">
					OAuth Client ID is not configured on this site. Set{' '}
					<code class="font-mono-cta text-xs">CLERK_OAUTH_CLIENT_ID</code> on the Astro deploy (same Clerk OAuth app
					as the MCP server).
				</p>
			</div>
		)
	}

	<p class="mt-4 text-xs text-slate-500">
		MCP server URL: <code class="font-mono-cta text-xs text-accent-violet">{mcpRpcUrl}</code>
	</p>
	<p class="mt-2 text-xs text-slate-500">
		Profile and API keys:{' '}
		<a href={accountUserUrl} class="text-accent-violet underline hover:text-accent-blue">
			{accountUserUrl.replace(/^https:\/\//, '')}
		</a>{' '}
		(Clerk Account Portal — no OAuth Client ID there).
	</p>
</section>

<script>
	document.querySelectorAll('[data-copy-oauth-id]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const id = btn.getAttribute('data-copy-oauth-id');
			if (!id) return;
			void navigator.clipboard.writeText(id).then(() => {
				const label = btn.textContent;
				btn.textContent = 'Copied';
				window.setTimeout(() => {
					btn.textContent = label;
				}, 2000);
			});
		});
	});
</script>
