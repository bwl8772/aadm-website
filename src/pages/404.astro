---
import Layout from "../layouts/Layout.astro";
import { getSiteUrlConfig } from "../lib/site-urls";

const { urlMcpMarketing } = getSiteUrlConfig(import.meta.env);
---

<Layout
	title="404 — page not found"
	description="The page you tried to load isn't here. Let's get you back to something useful."
	headerActiveNav={null}
>
	<main id="main" class="relative isolate overflow-x-clip bg-surface-deep text-text-primary">
		<section class="relative">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[length:28px_28px] [mask-image:radial-gradient(ellipse_at_top,black_55%,transparent_85%)]"></div>
			<div aria-hidden="true" class="absolute right-0 top-0 -z-10 h-[36rem] w-[36rem] translate-x-1/3 -translate-y-1/3 rounded-full bg-amber-500/[0.06] blur-3xl"></div>

			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 pb-32 pt-16 sm:px-8 sm:pb-40 sm:pt-24">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-warn">§ 404</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Not found</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<p class="font-mono-cta mb-10 text-[13px] normal-case tracking-[0.01em] text-muted-foreground">
						<span class="text-brand-warn">▸</span> The agent looked everywhere · no evidence found
					</p>

					<h1 class="font-display max-w-[18ch] text-balance text-[clamp(2.6rem,9vw,7rem)] font-bold leading-[0.88] tracking-[-0.01em] text-foreground">
						<span class="text-brand-warn">404.</span> <span class="font-light italic text-muted-foreground">Page not here.</span>
					</h1>

					<div class="mt-14 grid grid-cols-12 gap-6">
						<div class="col-span-12 sm:col-span-4">
							<div class="border-l border-brand-warn-border pl-5">
								<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-warn">What happened</p>
								<p class="mt-3 text-[0.95rem] leading-relaxed text-text-secondary">
									The URL didn't match a known page. Most likely · a typo, a stale link, or content that moved during the
									redesign.
								</p>
							</div>
						</div>
						<div class="col-span-12 sm:col-span-8">
							<p class="text-pretty text-lg leading-[1.65] text-text-secondary sm:text-xl">
								Path-A recon · classify before any agent rewrites the URL. Here are the destinations that almost certainly
								<span class="font-light italic text-muted-foreground"> match what you wanted.</span>
							</p>
						</div>
					</div>

					<!-- Navigator chips -->
					<div class="mt-14 grid grid-cols-1 gap-px bg-white/[0.08] sm:grid-cols-3">
						{
							[
								{ num: "A", title: "Agentic engineering", body: "If you're new here and want the discipline explained from first principles.", href: "/about", tone: "amber" },
								{ num: "B", title: "Hosted MCP", body: "If you're here to connect an IDE or get a token.", href: urlMcpMarketing, tone: "emerald" },
								{ num: "C", title: "Tools catalog", body: "If you're looking for a specific tool name like debug_defect or fetch_auth.", href: "/tools", tone: "violet" },
							].map((d) => {
								const tone =
									d.tone === "amber" ? "text-brand-warn" :
									d.tone === "emerald" ? "text-brand-mcp" :
									"text-brand-violet";
								return (
									<a
										href={d.href}
										class="group bg-surface-deep p-7 transition duration-300 hover:bg-surface-mid sm:p-8"
									>
										<div class="flex items-baseline gap-4">
											<span class:list={["font-display text-[3.5rem] font-light leading-[0.85] transition duration-300 group-hover:opacity-100", tone]}>
												{d.num}
											</span>
										</div>
										<h3 class="font-display mt-6 text-balance text-lg font-bold leading-snug tracking-tight text-foreground sm:text-xl">
											{d.title}
										</h3>
										<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{d.body}</p>
										<div aria-hidden="true" class="mt-6 inline-flex items-center gap-2 text-muted-foreground transition group-hover:text-foreground">
											<span class="font-mono-cta text-sm normal-case tracking-[0.01em]">Go</span>
											<span class="transition group-hover:translate-x-0.5">→</span>
										</div>
									</a>
								);
							})
						}
					</div>

					<div class="mt-14 border-l-2 border-brand-mcp-border pl-6">
						<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">Or start here</p>
						<p class="mt-3 max-w-2xl text-sm leading-relaxed text-text-secondary">
							The homepage anchors the whole story · standard, hosted MCP, three lanes, mental model. From there everything is
							one click away — including <a href="/why-aadm" class="text-brand-mcp underline decoration-brand-mcp underline-offset-4 hover:decoration-brand-mcp">Why AADM</a>.
						</p>
						<a
							href="/"
							class="group mt-6 inline-flex items-center gap-3 bg-white px-6 py-3.5 text-sm font-semibold tracking-tight text-slate-950 outline-none transition duration-200 hover:bg-emerald-200 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>Back to /</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
