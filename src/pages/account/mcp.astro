---
import Layout from '../../layouts/Layout.astro';
import McpOAuthClientIdCard from '../../components/McpOAuthClientIdCard.astro';
import { getAccountPortalUrls } from '../../lib/account-portal-urls';
import { mcpOAuthClientIdForDisplay } from '../../lib/mcp-oauth-client-id';
import { getSiteUrlConfig } from '../../lib/site-urls';

const clientId = mcpOAuthClientIdForDisplay(import.meta.env);
const { urlMcpRpcUrl } = getSiteUrlConfig(import.meta.env);
const { accountUserUrl } = getAccountPortalUrls(import.meta.env);
---

<Layout
	title="MCP OAuth Client ID — AADM"
	description="Copy the shared Clerk OAuth Client ID for Claude Code and claude.ai Connectors."
	headerActiveNav="mcp"
>
	<main id="main" class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
		<h1 class="font-display text-2xl font-bold text-white sm:text-3xl">MCP OAuth Client ID</h1>
		<p class="mt-3 text-sm leading-relaxed text-slate-400">
			Shared <code class="font-mono-cta text-xs">client_id</code> for every AADM account — paste into Claude Code or claude.ai
			Advanced connector settings. For Cursor and curl, create an <code class="font-mono-cta text-xs">ak_…</code> API key on{' '}
			<a href={accountUserUrl} class="text-accent-violet underline hover:text-accent-blue">Account Portal</a> instead — not OAuth.
		</p>

		<div class="mt-8">
			<McpOAuthClientIdCard clientId={clientId} mcpRpcUrl={urlMcpRpcUrl} accountUserUrl={accountUserUrl} />
		</div>

		<p class="mt-8 text-sm text-slate-500">
			<a href={accountUserUrl} class="text-accent-violet underline hover:text-accent-blue">Account profile &amp; API keys</a>
			{' · '}
			<a href="/mcp" class="text-accent-violet underline hover:text-accent-blue">MCP setup guide</a>
		</p>
	</main>
</Layout>
