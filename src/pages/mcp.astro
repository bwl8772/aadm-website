---
import Layout from '../layouts/Layout.astro';
import { Show } from '@clerk/astro/components';
import { getAccountPortalUrls } from '../lib/account-portal-urls';
import { getSiteUrlConfig, hostedMcpOrigin } from '../lib/site-urls';

const cfg = getSiteUrlConfig(import.meta.env);
const {
	urlStandard,
	urlMcpMarketing,
	urlMcpCustomerDocs,
	urlMcpEndpoint,
	urlMcpRpcUrl,
	healthUrl,
	discoveryUrl,
	curlInit,
	aadmConfigSchemaUrl,
} = cfg;

const { signInUrl, signUpUrl, accountMcpTokensUrl } = getAccountPortalUrls(import.meta.env);

/** Canonical Streamable HTTP JSON-RPC URL — always includes `/mcp` for production default. */
const mcpRpcUrl = urlMcpRpcUrl;
const mcpOrigin = hostedMcpOrigin(mcpRpcUrl);

const cursorMcpFullConfigSnippet = `{
  "mcpServers": {
    "aadm": {
      "type": "http",
      "url": "${mcpRpcUrl}",
      "headers": {
        "Authorization": "aadm_<your token here>"
      }
    }
  }
}`;

const cursorMcpBearerAkSnippet = `{
  "mcpServers": {
    "aadm": {
      "type": "http",
      "url": "${mcpRpcUrl}",
      "headers": {
        "Authorization": "Bearer ak_<your token here>"
      }
    }
  }
}`;

const cursorMcpJsonSnippet = `    "aadm": {
      "type": "http",
      "url": "${mcpRpcUrl}",
      "headers": {
        "Authorization": "aadm_<your token here>"
      }
    }`;

/** Marketing snapshot — names align with hosted MCP `tools/list`; schema evolves with server version. */
const mcpToolsCatalog: Array<{
	tool: string;
	badges: Array<'Orchestration' | 'Navigator' | 'Investigator' | 'Sentinel' | 'Doctrine'>;
	outcome: string;
}> = [
	{
		tool: 'standard_brief',
		badges: ['Orchestration'],
		outcome:
			'One call loads workflow parity, orchestrator contract, follow-on catalog, and Sentinel assurance JSON hosts branch on.',
	},
	{
		tool: 'route_lane',
		badges: ['Orchestration'],
		outcome:
			'When intent is already delivery, defect, or assurance, return deterministic routing metadata—no keyword roulette.',
	},
	{
		tool: 'orchestrator_anchor',
		badges: ['Orchestration'],
		outcome:
			'Long-running jobs get a stable checklist: what to persist outside MCP, session notes, and when to refresh the brief.',
	},
	{
		tool: 'plan_delivery',
		badges: ['Navigator'],
		outcome: 'Turn a task into UDALI-shaped delivery handoffs with doctrine-backed scope and integrator-ready language.',
	},
	{
		tool: 'map_feature',
		badges: ['Navigator'],
		outcome: 'Seed layer and AUTH-XX hints from a short feature description—explicitly suggestive until your architecture confirms.',
	},
	{
		tool: 'fetch_auth',
		badges: ['Doctrine'],
		outcome: 'Pull the official markdown for a numbered AUTH control so prompts cite governance text, not paraphrase.',
	},
	{
		tool: 'fetch_seam',
		badges: ['Doctrine', 'Sentinel'],
		outcome:
			'Load a SEAM-00–15 handoff archetype—scope for trace/assurance (normalization, dispatch, persistence). Pair with the seam-check worksheet resource.',
	},
	{
		tool: 'role_guide',
		badges: ['Doctrine'],
		outcome: 'Slice UDALI agent doctrine (Unifier, Designer, Adapter, Logician, Integrator) for the role and task you are in.',
	},
	{
		tool: 'debug_defect',
		badges: ['Investigator'],
		outcome:
			'Gated defect machine: Path A recon, Path B only after proof, execution-control appendix, and troubleshooter response gates.',
	},
	{
		tool: 'debug_bundle',
		badges: ['Investigator'],
		outcome: 'Advanced hosts send a full integrated troubleshooter payload when they need the bundled diagnosis shape.',
	},
	{
		tool: 'debug_hint',
		badges: ['Investigator'],
		outcome: 'Lightweight recon-vs-diagnose hint before you commit to a full debug_defect turn.',
	},
	{
		tool: 'classify_bug',
		badges: ['Investigator'],
		outcome: 'Classify ownership and routing early so the right lane—not the loudest symptom—owns the next step.',
	},
	{
		tool: 'triage_bug',
		badges: ['Investigator'],
		outcome: 'Map a rough symptom to suggested AUTH topics and stack band for intake before deeper debugging.',
	},
	{
		tool: 'fix_pack',
		badges: ['Investigator'],
		outcome:
			'After evidence and gates pass, emit an authorized fix prompt pack sized for coding agents—no premature refactor stories.',
	},
	{
		tool: 'audit_interview',
		badges: ['Sentinel'],
		outcome: 'Step through vertical depth and horizontal seams until scope is confirmable; then merge into outline-shaped intake.',
	},
	{
		tool: 'audit_outline',
		badges: ['Sentinel'],
		outcome: 'Produce the assurance scaffold: sections, checklist pointers, coder requests, and human-editable confirmation.',
	},
	{
		tool: 'audit_run',
		badges: ['Sentinel'],
		outcome:
			'Plain-language “run an audit” asks become a program-aware intake plus top-findings brief for a repo-connected agent.',
	},
	{
		tool: 'sentinel_programs',
		badges: ['Sentinel'],
		outcome: 'Snapshot every bundled Sentinel audit program template without pulling the full standard_brief payload.',
	},
	{
		tool: 'sentinel_program',
		badges: ['Sentinel'],
		outcome: 'Fetch one audit program row by id when hosts only need that template’s rigor spine and evidence expectations.',
	},
	{
		tool: 'sentinel_attestation_examples',
		badges: ['Sentinel'],
		outcome: 'Shipped seam-tier examples so teams see how depth and boundaries translate to must-prove vs latent seams.',
	},
	{
		tool: 'sentinel_closure',
		badges: ['Sentinel'],
		outcome: 'Resolve closure tiers from attestation depth, vertical claim, and horizontal seams—deterministic seam language.',
	},
	{
		tool: 'sentinel_stage_guide',
		badges: ['Sentinel'],
		outcome: 'Gate helper for one assurance stage of a chosen program—keeps humans oriented inside the three-stage spine.',
	},
	{
		tool: 'sentinel_handoff_hint',
		badges: ['Sentinel'],
		outcome: 'After a sentinel_audit_exit_kind, get deterministic wording for staying in assurance or opening Navigator or Investigator.',
	},
	{
		tool: 'sentinel_canonical_refs',
		badges: ['Sentinel'],
		outcome: 'Curated resources/read URIs for delivery and assurance lanes so hosts wire doctrine without hunting the catalog.',
	},
];

const toolBadgeClass: Record<
	(typeof mcpToolsCatalog)[number]['badges'][number],
	string
> = {
	Orchestration: 'border-amber-500/35 bg-amber-500/10 text-amber-100',
	Navigator: 'border-violet-500/35 bg-violet-500/10 text-accent-violet',
	Investigator: 'border-blue-500/35 bg-blue-500/10 text-accent-blue',
	Sentinel: 'border-violet-400/30 bg-violet-950/50 text-violet-200',
	Doctrine: 'border-emerald-500/35 bg-emerald-500/10 text-emerald-200',
};
---

<Layout
	title="AADM MCP — Connect to the hosted server"
	description="Connect Cursor, Claude Code, and claude.ai to the hosted AADM MCP at https://mcp.aadm.io/mcp — bearer token or OAuth Client ID."
	headerActiveNav="mcp"
	headerMcpNavHref="/mcp#mcp-hero-heading"
	footerVariant="mcp"
>
	<main id="main">
		<!-- Hero -->
		<section
			class="relative mx-auto max-w-6xl px-4 pb-10 pt-12 sm:px-6 sm:pb-14 sm:pt-16"
			aria-labelledby="mcp-hero-heading"
		>
			<div class="max-w-3xl">
				<p class="mb-4 text-xs font-bold uppercase tracking-wider text-accent-violet">Hosted MCP</p>
				<h1
					id="mcp-hero-heading"
					class="scroll-mt-24 font-display text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:scroll-mt-28 sm:text-5xl"
				>
					Connect to the
					<span class="bg-gradient-to-r from-accent-violet to-accent-blue bg-clip-text text-transparent">AADM MCP</span>
				</h1>
				<p class="mt-5 text-lg leading-relaxed text-slate-400">
					Point your MCP host at the subscriber service, authenticate with <strong class="text-slate-300">one</strong> method
					below, and reload. The MCP does not scan your repo—your apps and CI still prove enforcement.
				</p>
				<div class="mt-6 flex flex-wrap gap-3">
					<Show when="signed-out">
						<a
							id="get-access"
							href={signUpUrl}
							class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-violet-600 to-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:brightness-110"
						>
							Get access
						</a>
						<a
							href={signInUrl}
							class="inline-flex items-center justify-center rounded-xl border border-border-subtle px-5 py-3 text-sm font-semibold text-white hover:bg-surface-mid"
						>
							Sign in to AADM
						</a>
					</Show>
					<Show when="signed-in">
						<a
							id="get-access"
							href={accountMcpTokensUrl}
							class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-violet-600 to-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:brightness-110"
						>
							MCP tokens &amp; OAuth Client ID
						</a>
					</Show>
					<a href="#two-ways" class="text-sm font-semibold text-accent-violet underline underline-offset-4 hover:text-accent-blue">
						Jump to connection steps →
					</a>
				</div>
			</div>
		</section>

		<!-- Endpoint -->
		<section class="border-y border-border-subtle bg-surface-mid/50 py-10" aria-labelledby="mcp-endpoint-heading">
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<h2 id="mcp-endpoint-heading" class="font-display text-lg font-bold text-white">MCP server URL</h2>
				<p class="mt-2 max-w-3xl text-sm text-slate-400">
					Use this <strong class="text-slate-300">exact</strong> URL in every client — include the <code class="font-mono-cta text-slate-300">/mcp</code> path.
				</p>
				<div class="mt-4 flex flex-wrap items-center gap-3">
					<code class="font-mono-cta break-all rounded-xl border border-violet-500/40 bg-surface-card px-4 py-3 text-sm font-semibold text-accent-blue">
						{mcpRpcUrl}
					</code>
					<button
						type="button"
						id="mcp-url-copy-btn"
						data-url={mcpRpcUrl}
						class="rounded-lg bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-violet-500"
					>
						Copy URL
					</button>
				</div>
				<p class="mt-3 text-xs text-slate-500">
					Discovery: <a href={discoveryUrl} class="text-accent-violet underline hover:text-accent-blue">{mcpOrigin}/</a>
					· Health: <a href={healthUrl} class="text-accent-violet underline hover:text-accent-blue">{mcpOrigin}/health</a>
				</p>
			</div>
		</section>

		<!-- Two ways -->
		<section
			id="two-ways"
			class="scroll-mt-24 mx-auto max-w-6xl px-4 py-14 sm:scroll-mt-28 sm:px-6"
			aria-labelledby="two-ways-heading"
		>
			<h2 id="two-ways-heading" class="font-display text-2xl font-bold text-white sm:text-3xl">Two ways to connect</h2>
			<p class="mt-3 max-w-3xl text-slate-400">
				Pick <strong class="text-slate-300">one</strong> method per client. Do not paste an <code class="font-mono-cta text-slate-400">aadm_</code> token
				and an OAuth Client ID together — they are different auth paths.
			</p>
			<div class="mt-8 grid gap-4 sm:grid-cols-2">
				<a
					href="#connect-bearer"
					class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 transition hover:border-violet-500/40"
				>
					<p class="text-xs font-bold uppercase tracking-wider text-accent-blue">1 · Bearer token</p>
					<h3 class="font-display mt-2 text-lg font-bold text-white">Standard header token</h3>
					<p class="mt-2 text-sm text-slate-400">Cursor, Windsurf, curl — <code class="font-mono-cta text-xs">aadm_…</code> dashboard token or <code class="font-mono-cta text-xs">Bearer ak_…</code> account API key</p>
				</a>
				<a
					href="#connect-oauth"
					class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 transition hover:border-violet-500/40"
				>
					<p class="text-xs font-bold uppercase tracking-wider text-accent-violet">2 · OAuth</p>
					<h3 class="font-display mt-2 text-lg font-bold text-white">OAuth Client ID</h3>
					<p class="mt-2 text-sm text-slate-400">Claude Code, claude.ai Connectors — OAuth login + public Client ID (no secret)</p>
				</a>
			</div>
		</section>

		<!-- Bearer / token -->
		<section
			id="connect-bearer"
			class="scroll-mt-24 border-y border-border-subtle bg-surface-mid/40 py-14 sm:scroll-mt-28 sm:py-16"
			aria-labelledby="connect-bearer-heading"
		>
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<p class="text-xs font-bold uppercase tracking-wider text-accent-blue">Method 1</p>
				<h2 id="connect-bearer-heading" class="font-display mt-2 text-2xl font-bold text-white sm:text-3xl">
					Bearer / header token
				</h2>
				<p class="mt-3 max-w-3xl text-sm text-slate-400">
					Mint a token from your <a href={accountMcpTokensUrl} class="font-semibold text-accent-violet underline hover:text-accent-blue">AADM account dashboard</a>
					(<code class="font-mono-cta text-slate-400">aadm_…</code>) or use an account API key (<code class="font-mono-cta text-slate-400">ak_…</code>) from
					<strong class="text-slate-300">Account → API keys</strong> in your AADM account after you sign in at aadm.io.
					<strong class="text-slate-300">Not</strong> for claude.ai web Connectors — they require OAuth below.
				</p>

				<div class="mt-8 grid gap-6 lg:grid-cols-2">
					<div class="rounded-2xl border border-border-subtle bg-surface-card/90 p-5">
						<h3 class="font-display text-base font-bold text-white">AADM dashboard token</h3>
						<p class="mt-2 text-sm text-slate-400">Full secret as the header value — <strong class="text-slate-300">no</strong> <code class="font-mono-cta text-xs">Bearer</code> prefix.</p>
						<pre class="mt-4 overflow-x-auto rounded-xl border border-border-subtle bg-[#0a0d14] p-3 font-mono-cta text-xs text-slate-300"><code>Authorization: aadm_&lt;your token here&gt;</code></pre>
					</div>
					<div class="rounded-2xl border border-border-subtle bg-surface-card/90 p-5">
						<h3 class="font-display text-base font-bold text-white">AADM account API key</h3>
						<p class="mt-2 text-sm text-slate-400">Use <code class="font-mono-cta text-xs">Bearer</code> + full <code class="font-mono-cta text-xs">ak_…</code> key from your AADM account (<strong class="text-slate-300">API keys</strong>).</p>
						<pre class="mt-4 overflow-x-auto rounded-xl border border-border-subtle bg-[#0a0d14] p-3 font-mono-cta text-xs text-slate-300"><code>Authorization: Bearer ak_&lt;your token here&gt;</code></pre>
					</div>
				</div>

				<div class="mt-10">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<h3 class="font-display text-base font-bold text-white">Cursor — <code class="font-mono-cta text-sm font-normal text-slate-400">~/.cursor/mcp.json</code></h3>
						<button type="button" id="mcp-connect-copy-btn" class="rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500">Copy JSON</button>
					</div>
					<pre class="mt-3 overflow-x-auto rounded-2xl border border-border-subtle bg-[#0a0d14] p-4 font-mono-cta text-xs text-slate-300 sm:text-sm" id="mcp-connect-config-pre"><code id="mcp-connect-config-code">{cursorMcpFullConfigSnippet}</code></pre>
					<p class="mt-3 text-xs text-slate-500">
						<code class="font-mono-cta text-slate-400">url</code> must be <code class="font-mono-cta text-accent-violet">{mcpRpcUrl}</code>.
						For <code class="font-mono-cta text-slate-400">ak_</code> account API keys, use Bearer form:
					</p>
					<pre class="mt-2 overflow-x-auto rounded-xl border border-border-subtle bg-surface-card/60 p-3 font-mono-cta text-xs text-slate-400"><code>{cursorMcpBearerAkSnippet}</code></pre>
					<ol class="mt-6 list-decimal space-y-2 pl-5 text-sm text-slate-300">
						<li>Subscribe and create a token in your <a href={accountMcpTokensUrl} class="text-accent-violet underline">AADM account dashboard</a>.</li>
						<li>Paste into <code class="font-mono-cta text-slate-400">Authorization</code> in <code class="font-mono-cta text-slate-400">mcp.json</code>.</li>
						<li>Reload Cursor (or restart MCP) so <code class="font-mono-cta text-slate-400">tools/list</code> refreshes.</li>
					</ol>
				</div>
			</div>
		</section>

		<!-- OAuth -->
		<section
			id="connect-oauth"
			class="scroll-mt-24 mx-auto max-w-6xl px-4 py-14 sm:scroll-mt-28 sm:px-6"
			aria-labelledby="connect-oauth-heading"
		>
			<p class="text-xs font-bold uppercase tracking-wider text-accent-violet">Method 2</p>
			<h2 id="connect-oauth-heading" class="font-display mt-2 text-2xl font-bold text-white sm:text-3xl">OAuth (Claude Code, claude.ai)</h2>

			<div class="mt-6 rounded-2xl border-2 border-amber-500/50 bg-amber-950/30 p-5">
				<p class="text-sm font-semibold text-amber-100">Do not use your <code class="font-mono-cta text-xs">aadm_</code> token here</p>
				<p class="mt-2 text-sm text-amber-100/90">
					OAuth clients use the <strong>OAuth Client ID</strong> below plus a browser login. There is <strong>no Client Secret</strong> for standard setups.
					Do not paste dashboard tokens into OAuth or Advanced connector fields.
				</p>
			</div>

			<div class="mt-8 rounded-2xl border border-violet-500/35 bg-surface-card/90 p-6">
				<h3 class="font-display text-lg font-bold text-white">OAuth Client ID</h3>
				<p class="mt-2 text-sm text-slate-400">
					Not published on this public page. After you subscribe at <strong class="text-slate-300">aadm.io</strong>, copy it from your account dashboard.
				</p>
				<code class="mt-4 block rounded-xl border border-border-subtle bg-surface-mid px-4 py-3 font-mono-cta text-sm text-slate-400">
					OAuth Client ID = &lt;retrieved after login&gt;
				</code>
				<div class="mt-4 flex flex-wrap gap-3">
					<Show when="signed-out">
						<a
							href={signInUrl}
							class="inline-flex rounded-xl bg-gradient-to-r from-violet-600 to-blue-600 px-5 py-2.5 text-sm font-semibold text-white"
						>
							Sign in at aadm.io to retrieve Client ID
						</a>
					</Show>
					<Show when="signed-in">
						<a
							href={accountMcpTokensUrl}
							class="inline-flex rounded-xl bg-gradient-to-r from-violet-600 to-blue-600 px-5 py-2.5 text-sm font-semibold text-white"
						>
							Open your AADM dashboard — copy Client ID
						</a>
					</Show>
				</div>
			</div>

			<div class="mt-8 grid gap-6 lg:grid-cols-2">
				<div class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6">
					<h3 class="font-display text-base font-bold text-white">Claude Code</h3>
					<ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-slate-400">
						<li>Add MCP server URL: <code class="font-mono-cta text-xs text-accent-violet">{mcpRpcUrl}</code></li>
						<li>Choose <strong class="text-slate-300">OAuth</strong> (not pasted API key).</li>
						<li>Paste <strong class="text-slate-300">OAuth Client ID</strong> from your <a href={accountMcpTokensUrl} class="text-accent-violet underline">account dashboard</a> when asked.</li>
						<li>Leave <strong class="text-slate-300">Client Secret</strong> empty.</li>
						<li>Sign in with the <strong class="text-slate-300">same AADM account</strong> you used to subscribe when the OAuth consent screen appears.</li>
					</ol>
				</div>
				<div class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6">
					<h3 class="font-display text-base font-bold text-white">claude.ai Connectors</h3>
					<ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-slate-400">
						<li><em>Settings → Connectors → Add custom connector</em></li>
						<li>Server URL: <code class="font-mono-cta text-xs text-accent-violet">{mcpRpcUrl}</code></li>
						<li>Authentication: <strong class="text-slate-300">OAuth</strong></li>
						<li><strong class="text-slate-300">Advanced</strong> → paste OAuth Client ID from <a href={accountMcpTokensUrl} class="text-accent-violet underline">your AADM dashboard</a> (paste manually — auto-registration is not supported)</li>
						<li>Leave Client Secret empty · click Connect and sign in</li>
					</ol>
				</div>
			</div>
		</section>

		<!-- Optional repo config -->
		<section
			id="repo-config"
			class="scroll-mt-24 border-y border-border-subtle bg-surface-mid/30 py-14 sm:scroll-mt-28 sm:py-16"
			aria-labelledby="repo-config-heading"
		>
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<p class="text-xs font-bold uppercase tracking-wider text-emerald-400/90">Optional</p>
				<h2 id="repo-config-heading" class="font-display mt-2 text-2xl font-bold text-white sm:text-3xl">
					Repo governance config (<code class="font-mono-cta text-xl text-slate-300">aadm-init-repo</code>)
				</h2>
				<p class="mt-3 max-w-3xl text-sm text-slate-400">
					You <strong class="text-slate-300">do not</strong> need this to connect the hosted MCP. Use it when you want
					<code class="font-mono-cta text-slate-300">.aadm/config.json</code> in an application repo (UDALI paths, lanes, CI stubs).
					Tokens stay in your IDE — never commit secrets into the config file.
				</p>
				<pre class="mt-6 max-w-xl overflow-x-auto rounded-2xl border border-border-subtle bg-[#0a0d14] p-4 font-mono-cta text-sm text-slate-300"><code>npx aadm-init-repo --minimal
npx aadm-init-repo --full</code></pre>
				<p class="mt-4 text-sm text-slate-500">
					<a href="/governance" class="font-semibold text-accent-violet underline hover:text-accent-blue">Customize on /governance</a>
					·{' '}
					<a href={aadmConfigSchemaUrl} class="font-semibold text-accent-violet underline hover:text-accent-blue" target="_blank" rel="noopener noreferrer">Config JSON Schema</a>
					·{' '}
