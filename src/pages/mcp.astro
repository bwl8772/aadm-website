---
import Layout from '../layouts/Layout.astro';
import { Show } from '@clerk/astro/components';
import { getClerkPortalUrls } from '../lib/clerk-portal-urls';
import { getSiteUrlConfig, hostedMcpOrigin, maskPublicMcpOAuthClientId } from '../lib/site-urls';

const cfg = getSiteUrlConfig(import.meta.env);
const {
	urlStandard,
	urlMcpMarketing,
	urlMcpCustomerDocs,
	urlMcpEndpoint,
	healthUrl,
	discoveryUrl,
	curlInit,
	publicMcpOAuthClientId,
} = cfg;

const { signInUrl, signUpUrl, accountUserUrl } = getClerkPortalUrls(import.meta.env);

/** Cursor `mcp.json` uses MCP service origin + trailing slash (no `/mcp` path segment). */
const cursorMcpHttpUrl = hostedMcpOrigin(urlMcpEndpoint || 'https://mcp.aadm.io');
const cursorMcpConfigUrl = `${cursorMcpHttpUrl}/`;

const cursorMcpFullConfigSnippet = `{
  "mcpServers": {
    "aadm": {
      "type": "http",
      "url": "${cursorMcpConfigUrl}",
      "headers": {
        "Authorization": "<your token here>"
      }
    }
  }
}`;

const cursorMcpJsonSnippet = `    "aadm": {
      "type": "http",
      "url": "${cursorMcpConfigUrl}",
      "headers": {
        "Authorization": "<your token here>"
      }
    }`;

/** Marketing snapshot — names align with hosted MCP `tools/list`; schema evolves with server version. */
const mcpToolsCatalog: Array<{
	tool: string;
	badges: Array<'Orchestration' | 'Navigator' | 'Investigator' | 'Sentinel' | 'Doctrine'>;
	outcome: string;
}> = [
	{
		tool: 'standard_brief',
		badges: ['Orchestration'],
		outcome:
			'One call loads workflow parity, orchestrator contract, follow-on catalog, and Sentinel assurance JSON hosts branch on.',
	},
	{
		tool: 'route_lane',
		badges: ['Orchestration'],
		outcome:
			'When intent is already delivery, defect, or assurance, return deterministic routing metadata—no keyword roulette.',
	},
	{
		tool: 'orchestrator_anchor',
		badges: ['Orchestration'],
		outcome:
			'Long-running jobs get a stable checklist: what to persist outside MCP, session notes, and when to refresh the brief.',
	},
	{
		tool: 'plan_delivery',
		badges: ['Navigator'],
		outcome: 'Turn a task into UDALI-shaped delivery handoffs with doctrine-backed scope and integrator-ready language.',
	},
	{
		tool: 'map_feature',
		badges: ['Navigator'],
		outcome: 'Seed layer and AUTH-XX hints from a short feature description—explicitly suggestive until your architecture confirms.',
	},
	{
		tool: 'fetch_auth',
		badges: ['Doctrine'],
		outcome: 'Pull the official markdown for a numbered AUTH control so prompts cite governance text, not paraphrase.',
	},
	{
		tool: 'fetch_seam',
		badges: ['Doctrine', 'Sentinel'],
		outcome:
			'Load a SEAM-00–15 handoff archetype—scope for trace/assurance (normalization, dispatch, persistence). Pair with the seam-check worksheet resource.',
	},
	{
		tool: 'role_guide',
		badges: ['Doctrine'],
		outcome: 'Slice UDALI agent doctrine (Unifier, Designer, Adapter, Logician, Integrator) for the role and task you are in.',
	},
	{
		tool: 'debug_defect',
		badges: ['Investigator'],
		outcome:
			'Gated defect machine: Path A recon, Path B only after proof, execution-control appendix, and troubleshooter response gates.',
	},
	{
		tool: 'debug_bundle',
		badges: ['Investigator'],
		outcome: 'Advanced hosts send a full integrated troubleshooter payload when they need the bundled diagnosis shape.',
	},
	{
		tool: 'debug_hint',
		badges: ['Investigator'],
		outcome: 'Lightweight recon-vs-diagnose hint before you commit to a full debug_defect turn.',
	},
	{
		tool: 'classify_bug',
		badges: ['Investigator'],
		outcome: 'Classify ownership and routing early so the right lane—not the loudest symptom—owns the next step.',
	},
	{
		tool: 'triage_bug',
		badges: ['Investigator'],
		outcome: 'Map a rough symptom to suggested AUTH topics and stack band for intake before deeper debugging.',
	},
	{
		tool: 'fix_pack',
		badges: ['Investigator'],
		outcome:
			'After evidence and gates pass, emit an authorized fix prompt pack sized for coding agents—no premature refactor stories.',
	},
	{
		tool: 'audit_interview',
		badges: ['Sentinel'],
		outcome: 'Step through vertical depth and horizontal seams until scope is confirmable; then merge into outline-shaped intake.',
	},
	{
		tool: 'audit_outline',
		badges: ['Sentinel'],
		outcome: 'Produce the assurance scaffold: sections, checklist pointers, coder requests, and human-editable confirmation.',
	},
	{
		tool: 'audit_run',
		badges: ['Sentinel'],
		outcome:
			'Plain-language “run an audit” asks become a program-aware intake plus top-findings brief for a repo-connected agent.',
	},
	{
		tool: 'sentinel_programs',
		badges: ['Sentinel'],
		outcome: 'Snapshot every bundled Sentinel audit program template without pulling the full standard_brief payload.',
	},
	{
		tool: 'sentinel_program',
		badges: ['Sentinel'],
		outcome: 'Fetch one audit program row by id when hosts only need that template’s rigor spine and evidence expectations.',
	},
	{
		tool: 'sentinel_attestation_examples',
		badges: ['Sentinel'],
		outcome: 'Shipped seam-tier examples so teams see how depth and boundaries translate to must-prove vs latent seams.',
	},
	{
		tool: 'sentinel_closure',
		badges: ['Sentinel'],
		outcome: 'Resolve closure tiers from attestation depth, vertical claim, and horizontal seams—deterministic seam language.',
	},
	{
		tool: 'sentinel_stage_guide',
		badges: ['Sentinel'],
		outcome: 'Gate helper for one assurance stage of a chosen program—keeps humans oriented inside the three-stage spine.',
	},
	{
		tool: 'sentinel_handoff_hint',
		badges: ['Sentinel'],
		outcome: 'After a sentinel_audit_exit_kind, get deterministic wording for staying in assurance or opening Navigator or Investigator.',
	},
	{
		tool: 'sentinel_canonical_refs',
		badges: ['Sentinel'],
		outcome: 'Curated resources/read URIs for delivery and assurance lanes so hosts wire doctrine without hunting the catalog.',
	},
];

const toolBadgeClass: Record<
	(typeof mcpToolsCatalog)[number]['badges'][number],
	string
> = {
	Orchestration: 'border-amber-500/35 bg-amber-500/10 text-amber-100',
	Navigator: 'border-violet-500/35 bg-violet-500/10 text-accent-violet',
	Investigator: 'border-blue-500/35 bg-blue-500/10 text-accent-blue',
	Sentinel: 'border-violet-400/30 bg-violet-950/50 text-violet-200',
	Doctrine: 'border-emerald-500/35 bg-emerald-500/10 text-emerald-200',
};
---

<Layout
	title="AADM MCP — What you can do with subscriber access"
	description="Versioned AADM tools and resources for coding agents: Navigator delivery, Investigator defects, Sentinel assurance. Paid MCP access on Streamable HTTP."
	headerActiveNav="mcp"
	headerMcpNavHref="/mcp#mcp-hero-heading"
	footerVariant="mcp"
>
	<main id="main">
		{
			publicMcpOAuthClientId ? (
				<section
					class="mx-auto max-w-6xl px-4 pb-6 pt-8 sm:px-6 sm:pb-8 sm:pt-10"
					aria-labelledby="mcp-oauth-client-id-heading"
				>
					<div class="rounded-2xl border border-violet-500/35 bg-surface-card/90 p-5 shadow-lg shadow-violet-950/20 sm:p-6">
						<h2
							id="mcp-oauth-client-id-heading"
							class="font-display text-lg font-bold text-white sm:text-xl"
						>
							MCP OAuth Client ID
						</h2>
						<p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-400">
							Paste this Client ID into your MCP host’s OAuth settings (e.g. Claude Connector <strong
								class="text-slate-300">Advanced</strong
							>). It must match the hosted MCP server’s{' '}
							<code class="font-mono-cta text-slate-300">CLERK_OAUTH_CLIENT_ID</code>. Copy copies the full value;
							only the first five characters are shown here.
						</p>
						<div class="mt-4 flex flex-wrap items-center gap-3">
							<code
								class="font-mono-cta min-w-0 flex-1 break-all rounded-xl border border-border-subtle bg-surface-mid px-4 py-3 text-sm text-slate-200"
							>
								{maskPublicMcpOAuthClientId(publicMcpOAuthClientId)}
							</code>
							<button
								type="button"
								id="mcp-oauth-client-id-copy-btn"
								data-full={publicMcpOAuthClientId}
								class="shrink-0 rounded-xl bg-gradient-to-r from-violet-600 to-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-md shadow-violet-950/40 transition hover:brightness-110"
							>
								Copy
							</button>
						</div>
					</div>
					<script is:inline>
						document.getElementById('mcp-oauth-client-id-copy-btn')?.addEventListener('click', function () {
							const el = document.getElementById('mcp-oauth-client-id-copy-btn');
							const t = el?.getAttribute('data-full');
							if (t) navigator.clipboard.writeText(t);
						});
					</script>
				</section>
			) : null
		}
		<!-- 1 Hero -->
		<section
			class="relative mx-auto max-w-6xl px-4 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-16 lg:pt-20"
			aria-labelledby="mcp-hero-heading"
		>
			<div class="grid items-center gap-12 lg:grid-cols-[1fr_minmax(0,420px)]">
				<div>
					<p
						class="mb-4 inline-flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-wider text-slate-400"
					>
						<span
							class="rounded-full border border-border-subtle bg-surface-card/60 px-3 py-1 text-accent-violet"
							>Subscriber MCP</span
						>
						<span class="rounded-full border border-border-subtle bg-surface-card/60 px-3 py-1 text-accent-blue"
							>Agents & teams</span
						>
					</p>
					<h1
						id="mcp-hero-heading"
						class="scroll-mt-24 font-display text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:scroll-mt-28 sm:text-5xl lg:text-6xl"
					>
						What you can do with the
						<span class="bg-gradient-to-r from-accent-violet to-accent-blue bg-clip-text text-transparent">
							AADM MCP
						</span>
					</h1>
					<p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-400">
						Give Cursor, Claude Code, and other MCP hosts the same governed context your organization expects:
						AUTH slices, UDALI doctrine, workflow discipline, and troubleshooting rails—without open-sourcing the
						server implementation.
					</p>
					<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
						<Show when="signed-out">
							<a
								id="get-access"
								href={signUpUrl}
								class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-violet-600 via-violet-600 to-blue-600 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-violet-950/40 transition hover:brightness-110"
							>
								Get access
							</a>
							<a
								href={signInUrl}
								class="inline-flex items-center justify-center rounded-xl border border-border-subtle bg-surface-card px-6 py-3.5 text-base font-semibold text-white transition hover:border-slate-500/40 hover:bg-surface-mid"
							>
								Sign in
							</a>
						</Show>
						<Show when="signed-in">
							<a
								id="get-access"
								href={accountUserUrl}
								class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-violet-600 via-violet-600 to-blue-600 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-violet-950/40 transition hover:brightness-110"
							>
								Manage account
							</a>
						</Show>
						<a
							href={urlStandard}
							class="inline-flex items-center justify-center text-sm font-semibold text-accent-violet underline decoration-accent-violet/40 underline-offset-4 hover:text-accent-blue"
						>
							View the Standard (free, public)
						</a>
					</div>
					<p class="mt-4 text-sm text-slate-500">
						The MCP does not enforce production AUTH in your apps—your gateways, tests, and CI remain authoritative.
					</p>
				</div>
				<div
					class="relative aspect-[4/3] w-full overflow-hidden rounded-3xl border border-border-subtle bg-surface-card/60 shadow-2xl shadow-violet-950/30"
					aria-hidden="true"
				>
					<div
						class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,rgba(157,123,245,0.35),transparent_55%),radial-gradient(ellipse_at_80%_60%,rgba(79,140,255,0.25),transparent_50%)]"
					>
					</div>
					<svg
						class="absolute inset-4 h-[calc(100%-2rem)] w-[calc(100%-2rem)] opacity-90"
						viewBox="0 0 400 300"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
					>
						<rect x="24" y="32" width="352" height="56" rx="12" stroke="rgba(148,163,184,0.25)" stroke-width="1.5" />
						<circle cx="48" cy="60" r="6" fill="#22c55e" opacity="0.9" />
						<text x="68" y="64" fill="#94a3b8" font-family="JetBrains Mono, monospace" font-size="11">Streamable HTTP · MCP session</text>
						<rect x="24" y="104" width="200" height="72" rx="10" fill="rgba(15,20,36,0.9)" stroke="rgba(157,123,245,0.35)" />
						<text x="40" y="132" fill="#9d7bf5" font-family="JetBrains Mono, monospace" font-size="10">tools/list</text>
						<text x="40" y="154" fill="#64748b" font-family="JetBrains Mono, monospace" font-size="9">resources/read · AUTH-…</text>
						<rect x="240" y="104" width="136" height="140" rx="10" fill="rgba(15,20,36,0.85)" stroke="rgba(79,140,255,0.35)" />
						<text x="256" y="132" fill="#4f8cff" font-family="JetBrains Mono, monospace" font-size="10">standard_brief</text>
						<text x="256" y="156" fill="#94a3b8" font-family="Plus Jakarta Sans, sans-serif" font-size="9">workflows · routing</text>
						<text x="256" y="180" fill="#64748b" font-family="JetBrains Mono, monospace" font-size="8">navigator · investigator</text>
						<text x="256" y="200" fill="#64748b" font-family="JetBrains Mono, monospace" font-size="8">sentinel</text>
						<path d="M224 140 L240 140" stroke="rgba(148,163,184,0.3)" stroke-width="2" stroke-dasharray="4 4" />
					</svg>
				</div>
			</div>
		</section>

		<!-- Bootstrap repo governance (CLI — not the MCP server) -->
		<section
			id="bootstrap-repo"
			class="scroll-mt-24 mx-auto max-w-6xl px-4 py-16 sm:scroll-mt-28 sm:px-6 sm:py-20"
			aria-labelledby="bootstrap-repo-heading"
		>
			<p class="text-xs font-bold uppercase tracking-wider text-emerald-400/90">Step 0 · Any repo</p>
			<h2 id="bootstrap-repo-heading" class="font-display mt-2 text-2xl font-bold text-white sm:text-3xl">
				Bootstrap <code class="font-mono-cta text-xl text-slate-200">.aadm/config.json</code>
			</h2>
			<p class="mt-4 max-w-3xl text-slate-400">
				Before you wire MCP in an IDE, scaffold governance in <strong class="text-slate-300">your application repo</strong>.
				The npm package <code class="font-mono-cta text-slate-300">aadm-init-repo</code> is
				<strong class="text-slate-300">CLI only</strong> (~14 KB)—it does
				<strong class="text-slate-300">not</strong> include the hosted MCP server, doctrine bundle, or tools.
			</p>
			<pre
				class="mt-6 max-w-2xl overflow-x-auto rounded-2xl border border-border-subtle bg-[#0a0d14] p-4 font-mono-cta text-sm leading-relaxed text-slate-300 shadow-inner"
				aria-label="Bootstrap command"
			><code>npx aadm-init-repo --minimal
npx aadm-init-repo --full</code></pre>
			<p class="mt-3 text-sm text-slate-500">
				<a
					href="/governance"
					class="font-semibold text-accent-violet underline decoration-accent-violet/40 underline-offset-2 hover:text-accent-blue"
				>/governance</a>
				· Package:{' '}
				<a
					href="https://www.npmjs.com/package/aadm-init-repo"
					class="font-semibold text-accent-violet underline decoration-accent-violet/40 underline-offset-2 hover:text-accent-blue"
					rel="noopener noreferrer"
					target="_blank"
				>
					npmjs.com/package/aadm-init-repo
				</a>
				· Node 22+
			</p>

			<div class="mt-10 grid gap-6 lg:grid-cols-2">
				<div class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6">
					<h3 class="font-display text-lg font-bold text-accent-blue">--minimal</h3>
					<p class="mt-2 text-sm text-slate-400">Fast start (~35 lines): MCP endpoint, UDALI path patterns, delivery + defect lanes.</p>
					<ul class="mt-4 space-y-2 text-sm text-slate-400">
						<li class="flex gap-2">
							<span class="text-accent-blue">·</span>
							<span>Good for spikes and single-team services</span>
						</li>
						<li class="flex gap-2">
							<span class="text-accent-blue">·</span>
							<span>No team ownership, AUTH rules, or tool-routing blocks yet</span>
						</li>
					</ul>
				</div>
				<div class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6">
					<h3 class="font-display text-lg font-bold text-accent-violet">--full</h3>
					<p class="mt-2 text-sm text-slate-400">
						Production-shaped template (~280 lines): teams, AUTH/SEAM ownership, assurance lane, enforcement gates,
						attestation, tool routing, Cursor/Claude/CI blocks.
					</p>
					<ul class="mt-4 space-y-2 text-sm text-slate-400">
						<li class="flex gap-2">
							<span class="text-accent-violet">·</span>
							<span>All three lanes including Sentinel (<code class="font-mono-cta text-xs">assurance</code>)</span>
						</li>
						<li class="flex gap-2">
							<span class="text-accent-violet">·</span>
							<span>Edit placeholders—then connect MCP below</span>
						</li>
					</ul>
				</div>
			</div>

			<div class="mt-10 rounded-2xl border border-border-subtle bg-surface-mid/40 p-6">
				<h3 class="font-display text-base font-bold text-white">What it writes (same for both flags)</h3>
				<ul class="mt-4 grid gap-2 text-sm text-slate-400 sm:grid-cols-2">
					<li>
						<code class="font-mono-cta text-slate-300">.aadm/config.json</code> — validated against AADM Config v1.0
					</li>
					<li>
						<code class="font-mono-cta text-slate-300">.claude/hooks/session-start.sh</code>
					</li>
					<li>
						<code class="font-mono-cta text-slate-300">.husky/pre-commit.aadm.sh</code> — JSON syntax check
					</li>
					<li>
						<code class="font-mono-cta text-slate-300">.github/workflows/aadm-pre-merge.yml</code> — CI stub (wire MCP later)
					</li>
				</ul>
				<p class="mt-4 text-sm text-slate-500">
					Re-run with <code class="font-mono-cta text-slate-400">--force</code> to overwrite an existing config. Auth in templates
					uses <code class="font-mono-cta text-emerald-300/90">${'${AADM_TOKEN}'}</code>—never commit real keys.
				</p>
			</div>

			<p class="mt-8 flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-400">
				<a
					href="/governance"
					class="font-semibold text-accent-violet underline decoration-accent-violet/40 underline-offset-4 hover:text-accent-blue"
				>
					Customize config (don’t ship defaults) →
				</a>
				<a
					href="#connect-cursor"
					class="font-semibold text-slate-300 underline decoration-slate-600 underline-offset-4 hover:text-white"
				>
					Connect MCP in Cursor →
				</a>
			</p>
		</section>

		<!-- Connect with Cursor — first scroll below hero -->
		<section
			id="connect-cursor"
			class="scroll-mt-24 border-y border-border-subtle bg-surface-mid/50 py-14 sm:scroll-mt-28 sm:py-16"
			aria-labelledby="connect-cursor-heading"
		>
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
					<div class="max-w-xl shrink-0">
						<p class="text-xs font-bold uppercase tracking-wider text-accent-violet">Cursor · MCP</p>
						<h2 id="connect-cursor-heading" class="font-display mt-2 text-2xl font-bold text-white sm:text-3xl">
							Connect with Cursor
						</h2>
						<p class="mt-3 text-slate-400">
							<a
								href="#bootstrap-repo"
								class="font-semibold text-accent-violet underline decoration-accent-violet/40 underline-offset-2 hover:text-accent-blue"
							>
								Bootstrap your repo
							</a>
							first with <code class="font-mono-cta text-slate-300">npx aadm-init-repo --full</code>, then subscribe, mint an MCP token,
							paste into <code class="font-mono-cta text-slate-300">~/.cursor/mcp.json</code>, and reload Cursor so{' '}
							<code class="font-mono-cta text-slate-300">tools/list</code> picks up AADM.
						</p>
						<ol class="mt-6 list-decimal space-y-3 pl-5 text-sm text-slate-300">
							<li>
								<Show when="signed-out">
									<span>
										<a
											href={signUpUrl}
											class="inline font-semibold text-accent-violet underline decoration-accent-violet/40 underline-offset-4 hover:text-accent-blue"
										>
											Sign up
										</a>
										{' '}
										or{' '}
										<a
											href={signInUrl}
											class="inline font-semibold text-accent-violet underline decoration-accent-violet/40 underline-offset-4 hover:text-accent-blue"
										>
											sign in
										</a>
										— complete subscription if you have not already.
									</span>
								</Show>
								<Show when="signed-in">
									<span>
										<a
											href={accountUserUrl}
											class="font-semibold text-accent-violet underline decoration-accent-violet/40 underline-offset-4 hover:text-accent-blue"
										>
											Open your account
										</a>
										— confirm subscription is active.
									</span>
								</Show>
							</li>
							<li>
								Create or copy an MCP API key (Clerk user keys often look like{' '}
								<code class="font-mono-cta text-slate-400">ak_…</code>).
							</li>
							<li>
								Replace <code class="font-mono-cta text-emerald-300/90">&lt;your token here&gt;</code> in the JSON—use the
