					if (url) navigator.clipboard.writeText(url);
				});
				const btn = document.getElementById('mcp-connect-copy-btn');
				const code = document.getElementById('mcp-connect-config-code');
				if (!btn || !code) return;
				const defaultLabel = btn.textContent || 'Copy JSON';
				btn.addEventListener('click', async function () {
					const text = (code.textContent || '').trim();
					try {
