---
import { Show } from "@clerk/astro/components";
import MemberMcpOAuthLink from "../components/MemberMcpOAuthLink.astro";
import McpOperatorVisual from "../components/visuals/McpOperatorVisual.astro";
import Layout from "../layouts/Layout.astro";
import { getAccountPortalUrls } from "../lib/account-portal-urls";
import {
	gridVisualPlacements,
	gridVisualSlotStyle,
} from "../lib/grid-visual-placements";
import { getSiteUrlConfig, hostedMcpOrigin } from "../lib/site-urls";

const cfg = getSiteUrlConfig(import.meta.env);
const {
	urlStandard,
	urlMcpCustomerDocs,
	urlMcpEndpoint,
	urlMcpRpcUrl,
	healthUrl,
	discoveryUrl,
	curlInit,
	aadmConfigSchemaUrl,
} = cfg;

const {
	signInUrl,
	signUpUrl,
	memberAreaUrl,
	memberMcpOAuthUrl,
	memberSignInUrl,
	memberMcpOAuthSignInUrl,
} = getAccountPortalUrls(import.meta.env);

/** Canonical Streamable HTTP JSON-RPC URL — always includes `/mcp` for production default. */
const mcpRpcUrl = urlMcpRpcUrl;
const mcpOrigin = hostedMcpOrigin(mcpRpcUrl);

let operatorCardCount = 2;
if (healthUrl) operatorCardCount++;
if (discoveryUrl) operatorCardCount++;
if (urlStandard.startsWith("http")) operatorCardCount++;
if (urlMcpCustomerDocs) operatorCardCount++;
const operatorVisuals = gridVisualPlacements(operatorCardCount, 3);

const cursorMcpFullConfigSnippet = `{
  "mcpServers": {
    "aadm": {
      "type": "http",
      "url": "${mcpRpcUrl}",
      "headers": {
        "Authorization": "aadm_<your token here>"
      }
    }
  }
}`;

const cursorMcpBearerAkSnippet = `{
  "mcpServers": {
    "aadm": {
      "type": "http",
      "url": "${mcpRpcUrl}",
      "headers": {
        "Authorization": "Bearer <your token here>"
      }
    }
  }
}`;

/** Marketing snapshot — names align with hosted MCP `tools/list`; schema evolves with server version. */
const mcpToolsCatalog: Array<{
	tool: string;
	badges: Array<
		"Orchestration" | "Navigator" | "Investigator" | "Sentinel" | "Doctrine"
	>;
	outcome: string;
}> = [
	{
		tool: "standard_brief",
		badges: ["Orchestration"],
		outcome:
			"One call loads workflow parity, orchestrator contract, follow-on catalog, and Sentinel assurance JSON hosts branch on.",
	},
	{
		tool: "route_lane",
		badges: ["Orchestration"],
		outcome:
			"When intent is already delivery, defect, or assurance, return deterministic routing metadata—no keyword roulette.",
	},
	{
		tool: "orchestrator_anchor",
		badges: ["Orchestration"],
		outcome:
			"Long-running jobs get a stable checklist: what to persist outside MCP, session notes, and when to refresh the brief.",
	},
	{
		tool: "plan_delivery",
		badges: ["Navigator"],
		outcome:
			"Turn a task into UDALI-shaped delivery handoffs with doctrine-backed scope and integrator-ready language.",
	},
	{
		tool: "map_feature",
		badges: ["Navigator"],
		outcome:
			"Seed layer and AUTH-XX hints from a short feature description—explicitly suggestive until your architecture confirms.",
	},
	{
		tool: "fetch_auth",
		badges: ["Doctrine"],
		outcome:
			"Pull the official markdown for a numbered AUTH control so prompts cite governance text, not paraphrase.",
	},
	{
		tool: "fetch_seam",
		badges: ["Doctrine", "Sentinel"],
		outcome:
			"Load a SEAM-00–15 handoff archetype—scope for trace/assurance (normalization, dispatch, persistence). Pair with the seam-check worksheet resource.",
	},
	{
		tool: "role_guide",
		badges: ["Doctrine"],
		outcome:
			"Slice UDALI agent doctrine (Unifier, Designer, Adapter, Logician, Integrator) for the role and task you are in.",
	},
	{
		tool: "debug_defect",
		badges: ["Investigator"],
		outcome:
			"Gated defect machine: Path A recon, Path B only after proof, execution-control appendix, and troubleshooter response gates.",
	},
	{
		tool: "debug_bundle",
		badges: ["Investigator"],
		outcome:
			"Advanced hosts send a full integrated troubleshooter payload when they need the bundled diagnosis shape.",
	},
	{
		tool: "debug_hint",
		badges: ["Investigator"],
		outcome:
			"Lightweight recon-vs-diagnose hint before you commit to a full debug_defect turn.",
	},
	{
		tool: "classify_bug",
		badges: ["Investigator"],
		outcome:
			"Classify ownership and routing early so the right lane—not the loudest symptom—owns the next step.",
	},
	{
		tool: "triage_bug",
		badges: ["Investigator"],
		outcome:
			"Map a rough symptom to suggested AUTH topics and stack band for intake before deeper debugging.",
	},
	{
		tool: "fix_pack",
		badges: ["Investigator"],
		outcome:
			"After evidence and gates pass, emit an authorized fix prompt pack sized for coding agents—no premature refactor stories.",
	},
	{
		tool: "audit_interview",
		badges: ["Sentinel"],
		outcome:
			"Step through vertical depth and horizontal seams until scope is confirmable; then merge into outline-shaped intake.",
	},
	{
		tool: "audit_outline",
		badges: ["Sentinel"],
		outcome:
			"Produce the assurance scaffold: sections, checklist pointers, coder requests, and human-editable confirmation.",
	},
	{
		tool: "audit_run",
		badges: ["Sentinel"],
		outcome:
			"Plain-language “run an audit” asks become a program-aware intake plus top-findings brief for a repo-connected agent.",
	},
	{
		tool: "sentinel_programs",
		badges: ["Sentinel"],
		outcome:
			"Snapshot every bundled Sentinel audit program template without pulling the full standard_brief payload.",
	},
	{
		tool: "sentinel_program",
		badges: ["Sentinel"],
		outcome:
			"Fetch one audit program row by id when hosts only need that template’s rigor spine and evidence expectations.",
	},
	{
		tool: "sentinel_attestation_examples",
		badges: ["Sentinel"],
		outcome:
			"Shipped seam-tier examples so teams see how depth and boundaries translate to must-prove vs latent seams.",
	},
	{
		tool: "sentinel_closure",
		badges: ["Sentinel"],
		outcome:
			"Resolve closure tiers from attestation depth, vertical claim, and horizontal seams—deterministic seam language.",
	},
	{
		tool: "sentinel_stage_guide",
		badges: ["Sentinel"],
		outcome:
			"Gate helper for one assurance stage of a chosen program—keeps humans oriented inside the three-stage spine.",
	},
	{
		tool: "sentinel_handoff_hint",
		badges: ["Sentinel"],
		outcome:
			"After a sentinel_audit_exit_kind, get deterministic wording for staying in assurance or opening Navigator or Investigator.",
	},
	{
		tool: "sentinel_canonical_refs",
		badges: ["Sentinel"],
		outcome:
			"Curated resources/read URIs for delivery and assurance lanes so hosts wire doctrine without hunting the catalog.",
	},
];

const toolBadgeClass: Record<
	(typeof mcpToolsCatalog)[number]["badges"][number],
	string
> = {
	Orchestration: "border-amber-300/40 text-amber-200",
	Navigator: "border-violet-300/40 text-violet-200",
	Investigator: "border-sky-300/40 text-sky-200",
	Sentinel: "border-emerald-300/40 text-emerald-200",
	Doctrine: "border-slate-300/30 text-slate-200",
};

const outcomes: Array<{ num: string; title: string; body: string }> = [
	{
		num: "01",
		title: "Faster delivery framing",
		body: "Navigator-style scope, verify, readiness with plan_delivery and doctrine-backed checks — not a generic checklist.",
	},
	{
		num: "02",
		title: "Safer defect work",
		body: "Investigator path keeps recon evidence-first. Path B diagnosis stays gated until routing accepts proof.",
	},
	{
		num: "03",
		title: "Assurance without theater",
		body: "Sentinel surfaces audit programs and seam closure language so “alignment” means traceable evidence, not vibes.",
	},
	{
		num: "04",
		title: "Orchestrator-ready metadata",
		body: "standard_brief, route_lane, and follow-on catalogs give hosts deterministic branching instead of keyword roulette.",
	},
	{
		num: "05",
		title: "AUTH literacy in-context",
		body: "Fetch AUTH slices where enforcement belongs in the stack — without dumping entire PDFs into every prompt.",
	},
	{
		num: "06",
		title: "One subscription, versioned server",
		body: "Hosted MCP tracks server capabilities; you integrate once and inherit capability schema bumps on your schedule.",
	},
];

const lanes: Array<{
	num: string;
	name: string;
	line: string;
	body: string;
	tone: "violet" | "blue" | "emerald";
}> = [
	{
		num: "I",
		name: "Navigator",
		line: "Workflow · delivery",
		body: "Net new or material improvement. Map scope, bind AUTH references, pull doctrine slices, and exit with readiness language your integrators can execute against.",
		tone: "violet",
	},
	{
		num: "II",
		name: "Investigator",
		line: "Workflow · defect",
		body: "Broken vs expected. Append evidence, respect halt-before-fix, and only deepen diagnosis when classification crosses the router threshold.",
		tone: "blue",
	},
	{
		num: "III",
		name: "Sentinel",
		line: "Workflow · assurance",
		body: "Prove existing alignment. Scope seams, bind evidence, run audit-program language, and attest readiness without pretending a single bug ticket is “compliance.”",
		tone: "emerald",
	},
];

const laneToneClasses: Record<
	(typeof lanes)[number]["tone"],
	{ numeral: string; chip: string; rule: string; bullet: string }
> = {
	violet: {
		numeral: "text-violet-300/90",
		chip: "border-violet-400/30 text-violet-200",
		rule: "border-violet-400/40",
		bullet: "bg-violet-300",
	},
	blue: {
		numeral: "text-sky-300/90",
		chip: "border-sky-400/30 text-sky-200",
		rule: "border-sky-400/40",
		bullet: "bg-sky-300",
	},
	emerald: {
		numeral: "text-emerald-300/90",
		chip: "border-emerald-400/30 text-emerald-200",
		rule: "border-emerald-400/40",
		bullet: "bg-emerald-300",
	},
};

const surfaces = [
	{
		letter: "A",
		name: "Canonical resources",
		body: "Read AUTH packs, UDALI doctrine, layer guides, and workflow mode docs as versioned MCP resources.",
	},
	{
		letter: "B",
		name: "Typed tools",
		body: "Call tools for briefs, routing, doctrine slices, delivery planning, defect debugging, and assurance programs — each with stable contracts for orchestrators.",
	},
	{
		letter: "C",
		name: "Response gates",
		body: "Troubleshooter-shaped outputs enforce execution control: atomic next actions, scope guardrails, and classification before “fix” stories run away.",
	},
	{
		letter: "D",
		name: "Operator-owned AUTH",
		body: "The MCP describes how controls should apply; your services and CI still prove enforcement. No silent claims of pass/fail in consumer repos.",
	},
];
---

<Layout
	title="AADM MCP — Connect to the hosted server"
	description="Connect Cursor, Claude Code, and claude.ai to the hosted AADM MCP at https://mcp.aadm.io/mcp — credentials in the member area after sign-in."
	headerActiveNav="mcp"
	headerMcpNavHref="/mcp#mcp-hero-heading"
	footerVariant="mcp"
	ogImage="/og/og-mcp.png"
>
	<main id="main" class="relative isolate overflow-x-clip bg-surface-deep text-slate-100">

		<!-- =============================================================
		     §00 — Hero
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06]" aria-labelledby="mcp-hero-heading">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[length:28px_28px] [mask-image:radial-gradient(ellipse_at_top,black_55%,transparent_85%)]"></div>
			<div aria-hidden="true" class="absolute right-0 top-0 -z-10 h-[36rem] w-[36rem] translate-x-1/3 -translate-y-1/3 rounded-full bg-emerald-500/[0.07] blur-3xl"></div>

			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 pb-20 pt-10 sm:px-8 sm:pb-28 sm:pt-16">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-emerald-200/70">§ 00</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Hosted MCP</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<p class="font-mono-cta mb-8 text-[10px] uppercase tracking-[0.28em] text-slate-500">
						<span class="text-emerald-200/90">▸</span> Subscriber service · Streamable HTTP
					</p>

					<h1
						id="mcp-hero-heading"
						class="scroll-mt-24 font-display max-w-[18ch] text-balance text-[clamp(2.4rem,8vw,6.6rem)] font-black leading-[0.9] tracking-[-0.04em] text-white sm:scroll-mt-28"
					>
						Connect to the
						<span class="relative inline-block">
							<span class="relative z-10 text-emerald-300">AADM MCP.</span>
							<span aria-hidden="true" class="absolute inset-x-0 bottom-[0.1em] -z-0 h-[0.18em] bg-emerald-300/30"></span>
						</span>
					</h1>

					<div class="mt-12 grid grid-cols-12 gap-6">
						<div class="col-span-12 sm:col-span-4">
							<div class="border-l border-emerald-300/40 pl-5">
								<p class="font-mono-cta text-[10px] uppercase tracking-[0.25em] text-emerald-200/80">Subscriber service</p>
								<p class="mt-3 text-[0.95rem] leading-relaxed text-slate-300">
									Authenticate with <span class="text-white">one</span> method, point your MCP host at the URL below, and reload.
									The MCP does not scan your repo — your apps and CI still prove enforcement.
								</p>
							</div>
						</div>
						<div class="col-span-12 sm:col-span-8">
							<p class="text-pretty text-lg leading-[1.65] text-slate-300 sm:text-xl">
								Subscribers point any MCP-capable IDE at one Streamable HTTP endpoint — Cursor, Claude Code, Windsurf, claude.ai
								Connectors. Versioned tools, deterministic routing,
								<span class="font-extralight italic text-slate-400">no per-team prompt sprawl.</span>
							</p>
						</div>
					</div>

					<div class="mt-12 flex flex-col flex-wrap items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
						<Show when="signed-out">
							<a
								id="get-access"
								href={signUpUrl}
								class="group inline-flex items-center gap-3 bg-white px-6 py-3.5 text-sm font-semibold tracking-tight text-slate-950 outline-none transition duration-200 hover:bg-emerald-200 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
							>
								<span>Get access</span>
								<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
									<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
								</svg>
							</a>
							<a
								href={signInUrl}
								class="inline-flex items-center gap-2 border border-white/20 bg-transparent px-6 py-3.5 text-sm font-semibold text-white outline-none transition duration-200 hover:border-white/40 hover:bg-white/[0.04] focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
							>
								Sign in to AADM
							</a>
						</Show>
						<Show when="signed-in">
							<a
								id="get-access"
								href={memberMcpOAuthUrl}
								class="group inline-flex items-center gap-3 bg-white px-6 py-3.5 text-sm font-semibold tracking-tight text-slate-950 outline-none transition duration-200 hover:bg-emerald-200 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
							>
								<span>Your client ID</span>
								<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
									<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
								</svg>
							</a>
						</Show>
						<a
							href="#two-ways"
							class="group font-mono-cta inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-slate-400 underline decoration-slate-700 underline-offset-[6px] transition hover:text-emerald-200 hover:decoration-emerald-300"
						>
							<span>Connection steps</span>
							<span aria-hidden="true" class="transition group-hover:translate-x-0.5">↓</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §01 — MCP Server URL
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06] bg-[#06080f]" aria-labelledby="mcp-endpoint-heading">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-16 sm:px-8 sm:py-20">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-emerald-200/70">§ 01</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Endpoint</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 id="mcp-endpoint-heading" class="font-display text-[clamp(1.5rem,3.6vw,2.4rem)] font-black leading-[1.05] tracking-[-0.02em] text-white">
						MCP server URL
					</h2>
					<p class="mt-3 max-w-3xl text-sm text-slate-400">
						Use this <span class="text-white">exact</span> URL in every client — include the
						<code class="font-mono-cta text-emerald-200/90">/mcp</code> path.
					</p>
					<div class="mt-6 flex flex-wrap items-center gap-3">
						<code class="font-mono-cta break-all border border-emerald-300/40 bg-[#070b13] px-5 py-3.5 text-sm font-semibold text-emerald-200 sm:text-base">
							{mcpRpcUrl}
						</code>
						<button
							type="button"
							id="mcp-url-copy-btn"
							data-url={mcpRpcUrl}
							class="font-mono-cta inline-flex items-center gap-2 border border-white/20 bg-transparent px-4 py-2.5 text-xs uppercase tracking-[0.18em] text-white transition hover:border-white/40 hover:bg-white/[0.04]"
						>
							Copy URL
						</button>
					</div>
					<p class="mt-4 text-xs text-slate-500">
						Discovery · <a href={discoveryUrl} class="text-emerald-300 underline decoration-emerald-300/40 underline-offset-4 hover:decoration-emerald-300">{mcpOrigin}/</a>
						· Health · <a href={healthUrl} class="text-emerald-300 underline decoration-emerald-300/40 underline-offset-4 hover:decoration-emerald-300">{mcpOrigin}/health</a>
					</p>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §02 — Two ways to connect
		     ============================================================= -->
		<section id="two-ways" class="relative scroll-mt-24 border-b border-white/[0.06] sm:scroll-mt-28" aria-labelledby="two-ways-heading">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-28">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-emerald-200/70">§ 02</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Two ways</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 id="two-ways-heading" class="font-display max-w-[22ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-black leading-[0.96] tracking-[-0.025em] text-white">
						Two ways to connect.<br />
						<span class="font-extralight italic text-slate-400">Pick one per client.</span>
					</h2>
					<p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-400">
						Don't paste an <code class="font-mono-cta text-slate-300">aadm_</code> token <em>and</em> an OAuth Client ID
						together — they're different auth paths.
					</p>

					<div class="mt-12 grid grid-cols-1 gap-px bg-white/[0.08] sm:grid-cols-2">
						<a href="#connect-bearer" class="group bg-[#06080f] p-7 transition duration-300 hover:bg-[#080c16] sm:p-9">
							<div class="flex items-baseline gap-4">
								<span class="font-display text-5xl font-extralight leading-none text-sky-300/90 sm:text-6xl">1</span>
								<span class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-sky-200/85">Bearer token</span>
							</div>
							<h3 class="font-display mt-6 text-[1.35rem] font-bold leading-snug tracking-tight text-white sm:text-[1.5rem]">
								Standard header token
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-slate-400">
								Cursor, Windsurf, curl — create an <code class="font-mono-cta text-xs text-sky-200/85">ak_…</code> API key under
								<span class="text-slate-300">Member area → API keys</span>.
							</p>
							<div aria-hidden="true" class="mt-7 flex items-center gap-2 text-sky-300/80">
								<span class="font-mono-cta text-[11px] uppercase tracking-[0.22em]">Set up</span>
								<svg width="14" height="10" viewBox="0 0 14 10" fill="none" class="transition group-hover:translate-x-0.5">
									<path d="M1 5h12M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
								</svg>
							</div>
						</a>
						<a href="#connect-oauth" class="group bg-[#06080f] p-7 transition duration-300 hover:bg-[#080c16] sm:p-9">
							<div class="flex items-baseline gap-4">
								<span class="font-display text-5xl font-extralight leading-none text-violet-300/90 sm:text-6xl">2</span>
								<span class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-violet-200/85">OAuth</span>
							</div>
							<h3 class="font-display mt-6 text-[1.35rem] font-bold leading-snug tracking-tight text-white sm:text-[1.5rem]">
								Browser sign-in
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-slate-400">
