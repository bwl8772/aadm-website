									href={healthUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="group flex flex-col rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/15 transition hover:border-slate-500/40 hover:bg-surface-mid/60"
								>
									<span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Liveness</span>
									<code class="mt-2 font-mono-cta text-sm font-semibold text-white">GET /health</code>
									<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">
										JSON probe for deploy checks and uptime monitors—not the MCP session itself.
									</p>
									<span class="mt-4 text-sm font-semibold text-accent-violet group-hover:text-accent-blue">
										Open endpoint →
									</span>
								</a>
							) : null}
							{discoveryUrl ? (
								<a
									href={discoveryUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="group flex flex-col rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/15 transition hover:border-slate-500/40 hover:bg-surface-mid/60"
								>
									<span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Discovery</span>
									<code class="mt-2 font-mono-cta text-sm font-semibold text-white">GET /</code>
									<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">
										Service JSON on the MCP host (e.g. <span class="font-mono-cta text-slate-500">mcp_endpoint</span>)
										for wiring proxies and clients.
									</p>
									<span class="mt-4 text-sm font-semibold text-accent-violet group-hover:text-accent-blue">
										Open discovery →
									</span>
								</a>
							) : null}
							<a
								href={mcpRpcUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="group flex flex-col rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/15 transition hover:border-slate-500/40 hover:bg-surface-mid/60"
							>
								<span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Streamable HTTP</span>
								<code class="mt-2 break-all font-mono-cta text-sm font-semibold text-accent-blue">{mcpRpcUrl}</code>
								<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">
									JSON-RPC <code class="font-mono-cta text-slate-500">POST</code> target — include{' '}
									<code class="font-mono-cta text-slate-500">/mcp</code> and{' '}
									<code class="font-mono-cta text-slate-500">Accept: application/json, text/event-stream</code>.
								</p>
								<span class="mt-4 text-sm font-semibold text-accent-violet group-hover:text-accent-blue">
									Open endpoint →
								</span>
							</a>
							<a
								href="#connect-bearer"
								class="group flex flex-col rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/15 transition hover:border-violet-500/35 hover:bg-surface-mid/60"
							>
								<span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Integrations</span>
								<span class="mt-2 font-mono-cta text-sm font-semibold text-white">Connect guide</span>
								<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">
									Bearer token vs OAuth — copy-paste configs for Cursor and Claude.
								</p>
								<span class="mt-4 text-sm font-semibold text-accent-violet group-hover:text-accent-blue">
									Jump to setup →
								</span>
							</a>
							{urlStandard.startsWith('http') ? (
								<a
									href={urlStandard}
									target="_blank"
									rel="noopener noreferrer"
									class="group flex flex-col rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/15 transition hover:border-slate-500/40 hover:bg-surface-mid/60"
								>
									<span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Standard</span>
									<span class="mt-2 font-display text-sm font-semibold text-white">Public AADM narrative</span>
									<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">
										Free, versioned standard text—the MCP is governed context on top of this story.
									</p>
									<span class="mt-4 text-sm font-semibold text-accent-violet group-hover:text-accent-blue">
										Open standard →
									</span>
								</a>
							) : null}
							{urlMcpCustomerDocs ? (
								<a
									href={urlMcpCustomerDocs}
									target="_blank"
									rel="noopener noreferrer"
									class="group flex flex-col rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/15 transition hover:border-slate-500/40 hover:bg-surface-mid/60"
								>
									<span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Subscriber</span>
									<span class="mt-2 font-display text-sm font-semibold text-white">Integration docs</span>
									<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">
										Portal or handbook material for org rollout—when this URL is configured at build time.
									</p>
									<span class="mt-4 text-sm font-semibold text-accent-violet group-hover:text-accent-blue">
										Open docs →
									</span>
								</a>
							) : null}
							<a
								href="/"
								class="group flex flex-col rounded-2xl border border-dashed border-slate-600/60 bg-surface-card/40 p-5 transition hover:border-slate-500 hover:bg-surface-mid/40"
							>
								<span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Marketing site</span>
								<span class="mt-2 font-display text-sm font-semibold text-slate-200">About · aadm.io</span>
								<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">
									This brochure site—not the MCP JSON-RPC host.
								</p>
								<span class="mt-4 text-sm font-semibold text-slate-400 group-hover:text-slate-200">Home →</span>
							</a>
						</div>
						<div>
							<p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">Smoke: initialize</p>
							<pre class="overflow-x-auto rounded-2xl border border-border-subtle bg-surface-card/90 p-4 font-mono-cta text-xs leading-relaxed text-slate-300 sm:text-sm"><code>{curlInit}</code></pre>
						</div>
					</div>
				) : (
					<p class="mt-6 text-sm text-slate-500">
						Set <code class="font-mono-cta text-slate-400">PUBLIC_MCP_REPO_URL</code> at build time to render your MCP
						endpoint and curl on this page.
					</p>
				)
			}
		</section>

		<!-- MCP tools catalog -->
		<section class="border-t border-border-subtle bg-surface-mid/25 py-16 sm:py-20" aria-labelledby="mcp-tools-heading">
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<h2 id="mcp-tools-heading" class="font-display text-2xl font-bold text-white sm:text-3xl">
					Typed tools & outcomes
				</h2>
				<p class="mt-3 max-w-3xl text-slate-400">
					Each tool returns structured JSON for orchestrators and IDEs. After you connect,{' '}
					<code class="font-mono-cta text-slate-400">tools/list</code> and{' '}
					<code class="font-mono-cta text-slate-400">inputSchema</code> on the running server are authoritative—names below match
					the hosted AADM MCP surface.
				</p>
				<ul class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
					{
						mcpToolsCatalog.map((row) => (
							<li class="flex flex-col rounded-2xl border border-border-subtle bg-surface-card/70 p-5 shadow-lg shadow-black/15">
								<div class="flex flex-wrap items-center gap-2">
									<code class="break-all font-mono-cta text-sm font-semibold text-white">{row.tool}</code>
								</div>
								<div class="mt-3 flex flex-wrap gap-1.5">
									{row.badges.map((b) => (
										<span
											class:list={[
												'rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide',
												toolBadgeClass[b],
											]}
										>
											{b}
										</span>
									))}
								</div>
								<p class="mt-3 text-sm leading-relaxed text-slate-400">{row.outcome}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

	</main>
</Layout>
