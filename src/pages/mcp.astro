						) : (
							<p class="mt-6 text-sm text-slate-500">
								Set <code class="font-mono-cta text-slate-300">PUBLIC_MCP_REPO_URL</code> at build time to render your MCP
								endpoint and curl on this page.
							</p>
						)
					}
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §10 — Tools catalog
		     ============================================================= -->
		<section class="relative bg-surface-deep" aria-labelledby="mcp-tools-heading">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-emerald-200/70">§ 10</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Tools catalog</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 id="mcp-tools-heading" class="font-display text-[clamp(1.9rem,4.2vw,3.4rem)] font-black leading-[0.96] tracking-[-0.025em] text-white">
						Typed tools & outcomes.
					</h2>
					<p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-400">
						Each tool returns structured JSON for orchestrators and IDEs. After you connect,{' '}
						<code class="font-mono-cta text-emerald-200/85">tools/list</code> and{' '}
						<code class="font-mono-cta text-emerald-200/85">inputSchema</code> on the running server are authoritative — names below
						match the hosted AADM MCP surface.
					</p>

					<ul class="mt-14 grid grid-cols-1 gap-px bg-white/[0.08] sm:grid-cols-2 xl:grid-cols-3">
						{
							mcpToolsCatalog.map((row) => (
								<li class="group flex flex-col bg-surface-deep p-5 transition duration-300 hover:bg-[#0a0e1a]">
									<code class="font-mono-cta break-all text-sm font-semibold text-white">{row.tool}</code>
									<div class="mt-3 flex flex-wrap gap-1.5">
										{row.badges.map((b) => (
											<span
												class:list={[
													"border bg-transparent px-2 py-0.5 font-mono-cta text-[10px] uppercase tracking-[0.22em]",
													toolBadgeClass[b],
												]}
											>
												{b}
											</span>
										))}
									</div>
									<p class="mt-4 text-sm leading-relaxed text-slate-400">{row.outcome}</p>
									<div aria-hidden="true" class="mt-auto pt-5">
										<div class="h-px w-8 bg-emerald-300/30 transition-all duration-500 group-hover:w-16 group-hover:bg-emerald-300/60"></div>
									</div>
								</li>
							))
						}
					</ul>

					<!-- Colophon -->
					<div class="mt-24 grid grid-cols-12 gap-6 border-t border-white/[0.06] pt-8 font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-600">
						<div class="col-span-12 sm:col-span-4">
							<span class="text-slate-500">Service</span> · AADM MCP
						</div>
						<div class="col-span-12 sm:col-span-4">
							<span class="text-slate-500">Endpoint</span> · <span class="text-emerald-300/80">{mcpRpcUrl}</span>
						</div>
						<div class="col-span-12 sm:col-span-4">
							<span class="text-slate-500">Transport</span> · <span class="text-emerald-300/80">Streamable HTTP / JSON-RPC</span>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
