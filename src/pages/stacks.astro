---
import Layout from "../layouts/Layout.astro";
import { getSiteUrlConfig } from "../lib/site-urls";

const { urlStandard, urlMcpMarketing } = getSiteUrlConfig(import.meta.env);

type StackEntry = {
	name: string;
	covers: string;
};

type StackGroup = {
	title: string;
	tagline: string;
	tone: "emerald" | "violet" | "amber";
	items: StackEntry[];
};

const stackGroups: StackGroup[] = [
	{
		title: "Frontend",
		tagline: "Component frameworks",
		tone: "emerald",
		items: [
			{
				name: "React",
				covers: "Hooks, Context, Router, React Query, Redux / Zustand / Jotai",
			},
			{
				name: "Vue",
				covers:
					"Composition + Options API, Pinia / Vuex, Router, Teleport, Suspense",
			},
			{
				name: "Svelte",
				covers: "Runes ($state / $derived / $effect), stores, SvelteKit",
			},
			{
				name: "Next.js",
				covers:
					"Server Components, Server Actions, Route Handlers, middleware.ts",
			},
			{
				name: "Angular",
				covers: "Signals, RxJS, NgRx, DI services, structural directives",
			},
		],
	},
	{
		title: "Backend",
		tagline: "Server frameworks",
		tone: "violet",
		items: [
			{
				name: "Express (Node.js)",
				covers: "Middleware chain, Passport, CORS, Helmet, route handlers",
			},
			{
				name: "NestJS",
				covers: "Decorators, guards, interceptors, exception filters, queues",
			},
			{
				name: "Ruby on Rails",
				covers: "ActiveRecord, ActionController, Sidekiq, ActionCable",
			},
			{
				name: "Django",
				covers: "Views, models, serializers, signals, Celery tasks",
			},
			{
				name: "Spring / Spring Boot",
				covers:
					"Controllers, Security filters, @Transactional, Kafka listeners",
			},
			{
				name: "FastAPI",
				covers: "Depends, Pydantic models, background tasks, WebSockets",
			},
			{
				name: "ASP.NET Core",
				covers: "Middleware, DbContext, action filters, SignalR hubs",
			},
			{
				name: "Rust (Axum / Actix / Tower)",
				covers: "Handlers, Tower middleware, sqlx, tonic gRPC",
			},
			{
				name: "Go (net/http / Gin / Echo)",
				covers: "Handlers, middleware chains, goroutines, GORM, gRPC",
			},
		],
	},
	{
		title: "Game engines",
		tagline: "Real-time + netcode",
		tone: "amber",
		items: [
			{
				name: "Unity (C#)",
				covers:
					"MonoBehaviour lifecycle, Mirror / Photon networking, Addressables",
			},
			{
				name: "Unreal Engine (C++ / Blueprint)",
				covers: "Actors, replication, RPCs, Blueprint",
			},
			{
				name: "Godot (GDScript / C#)",
				covers: "Nodes, signals, @rpc, autoloads",
			},
			{
				name: "Roblox (Lua)",
				covers: "RemoteEvents, DataStores, ProfileService, Knit",
			},
			{
				name: "Rust (Bevy ECS)",
				covers: "Components, Systems, Resources, Events",
			},
		],
	},
];

const toneClasses: Record<StackGroup["tone"], { label: string; rule: string }> =
	{
		emerald: { label: "text-emerald-200/85", rule: "border-emerald-300/40" },
		violet: { label: "text-violet-200/85", rule: "border-violet-400/40" },
		amber: { label: "text-amber-200/85", rule: "border-amber-300/40" },
	};

const languages = [
	"TypeScript / JavaScript",
	"Python",
	"Go",
	"Rust",
	"Java / Kotlin",
	"C#",
	"Swift",
	"Ruby",
	"PHP",
	"Lua",
];

const platforms = [
	"Web",
	"Mobile — native",
	"Mobile — cross-platform",
	"Server-rendered web",
	"Desktop",
	"Other — CLI, API, embedded",
];

const openGaps = [
	{
		t: "PHP frameworks",
		b: "Laravel, Symfony. PHP is a recognized language — there's no idiom dictionary for it yet.",
	},
	{
		t: "Mobile frameworks",
		b: "React Native, Flutter, SwiftUI, Jetpack Compose. Mobile is a recognized platform — there's no idiom dictionary for it yet.",
	},
	{
		t: "Cloud SDKs and infra idioms",
		b: "Lambda handlers, IAM policies, Terraform. Not modeled at all — cloud only ever shows up as plain evidence, never a dictionary entry.",
	},
];

const totalStacks = stackGroups.reduce((n, g) => n + g.items.length, 0);
---

<Layout
	title="AADM — compatible tech stacks"
	description="AADM never names a cloud. Named idiom support across 19 frontend, backend, and game-engine stacks — and the same doctrine, AUTH controls, and workflows for everything else."
	headerActiveNav="stacks"
>
	<main id="main" class="relative isolate overflow-x-clip bg-surface-deep text-slate-100">

		<!-- =============================================================
		     §00 — Hero
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06]">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[length:28px_28px] [mask-image:radial-gradient(ellipse_at_top,black_55%,transparent_85%)]"></div>
			<div aria-hidden="true" class="absolute right-0 top-0 -z-10 h-[36rem] w-[36rem] translate-x-1/3 -translate-y-1/3 rounded-full bg-emerald-500/[0.07] blur-3xl"></div>
			<div aria-hidden="true" class="absolute left-0 top-40 -z-10 h-[32rem] w-[32rem] -translate-x-1/3 rounded-full bg-violet-500/[0.06] blur-3xl"></div>

			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 pb-20 pt-10 sm:px-8 sm:pb-28 sm:pt-16">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-emerald-200/70">§ 00</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-slate-400">Stacks</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<p class="font-mono-cta mb-10 text-[13px] normal-case tracking-[0.01em] text-slate-400">
						<span class="text-emerald-200/90">▸</span> {totalStacks} stacks with idiom-level translation · zero required
					</p>

					<h1 class="font-display max-w-[20ch] text-balance text-[clamp(2.4rem,8vw,6rem)] font-bold leading-[1.08] tracking-[-0.01em] text-white">
						Works with your stack. <span class="font-light italic text-slate-400">Doesn't require one.</span>
					</h1>

					<div class="mt-14 grid grid-cols-12 gap-6">
						<div class="col-span-12 sm:col-span-4">
							<div class="border-l border-emerald-300/40 pl-5">
								<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-emerald-200/80">Cloud</p>
								<p class="mt-3 text-[0.95rem] leading-relaxed text-slate-300">
									AADM never names a cloud. The doctrine reasons about layers and AUTH controls — never vendors.
								</p>
								<div class="mt-5 flex flex-wrap items-center gap-2 font-mono-cta text-[13px] normal-case tracking-[0.01em]">
									<span class="border border-white/15 px-2.5 py-1 text-slate-300">AWS</span>
									<span class="border border-white/15 px-2.5 py-1 text-slate-300">Azure</span>
									<span class="border border-white/15 px-2.5 py-1 text-slate-300">GCP</span>
									<span class="border border-white/15 px-2.5 py-1 text-slate-300">Self-hosted</span>
									<span class="text-emerald-300">= the same to AADM</span>
								</div>
							</div>
						</div>
						<div class="col-span-12 sm:col-span-8">
							<p class="text-pretty text-lg leading-[1.65] text-slate-300 sm:text-xl">
								Two more things are true at once. <span class="text-white">{totalStacks} named frameworks</span> — React
								to Rust to Roblox — get idiom-level translation: your framework's own words turn into AADM citations
								automatically.{' '}
								<span class="font-light italic text-slate-400">And nothing else degrades.</span> An unlisted stack still
								gets the full standard — Navigator, Investigator, Sentinel, every AUTH control — just without that
								shortcut.
							</p>
						</div>
					</div>

					<div class="mt-14 flex flex-col flex-wrap items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
						<a
							href="#named-support"
							class="group inline-flex items-center gap-3 bg-white px-6 py-3.5 text-sm font-semibold tracking-tight text-slate-950 outline-none transition duration-200 hover:bg-emerald-200 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>See the {totalStacks} stacks</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href="#everything-else"
							class="inline-flex items-center gap-2 border border-white/20 bg-transparent px-6 py-3.5 text-sm font-semibold text-white outline-none transition duration-200 hover:border-white/40 hover:bg-white/[0.04] focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							What if mine isn't listed?
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §01 — Named stack support
		     ============================================================= -->
		<section id="named-support" class="relative scroll-mt-20 border-b border-white/[0.06] bg-[#06080f]">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-20 sm:px-8 sm:py-24">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-emerald-200/70">§ 01</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-slate-400">Named support</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display text-[clamp(1.7rem,4vw,2.8rem)] font-bold leading-[1.05] tracking-[-0.01em] text-white">
						Your framework's own words, <span class="font-light italic text-slate-400">turned into citations.</span>
					</h2>
					<p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-400">
						Paste <code class="font-mono-cta text-emerald-200/85">useEffect</code>, <code class="font-mono-cta text-emerald-200/85">ngOnInit</code>, or
						<code class="font-mono-cta text-emerald-200/85"> RemoteEvent</code> and the MCP returns the matching stack role, AUTH control, and
						UDALI band — a deterministic keyword lookup, never a guess. Stack identity itself is only ever set by evidence
						you provide (a <code class="font-mono-cta text-emerald-200/85">framework_hint</code> or your own
						<code class="font-mono-cta text-emerald-200/85"> package.json</code> / <code class="font-mono-cta text-emerald-200/85">go.mod</code>
						dependencies) — never inferred from free text.
					</p>

					<div class="mt-14 space-y-14">
						{
							stackGroups.map((group) => {
								const t = toneClasses[group.tone];
								return (
									<div>
										<div class:list={["border-l pl-5", t.rule]}>
											<p class:list={["font-mono-cta text-[13px] normal-case tracking-[0.01em]", t.label]}>{group.tagline}</p>
											<h3 class="font-display mt-1 text-xl font-bold leading-snug tracking-tight text-white sm:text-2xl">{group.title}</h3>
										</div>
										<ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
											{
												group.items.map((item) => (
													<li class="border border-white/[0.08] bg-[#080c16] p-5 transition duration-300 hover:border-white/20 sm:p-6">
														<p class="font-display text-base font-bold leading-snug tracking-tight text-white">{item.name}</p>
														<p class="mt-2 text-sm leading-relaxed text-slate-400">{item.covers}</p>
													</li>
												))
											}
										</ul>
									</div>
								);
							})
						}
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §02 — Everything else
		     ============================================================= -->
		<section id="everything-else" class="relative scroll-mt-20 border-b border-white/[0.06]">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-20 sm:px-8 sm:py-24">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-emerald-200/70">§ 02</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-slate-400">Everything else</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[26ch] text-[clamp(1.7rem,4vw,2.8rem)] font-bold leading-[1.05] tracking-[-0.01em] text-white">
						No dictionary entry <span class="font-light italic text-slate-400">doesn't mean no support.</span>
					</h2>
					<p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-400">
						The three workflows — Navigator, Investigator, Sentinel — and every AUTH control apply identically no
						matter what you're building in. A stack without a named dictionary just skips the idiom shortcut; it
						still gets routed, still gets gated, still gets the same evidence discipline.
					</p>

					<div class="mt-14 grid grid-cols-1 gap-10 lg:grid-cols-2">
						<div>
							<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-slate-400">Recognized languages</p>
							<ul class="mt-4 flex flex-wrap gap-2">
								{languages.map((l) => (
									<li class="border border-white/15 px-2.5 py-1 font-mono-cta text-[13px] normal-case tracking-[0.01em] text-slate-300">{l}</li>
								))}
							</ul>
						</div>
						<div>
							<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-slate-400">Recognized platforms</p>
							<ul class="mt-4 flex flex-wrap gap-2">
								{platforms.map((p) => (
									<li class="border border-white/15 px-2.5 py-1 font-mono-cta text-[13px] normal-case tracking-[0.01em] text-slate-300">{p}</li>
								))}
							</ul>
						</div>
					</div>

					<div class="mt-16 border-l-2 border-amber-300/40 pl-6">
						<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-amber-200/85">Honestly, not covered yet</p>
						<ul class="mt-5 divide-y divide-white/[0.06] border-t border-white/[0.06]">
							{
								openGaps.map((g) => (
									<li class="py-4">
										<p class="text-sm font-semibold text-white">{g.t}</p>
										<p class="mt-1 text-sm leading-relaxed text-slate-400">{g.b}</p>
									</li>
								))
							}
						</ul>
						<p class="mt-5 text-xs leading-relaxed text-slate-500">
							This list changes as idiom dictionaries get added — it's a snapshot, not a promise either way.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §03 — Final CTA
		     ============================================================= -->
		<section class="relative bg-surface-deep">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_bottom,rgba(110,231,183,0.07),transparent_60%)]"></div>
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:py-32 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-emerald-200/70">§ 03</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-slate-400">Start here</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[18ch] text-balance text-[clamp(2rem,5.5vw,4.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-white">
						Same standard. <span class="font-light italic text-slate-400">Any stack you bring.</span>
					</h2>
					<p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-300">
						Connect from whatever IDE you already use — the stack underneath is never the gate.
					</p>

					<div class="mt-14 flex flex-col flex-wrap items-start gap-4 sm:flex-row sm:items-center sm:gap-5">
						<a
							href={urlMcpMarketing}
							class="group inline-flex items-center gap-3 bg-white px-7 py-4 text-sm font-semibold tracking-tight text-slate-950 outline-none transition duration-200 hover:bg-emerald-200 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>See how the MCP works</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href="/ides"
							class="inline-flex items-center gap-2 border border-white/20 bg-transparent px-7 py-4 text-sm font-semibold text-white outline-none transition duration-200 hover:border-white/40 hover:bg-white/[0.04] focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							Pick an IDE
						</a>
						<a
							href={urlStandard}
							class="group font-mono-cta inline-flex items-center gap-2 text-sm normal-case tracking-[0.01em] text-slate-400 underline decoration-slate-700 underline-offset-[6px] transition hover:text-emerald-200 hover:decoration-emerald-300"
						>
							<span>Read the open standard</span>
							<span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
