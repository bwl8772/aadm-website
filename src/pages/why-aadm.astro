					</p>

					<!-- Column legend (desktop only) -->
					<div class="mt-12 hidden grid-cols-12 gap-8 border-t border-white/10 pb-3 pt-5 text-[10px] font-mono-cta uppercase tracking-[0.25em] lg:grid">
						<div class="col-span-3 text-slate-500">Scenario</div>
						<div class="col-span-4 text-amber-200/80">▸ Without AADM</div>
						<div class="col-span-5 text-emerald-200/80">▸ With AADM</div>
					</div>

					<div class="border-t border-white/10 lg:border-t-0">
						{
							comparisons.map((row) => (
								<article class="group relative grid grid-cols-1 gap-6 border-b border-white/[0.08] py-9 transition duration-300 hover:bg-white/[0.015] lg:grid-cols-12 lg:gap-8 lg:py-10">
									<!-- Scenario -->
									<div class="lg:col-span-3">
										<div class="flex items-baseline gap-3">
											<span class="font-display text-3xl font-extralight leading-none text-white/90 sm:text-4xl">
												{row.num}
											</span>
											<span class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-500 transition group-hover:text-emerald-200/80">
												Case file
											</span>
										</div>
										<h3 class="font-display mt-4 text-[1.15rem] font-bold leading-[1.2] tracking-tight text-white sm:text-[1.25rem]">
											{row.scenario}
										</h3>
										<p class="mt-2 text-sm italic leading-relaxed text-slate-500">{row.plain}</p>
										{row.tool ? (
											<p class="mt-5 font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-600">
												tool · <span class="text-emerald-200/80">{row.tool}</span>
											</p>
										) : null}
									</div>

									<!-- Without -->
									<div class="relative lg:col-span-4">
										<div class="absolute -left-3 top-0 h-full w-px bg-amber-300/30 lg:left-[-1px]"></div>
										<p class="font-mono-cta pl-4 text-[10px] uppercase tracking-[0.22em] text-amber-200/80 lg:hidden">
											Without AADM
										</p>
										<p class="mt-2 pl-4 text-[0.95rem] leading-relaxed text-slate-400 lg:mt-0">
											{row.without}
										</p>
									</div>

									<!-- With -->
									<div class="relative lg:col-span-5">
										<div class="absolute -left-3 top-0 h-full w-px bg-emerald-300/40 lg:left-[-1px]"></div>
										<p class="font-mono-cta pl-4 text-[10px] uppercase tracking-[0.22em] text-emerald-200/90 lg:hidden">
											With AADM
										</p>
										<p class="mt-2 pl-4 text-[0.95rem] leading-relaxed text-slate-100 lg:mt-0">
											{row.with}
										</p>
									</div>

									<!-- Hover chevron (desktop) -->
									<div aria-hidden="true" class="pointer-events-none absolute right-0 top-1/2 hidden -translate-y-1/2 translate-x-2 opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:opacity-100 lg:block">
										<svg width="20" height="14" viewBox="0 0 20 14" fill="none" class="text-emerald-300/80">
											<path d="M1 7h17M13 1l5 6-5 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
										</svg>
									</div>
								</article>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §03 — Three lanes
		     Editorial blocks with HUGE hanging Roman numerals
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06]">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-violet-200/70">§ 03</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Three lanes</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[20ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-black leading-[0.96] tracking-[-0.025em] text-white">
						Three jobs.<br />
						Three lanes.<br />
						<span class="font-extralight italic text-slate-400">One answer each.</span>
					</h2>
					<p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-400">
						Every coding task is one of three things: building something new, fixing something broken, or proving something is
						aligned. AADM gives each one its own workflow — so the agent picks the right one, not whichever instinct fires first.
					</p>

					<div class="mt-16 space-y-px bg-white/[0.08]">
						{
							lanes.map((lane) => {
								const t = laneToneClasses[lane.tone];
								return (
									<article class="group relative overflow-hidden bg-surface-deep transition duration-300 hover:bg-[#080c16]">
										<!-- Faint glow per lane -->
										<div aria-hidden="true" class:list={["pointer-events-none absolute -left-24 -top-24 -z-0 h-72 w-72 rounded-full blur-3xl transition duration-500 opacity-50 group-hover:opacity-100", t.glow]}></div>

										<div class="relative grid grid-cols-12 gap-6 px-1 py-12 sm:px-2 sm:py-14">
											<!-- Hanging numeral -->
											<div class="col-span-12 sm:col-span-2">
												<p class:list={["font-display text-[5rem] font-extralight leading-[0.85] tracking-tight sm:text-[6.5rem]", t.numeral]}>
													{lane.num}
												</p>
												<div class:list={["mt-3 inline-flex items-center gap-2 border px-3 py-1.5 font-mono-cta text-[10px] uppercase tracking-[0.22em]", t.chip]}>
													<span class:list={["block h-1.5 w-1.5 rounded-full", t.numeral.replace("text-", "bg-").replace("/90", "")]}></span>
													{lane.name}
												</div>
											</div>

											<!-- Trigger + plain -->
											<div class="col-span-12 sm:col-span-6">
												<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-500">{lane.tagline}</p>
												<p class="font-display mt-4 text-balance text-[1.55rem] font-bold leading-[1.1] tracking-tight text-white sm:text-[2rem]">
													<span class:list={["mr-1", t.numeral]}>“</span>
													{lane.trigger}
													<span class:list={["ml-0.5", t.numeral]}>”</span>
												</p>
												<p class="mt-6 text-[0.98rem] leading-[1.65] text-slate-300">{lane.plain}</p>
											</div>

											<!-- Tech + tools -->
											<div class="col-span-12 sm:col-span-4">
												<div class:list={["border-l pl-5", t.rule]}>
													<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-500">For engineers</p>
													<p class:list={["mt-2 text-sm leading-relaxed", t.accent]}>{lane.tech}</p>
												</div>
												<div class="mt-6">
													<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-500">Tools the agent calls</p>
													<div class="mt-3 flex flex-wrap gap-1.5">
														{lane.tools.map((tname) => (
															<code class:list={["font-mono-cta border px-2.5 py-0.5 text-[11px] transition", t.chip]}>
																{tname}
															</code>
														))}
													</div>
												</div>
											</div>
										</div>
									</article>
								);
							})
						}
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §04 — Mechanics (4-up grid, big mono numerals)
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06] bg-[#06080f]">
			<div
				aria-hidden="true"
				class="absolute inset-0 -z-10 bg-[radial-gradient(rgba(110,231,183,0.04)_1px,transparent_1px)] bg-[length:36px_36px] [mask-image:radial-gradient(ellipse_at_center,black_55%,transparent_85%)]"
			></div>
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-emerald-200/70">§ 04</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Mechanics</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
