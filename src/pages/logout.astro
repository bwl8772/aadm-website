---
import Layout from '../layouts/Layout.astro';
import { getSiteUrlConfig, CLERK_SIGN_OUT_REDIRECT_URL } from '../lib/site-urls';

const cfg = getSiteUrlConfig(import.meta.env);
const pk = cfg.clerkPublishableKey;
---

<Layout title="Signing out — AADM">
	<main class="flex min-h-[60vh] items-center justify-center px-4">
		<p id="logout-msg" class="text-lg text-slate-400">Signing out…</p>
	</main>

	{pk ? (
		<script is:inline define:vars={{ clerkPk: pk, redirectUrl: CLERK_SIGN_OUT_REDIRECT_URL }}>{`
(function () {
	var msg = document.getElementById('logout-msg');

	function go() { window.location.href = redirectUrl; }

	function loadClerk() {
		if (window.Clerk) return Promise.resolve();
		return new Promise(function (resolve, reject) {
			var s = document.createElement('script');
			s.async = true;
			s.crossOrigin = 'anonymous';
			s.src = 'https://cdn.jsdelivr.net/npm/@clerk/clerk-js@5/dist/clerk.browser.js';
			s.onload = resolve;
			s.onerror = reject;
			document.head.appendChild(s);
		});
	}

	async function run() {
		try {
			await loadClerk();
			await window.Clerk.load({ publishableKey: clerkPk });
			if (window.Clerk.user) {
				await window.Clerk.signOut({ redirectUrl: redirectUrl });
			} else {
				if (msg) msg.textContent = 'You are not signed in. Redirecting…';
				setTimeout(go, 1200);
			}
		} catch (e) {
			if (msg) msg.textContent = 'Could not sign out. Redirecting…';
			setTimeout(go, 1500);
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', function () { void run(); });
	} else {
		void run();
	}
})();
		`}</script>
	) : (
		<script is:inline define:vars={{ redirectUrl: CLERK_SIGN_OUT_REDIRECT_URL }}>{`
			window.location.href = redirectUrl;
		`}</script>
	)}
</Layout>
