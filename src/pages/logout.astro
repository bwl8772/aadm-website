---
/**
 * Clerk / UserButton may navigate here to complete sign-out.
 * Satellite: also clears primary-domain session by redirecting to Account Portal sign-in.
 */
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { CLERK_ACCOUNTS_SIGN_IN } from "../lib/clerk-portal-urls";
---

<Layout
	title="Sign out"
	description="Signing out of AADM."
	showFooter={false}
	headerActiveNav={null}
>
	<main id="main" class="mx-auto max-w-6xl px-4 py-24 text-center">
		<p class="text-slate-400">Signing you out…</p>
	</main>
</Layout>

<script define:vars={{ accountsSignIn: CLERK_ACCOUNTS_SIGN_IN }}>
	function signOutWhenReady() {
		async function trySignOut() {
			try {
				const clerk = window.Clerk;
				if (clerk && typeof clerk.signOut === "function") {
					if (typeof clerk.load === "function") {
						await clerk.load();
					}
					await clerk.signOut({ redirectUrl: accountsSignIn });
					return;
				}
			} catch {
				/* fall through */
			}
			window.location.replace(accountsSignIn);
		}
		void trySignOut();
	}

	if (document.readyState === "complete") {
		signOutWhenReady();
	} else {
		window.addEventListener("load", signOutWhenReady, { once: true });
	}
</script>
