---
import Layout from "../layouts/Layout.astro";
import { getAccountPortalUrls } from "../lib/account-portal-urls";
import { getSiteUrlConfig } from "../lib/site-urls";

const { urlStandard, urlMcpMarketing } = getSiteUrlConfig(import.meta.env);
const { memberSignInUrl } = getAccountPortalUrls(import.meta.env);
const mcpConnectHref = `${urlMcpMarketing.replace(/\/$/, "")}#connect-bearer`;

const laneCards = [
	{
		num: "I",
		name: "Navigator",
		line: "Planned delivery",
		body: "Cursor scopes and implements net-new work. AADM provides the workflow language for what “ready” looks like before you ship.",
		tone: "violet" as const,
	},
	{
		num: "II",
		name: "Investigator",
		line: "Defect work",
		body: "Cursor reads traces, greps code, and applies fixes. AADM enforces evidence-before-fix — recon first, remediation only after the failure is classified.",
		tone: "blue" as const,
	},
	{
		num: "III",
		name: "Sentinel",
		line: "Assurance",
		body: "Cursor traces AUTH and UDALI seams across your codebase. AADM defines what evidence is required to attest alignment — not a vibes check.",
		tone: "emerald" as const,
	},
];

const laneToneClasses = {
	violet: {
		numeral: "text-violet-300/90",
		chip: "border-violet-400/30 text-violet-200",
		bullet: "bg-violet-300",
	},
	blue: {
		numeral: "text-sky-300/90",
		chip: "border-sky-400/30 text-sky-200",
		bullet: "bg-sky-300",
	},
	emerald: {
		numeral: "text-emerald-300/90",
		chip: "border-emerald-400/30 text-emerald-200",
		bullet: "bg-emerald-300",
	},
};

const qa = [
	{
		q: "Does AADM “do adherence”?",
		a: "It defines adherence expectations and process. Your repo and tests demonstrate adherence.",
	},
	{
		q: "Does Cursor fix the code?",
		a: "Yes — fixes happen in your codebase via the agent (or you). AADM doesn't patch your repo by itself.",
	},
	{
		q: "Should Cursor read the repo?",
		a: "Yes. Verifying alleged gaps with Read/grep is appropriate. Claiming “no remediation needed” must be justified by behavior (repro, GET before/after) — not line reads alone.",
	},
];
---

<Layout
	title="AADM + Cursor — How they work together"
	description="AADM shapes how agents reason and what to demand. Cursor applies those standards in your workspace. Understanding the division makes both more useful."
	headerActiveNav={null}
>
	<main id="main" class="relative isolate overflow-x-clip bg-surface-deep text-slate-100">

		<!-- =============================================================
		     §00 — Hero
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06]">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[length:28px_28px] [mask-image:radial-gradient(ellipse_at_top,black_55%,transparent_85%)]"></div>
			<div aria-hidden="true" class="absolute right-0 top-0 -z-10 h-[36rem] w-[36rem] translate-x-1/3 -translate-y-1/3 rounded-full bg-violet-500/[0.07] blur-3xl"></div>

			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 pb-20 pt-10 sm:px-8 sm:pb-28 sm:pt-16">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-violet-200/70">§ 00</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">AADM + Cursor</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<p class="font-mono-cta mb-8 text-[10px] uppercase tracking-[0.28em] text-slate-500">
						<span class="text-violet-200/90">▸</span> How responsibility divides
					</p>

					<h1 class="font-display max-w-[20ch] text-balance text-[clamp(2.4rem,8vw,6.4rem)] font-black leading-[0.9] tracking-[-0.04em] text-white">
						Standard as <span class="font-extralight italic text-slate-400">coaching.</span><br />
						Cursor as <span class="relative inline-block">
							<span class="relative z-10 text-violet-300">editor.</span>
							<span aria-hidden="true" class="absolute inset-x-0 bottom-[0.1em] -z-0 h-[0.18em] bg-violet-300/30"></span>
						</span>
					</h1>

					<div class="mt-12 grid grid-cols-12 gap-6">
						<div class="col-span-12 sm:col-span-4">
							<div class="border-l border-violet-300/40 pl-5">
								<p class="font-mono-cta text-[10px] uppercase tracking-[0.25em] text-violet-200/80">The division</p>
								<p class="mt-3 text-[0.95rem] leading-relaxed text-slate-300">
									AADM defines the workflows, layer language, and evidence discipline. Cursor — and the model inside it — opens
									your project and applies that standard to real code.
								</p>
							</div>
						</div>
						<div class="col-span-12 sm:col-span-8">
							<p class="text-pretty text-lg leading-[1.65] text-slate-300 sm:text-xl">
								Understanding the division makes both more useful. AADM doesn't read or patch your repo. Cursor doesn't define
								what “done” means. Wire them together and your agent's first PR
								<span class="font-extralight italic text-slate-400"> matches the team's bar.</span>
							</p>
						</div>
					</div>

					<div class="mt-10 flex flex-wrap gap-x-4 gap-y-2 font-mono-cta text-[11px] uppercase tracking-[0.18em] text-slate-500">
						<a href={mcpConnectHref} class="text-violet-300 underline decoration-violet-400/40 underline-offset-[6px] hover:decoration-violet-300">MCP credentials · /mcp#connect-bearer</a>
						<span class="text-slate-700">·</span>
						<a href={memberSignInUrl} class="text-violet-300 underline decoration-violet-400/40 underline-offset-[6px] hover:decoration-violet-300">Sign in for API keys</a>
						<span class="text-slate-700">·</span>
						<a href="/governance" class="text-emerald-300 underline decoration-emerald-300/40 underline-offset-[6px] hover:decoration-emerald-300">Step 0 · npx aadm-init-repo</a>
					</div>

					<div class="mt-12 flex flex-col flex-wrap items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
						<a
							href={urlMcpMarketing}
							class="group inline-flex items-center gap-3 bg-white px-6 py-3.5 text-sm font-semibold tracking-tight text-slate-950 outline-none transition duration-200 hover:bg-emerald-200 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>Connect via MCP</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href={urlStandard}
							class="inline-flex items-center gap-2 border border-white/20 bg-transparent px-6 py-3.5 text-sm font-semibold text-white outline-none transition duration-200 hover:border-white/40 hover:bg-white/[0.04] focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							Read the standard
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §01 — What AADM does + What it does not
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06] bg-[#06080f]">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-emerald-200/70">§ 01</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">What AADM is</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<div class="grid grid-cols-12 gap-8">
						<div class="col-span-12 lg:col-span-7">
							<h2 class="font-display text-[clamp(1.7rem,4vw,2.8rem)] font-black leading-[1.05] tracking-[-0.025em] text-white">
								What AADM actually does.
							</h2>
							<p class="mt-6 text-base leading-relaxed text-slate-300">
								AADM — the standard plus MCP — is <span class="font-semibold text-white">guidance and guardrails</span>: workflows
								(Navigator / Investigator / Sentinel), layer language, evidence-before-fix discipline, templates, and tools that
								return structured prompts and checklists.
							</p>
							<p class="mt-4 text-base leading-relaxed text-slate-400">
								It is <span class="text-white">not your app</span> and does not run inside your product codebase.
							</p>
							<p class="mt-8 border-l-2 border-emerald-300/40 py-1 pl-5 text-sm italic text-slate-400">
								“Application repos prove AADM through code, tests, and evidence.”
								<span class="not-italic"> — AGENTS.md</span>
							</p>
						</div>
						<div class="col-span-12 lg:col-span-5">
							<div class="border-l-2 border-amber-300/40 pl-6">
								<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-amber-200/80">What the MCP does not do</p>
								<ul class="mt-6 divide-y divide-white/[0.06] border-t border-white/[0.06]">
									{
										[
											{ k: "No repo scan", v: "The MCP server does not read your codebase or issue a “certified compliant” verdict." },
											{ k: "No pass/fail score", v: "Real behavioral proof stays with your repo · tests, CI, traces, review." },
											{ k: "No app patching", v: "AADM shapes what agents demand (e.g. “pair mutations with invalidation”). It doesn't patch your branch." },
										].map((item, idx) => (
											<li class="group grid grid-cols-[auto_1fr] items-baseline gap-4 py-4">
												<span class="font-mono-cta text-[11px] text-amber-300/80">{String(idx + 1).padStart(2, "0")}</span>
												<span class="text-sm leading-relaxed">
													<span class="text-white">{item.k}</span>
													<span class="block mt-1 text-slate-400">{item.v}</span>
												</span>
											</li>
										))
									}
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §02 — What Cursor does + Three lanes
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06]">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-violet-200/70">§ 02</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">What Cursor does</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[22ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-black leading-[0.96] tracking-[-0.025em] text-white">
						What Cursor / the AI does.
					</h2>
					<p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-400">
						Cursor and the model can open your project, grep, read files, and change code. That is normal engineering work in
						your workspace — not “AADM certifying” anything.
					</p>
					<p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-400">
						If the model ever said it violated AADM by reading code, that was an over-correction. AADM never says <em>“don't read
						the repo.”</em> It says the MCP isn't the authority that scanned everything — and you shouldn't treat tool output as a
						compliance score without your own evidence.
					</p>

					<div class="mt-16 space-y-px bg-white/[0.08]">
						{
							laneCards.map((lane) => {
								const t = laneToneClasses[lane.tone];
								return (
									<article class="grid grid-cols-12 gap-6 bg-surface-deep px-1 py-10 sm:px-2 sm:py-12">
										<div class="col-span-12 sm:col-span-2">
											<p class:list={["font-display text-[4.5rem] font-extralight leading-[0.85] tracking-tight sm:text-[6rem]", t.numeral]}>
												{lane.num}
											</p>
											<div class:list={["mt-3 inline-flex items-center gap-2 border px-3 py-1.5 font-mono-cta text-[10px] uppercase tracking-[0.22em]", t.chip]}>
												<span class:list={["block h-1.5 w-1.5 rounded-full", t.bullet]}></span>
												{lane.name}
											</div>
										</div>
										<div class="col-span-12 sm:col-span-10">
											<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-500">{lane.line}</p>
											<p class="mt-4 max-w-3xl text-[0.98rem] leading-[1.65] text-slate-200">{lane.body}</p>
										</div>
									</article>
								);
							})
						}
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §03 — Cursor in action (illustrative mock)
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06] bg-[#06080f]" aria-labelledby="cursor-in-action-heading">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-emerald-200/70">§ 03</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Cursor in action</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 id="cursor-in-action-heading" class="font-display text-[clamp(1.7rem,4vw,2.8rem)] font-black leading-[1.05] tracking-[-0.025em] text-white">
						Cursor in action <span class="font-extralight italic text-slate-400">(illustrative).</span>
					</h2>
					<p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-400">
						The transcript is fictional. Real MCP payloads follow{' '}
						<code class="font-mono-cta text-emerald-200/85">tools/list</code> contracts on your server build.
					</p>

					<figure
						class="mt-10 overflow-hidden border border-[#3e3e42] bg-[#181818] shadow-2xl shadow-black/50 ring-1 ring-white/5"
						aria-label="Fictional Cursor editor window showing chat and MCP tool calls"
					>
						<div class="flex items-center gap-3 border-b border-[#2d2d2d] bg-[#1f1f1f] px-3 py-2">
							<div class="flex gap-1.5 pl-1" aria-hidden="true">
								<span class="h-3 w-3 rounded-full bg-[#ff5f57]/90"></span>
								<span class="h-3 w-3 rounded-full bg-[#febc2e]/90"></span>
								<span class="h-3 w-3 rounded-full bg-[#28c840]/90"></span>
							</div>
							<div class="flex min-w-0 flex-1 items-center justify-center gap-2">
								<span class="truncate font-mono-cta text-xs text-slate-400">workspace-api · Cursor</span>
							</div>
							<span class="w-14 shrink-0"></span>
						</div>

						<div class="flex min-h-[520px] flex-col lg:min-h-[560px] lg:flex-row">
							<div class="flex min-w-0 flex-1 flex-col bg-[#1e1e1e]">
								<div class="border-b border-[#2d2d2d] px-4 py-2">
									<p class="font-mono-cta text-[10px] font-medium uppercase tracking-wider text-slate-500">Agent · MCP enabled</p>
									<p class="truncate text-xs text-slate-400">Slice audit · L7 DTO / serialization · Sentinel framing</p>
								</div>

								<div class="flex-1 space-y-4 overflow-y-auto px-4 py-4 font-mono-cta text-[13px] leading-relaxed">
									<div class="flex justify-end">
										<div class="max-w-[92%] border border-sky-400/30 bg-sky-950/40 px-4 py-3 text-sky-100">
											<p class="text-[11px] font-semibold uppercase tracking-wide text-sky-300/80">You</p>
											<p class="mt-1">
												Run a Sentinel-style slice on our workspace API: trace critical fields from request → schema → domain → DB → DTO → JSON response. Flag leakage, rename mismatches, and silent truncation — not just “is auth enforced.” Use AADM MCP for workflow + audit scaffolding.
											</p>
										</div>
									</div>

									<div class="flex justify-start">
										<div class="max-w-[92%] border border-[#333] bg-[#252526] px-4 py-3 text-slate-300">
											<p class="text-[11px] font-semibold uppercase tracking-wide text-violet-300/90">Agent</p>
											<p class="mt-1 text-slate-400">
												On it. I'll pull the orchestrator snapshot, then kick an assurance-shaped audit run so we inherit the section spine and suggested AUTH pulls — then I'll summarize data-flow risks for your team.
											</p>
										</div>
									</div>

									<div class="overflow-hidden border border-emerald-500/30 bg-[#0a1410]">
										<div class="flex items-center gap-2 border-b border-emerald-500/20 bg-emerald-950/35 px-3 py-2">
											<span class="border border-emerald-300/60 bg-transparent px-1.5 py-0.5 font-mono-cta text-[10px] uppercase tracking-wider text-emerald-200">MCP</span>
											<span class="text-[11px] text-emerald-200/80">tools/call</span>
											<code class="text-[12px] text-emerald-300">standard_brief</code>
										</div>
										<pre class="max-h-32 overflow-y-auto p-3 text-[11px] text-slate-400">{`{
  "capabilities_schema_version": "…",
  "sentinel_assurance": { "workflow_id": "assurance", "stages": [ … ] },
  "follow_on_catalog": [ { "id": "audit_run_nl", "suggested_tool": "audit_run" }, … ]
}`}</pre>
									</div>

									<div class="overflow-hidden border border-emerald-500/30 bg-[#0a1410]">
										<div class="flex items-center gap-2 border-b border-emerald-500/20 bg-emerald-950/35 px-3 py-2">
											<span class="border border-emerald-300/60 bg-transparent px-1.5 py-0.5 font-mono-cta text-[10px] uppercase tracking-wider text-emerald-200">MCP</span>
											<span class="text-[11px] text-emerald-200/80">tools/call</span>
											<code class="text-[12px] text-emerald-300">audit_run</code>
										</div>
										<pre class="max-h-36 overflow-y-auto p-3 text-[11px] text-slate-400">{`{
  "request": "Assess workspace API for response leakage, camelCase vs snake_case mismatches, date/string drift in DTOs, and silent batch truncation.",
  "app_name": "Workspace API (illustrative)"
}`}</pre>
									</div>

									<div class="flex justify-start">
										<div class="max-w-[98%] border border-[#333] bg-[#252526] px-4 py-3 text-slate-300">
											<p class="text-[11px] font-semibold uppercase tracking-wide text-violet-300/90">Agent · readout</p>
											<p class="mt-2 text-slate-400">
												Slice readout — framed as <span class="text-slate-200">data-flow</span> bugs (harder than “is the filter present?” enforcement checks):
											</p>
											<div class="mt-3 max-h-52 overflow-y-auto border border-[#3e3e42] bg-[#1e1e1e] p-3 text-[12px]">
												<p class="font-semibold text-amber-200/90">Representative risks (illustrative)</p>
												<ul class="mt-2 list-disc space-y-2 pl-4 text-slate-400">
													<li><span class="text-slate-300">Field leakage</span> — response includes internal-only columns because the list DTO mirrors the persistence model.</li>
													<li><span class="text-slate-300">Format mismatch</span> — <code class="text-sky-300/90">deleted_at</code> stored correctly but serialized as a plain string where clients expect ISO-8601.</li>
													<li><span class="text-slate-300">Silent truncation</span> — batch accepts 100 rows; mapper drops half with no error surface.</li>
												</ul>
												<p class="mt-4 text-slate-500">These are contract / observability problems across hops — not a substitute for gateway AUTH, which still has to be proven in your repo.</p>
												<p class="mt-4 border-t border-[#3e3e42] pt-3 text-[11px] text-slate-500">
													Next: paste the <code class="text-slate-400">coding_agent_markdown</code> brief from a real <code class="text-slate-400">audit_run</code> response, pair it with two HAR or test fixtures, and we'll turn this into repo-specific file paths and fixes — still evidence-first.
												</p>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						<figcaption class="border-t border-[#2d2d2d] bg-[#1f1f1f] px-4 py-2 text-center font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-500">
							Fictional transcript for storytelling
						</figcaption>
					</figure>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §04 — Direct answers (Q&A)
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06]">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-amber-200/70">§ 04</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Direct answers</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display text-[clamp(1.7rem,4vw,2.8rem)] font-black leading-[1.05] tracking-[-0.025em] text-white">
						Common questions, <span class="font-extralight italic text-slate-400">short answers.</span>
					</h2>

					<div class="mt-12 border-t border-white/10">
						{
							qa.map((row, idx) => (
								<article class="group grid grid-cols-12 gap-6 border-b border-white/[0.08] py-8 transition duration-300 hover:bg-white/[0.015]">
									<div class="col-span-12 sm:col-span-4">
										<div class="flex items-baseline gap-3">
											<span class="font-display text-3xl font-extralight leading-none text-white/85 sm:text-4xl">
												{String(idx + 1).padStart(2, "0")}
											</span>
											<span class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-500">Question</span>
										</div>
										<p class="font-display mt-4 text-[1.15rem] font-bold leading-snug tracking-tight text-white sm:text-[1.25rem]">
											{row.q}
										</p>
									</div>
									<div class="col-span-12 sm:col-span-8">
										<div class="border-l border-emerald-300/40 pl-5">
											<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-emerald-200/85">Short answer</p>
											<p class="mt-2 text-[0.95rem] leading-relaxed text-slate-300">{row.a}</p>
										</div>
									</div>
								</article>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §05 — Mental model + CTA
		     ============================================================= -->
		<section class="relative bg-surface-deep">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_bottom,rgba(157,123,245,0.07),transparent_60%)]"></div>
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-violet-200/70">§ 05</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Mental model</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display text-[clamp(1.7rem,4vw,2.8rem)] font-black leading-[1.05] tracking-[-0.025em] text-white">
						Three pieces. <span class="font-extralight italic text-slate-400">Three jobs.</span>
					</h2>

					<div class="mt-12 grid grid-cols-1 gap-px bg-white/[0.08] sm:grid-cols-3">
						{
							[
								{ letter: "A", role: "AADM", body: "Standard + coaching. Defines what “done right” looks like and what to demand from every agent turn.", tone: "violet" },
								{ letter: "B", role: "Your app + CI", body: "Proof. Tests, traces, and review that confirm the branch actually does what AADM coaching demanded.", tone: "emerald" },
								{ letter: "C", role: "Cursor", body: "Editor / agent. Applies the coaching to real code in your workspace — reads, greps, ships the fixes.", tone: "amber" },
							].map((tier) => {
								const c =
									tier.tone === "violet" ? "text-violet-300/90" :
									tier.tone === "emerald" ? "text-emerald-300/90" :
									"text-amber-300/90";
								return (
									<article class="group bg-surface-deep p-6 transition duration-300 hover:bg-[#0a0e1a] sm:p-8">
										<div class="flex items-baseline gap-4">
											<span class:list={["font-display text-[3.5rem] font-extralight leading-[0.85]", c]}>
												{tier.letter}
											</span>
											<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-500">{tier.role}</p>
										</div>
										<p class="mt-6 text-sm leading-relaxed text-slate-400">{tier.body}</p>
									</article>
								);
							})
						}
					</div>

					<p class="mt-10 max-w-3xl text-sm leading-relaxed text-slate-500">
						Model inconsistency (e.g. <em>“gaps don't exist”</em> from a line read, then <em>“I shouldn't verify in code”</em>) is
						not a faithful reading of AADM. The standard asks for behavioral proof — not permission to avoid reading your repo.
					</p>

					<div class="mt-14 flex flex-col flex-wrap items-start gap-4 sm:flex-row sm:items-center sm:gap-5">
						<a
							href={urlMcpMarketing}
							class="group inline-flex items-center gap-3 bg-white px-7 py-4 text-sm font-semibold tracking-tight text-slate-950 outline-none transition duration-200 hover:bg-emerald-200 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>Get MCP access</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href="/claude-code"
							class="inline-flex items-center gap-2 border border-white/20 bg-transparent px-7 py-4 text-sm font-semibold text-white outline-none transition duration-200 hover:border-white/40 hover:bg-white/[0.04] focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							AADM + Claude Code →
						</a>
						<a
							href="/why-aadm"
							class="group font-mono-cta inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-slate-400 underline decoration-slate-700 underline-offset-[6px] transition hover:text-amber-200 hover:decoration-amber-300"
						>
							<span>Why AADM, vs raw loops</span>
							<span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
