---
import Layout from "../layouts/Layout.astro";
import { getSiteUrlConfig } from "../lib/site-urls";

const { urlStandard, urlMcpMarketing, urlMcpRpcUrl } = getSiteUrlConfig(
	import.meta.env,
);

const universalSnippet = `{
  "mcpServers": {
    "aadm": {
      "type": "http",
      "url": "${urlMcpRpcUrl}",
      "headers": {
        "Authorization": "Bearer <your token here>"
      }
    }
  }
}`;

type Ide = {
	letter: string;
	name: string;
	tagline: string;
	body: string;
	auth: "bearer" | "oauth" | "either";
	bestFor: string;
	configPath?: string;
	cta: { label: string; href: string };
	tone: "amber" | "violet" | "sky" | "emerald" | "slate";
};

const aiNative: Ide[] = [
	{
		letter: "A",
		name: "Claude Code (terminal)",
		tagline: "CLI · IDE-adjacent",
		body: "Runs against your working tree — read, search, diff, test, multi-step refactors. Ideal for Investigator loops where MCP supplies gates and the CLI supplies evidence.",
		auth: "either",
		bestFor: "Long debugging sessions, code-first agent work",
		configPath: "~/.claude.json",
		cta: { label: "Setup guide", href: "/claude-code" },
		tone: "amber",
	},
	{
		letter: "B",
		name: "Claude Desktop",
		tagline: "GUI",
		body: "Best for docs-centric sessions, walking stakeholders through standard_brief outputs, and paste-style debugging from logs and HAR excerpts.",
		auth: "either",
		bestFor: "Planning, stakeholder review, doctrine reading",
		configPath: "claude_desktop_config.json",
		cta: { label: "Setup guide", href: "/claude-code" },
		tone: "amber",
	},
	{
		letter: "C",
		name: "Cursor",
		tagline: "AI-native editor",
		body: "Standard as coaching, Cursor as editor. AADM loads workflows and gates over MCP; Cursor opens your project and applies them to real code.",
		auth: "bearer",
		bestFor: "Day-to-day feature work and refactoring",
		configPath: "~/.cursor/mcp.json",
		cta: { label: "Setup guide", href: "/cursor" },
		tone: "violet",
	},
	{
		letter: "D",
		name: "Windsurf",
		tagline: "AI-native editor",
		body: "Wires the same Streamable HTTP MCP — paste the universal snippet into the IDE's MCP settings. Check Windsurf's MCP docs for any current overrides.",
		auth: "bearer",
		bestFor: "Cursor alternatives, multi-agent workflows",
		cta: { label: "Use universal snippet", href: "#universal" },
		tone: "violet",
	},
];

const vscodeExtensions: Ide[] = [
	{
		letter: "E",
		name: "Cline (VS Code)",
		tagline: "Extension",
		body: "Open-source agentic coding extension for VS Code. Adds AADM MCP via its MCP servers panel — paste the universal snippet and reload.",
		auth: "bearer",
		bestFor: "VS Code users who want agent loops without leaving the editor",
		cta: { label: "Use universal snippet", href: "#universal" },
		tone: "sky",
	},
	{
		letter: "F",
		name: "Continue (VS Code / JetBrains)",
		tagline: "Extension",
		body: "Continue's MCP support is evolving — check the latest docs for whether Streamable HTTP servers are configured via mcpServers JSON or the GUI. Universal snippet is the starting point.",
		auth: "bearer",
		bestFor: "Teams already on Continue who want governed lanes",
		cta: { label: "Use universal snippet", href: "#universal" },
		tone: "sky",
	},
];

const general: Ide[] = [
	{
		letter: "G",
		name: "JetBrains AI Assistant",
		tagline: "JetBrains IDEs",
		body: "MCP support landed in recent JetBrains AI Assistant releases. Configure the AADM server via the Settings → AI Assistant → MCP panel using the universal snippet.",
		auth: "bearer",
		bestFor: "IntelliJ, PyCharm, GoLand, Rider, WebStorm users",
		cta: { label: "Use universal snippet", href: "#universal" },
		tone: "emerald",
	},
	{
		letter: "H",
		name: "Zed",
		tagline: "Editor",
		body: "Zed's assistant supports MCP servers. Add AADM via the Zed settings (context servers) using the same Streamable HTTP URL and Bearer header pattern.",
		auth: "bearer",
		bestFor: "Performance-focused editor users",
		cta: { label: "Use universal snippet", href: "#universal" },
		tone: "emerald",
	},
];

const webHeadless: Ide[] = [
	{
		letter: "I",
		name: "claude.ai · Connectors",
		tagline: "Web · custom connector",
		body: "Settings → Connectors → Add custom connector. Server URL and OAuth required — paste your client ID from the AADM member area. Don't use an API key here.",
		auth: "oauth",
		bestFor: "claude.ai web users who want AADM tools in chat",
		cta: { label: "OAuth setup", href: "/mcp#connect-oauth" },
		tone: "violet",
	},
	{
		letter: "J",
		name: "curl · raw HTTP",
		tagline: "CI · scripts · anything",
		body: "Streamable HTTP is just JSON-RPC over POST. Anything that can send an Authorization header and accept SSE can call the MCP — CI checks, custom orchestrators, your own glue.",
		auth: "bearer",
		bestFor: "Build pipelines, custom hosts, smoke tests",
		cta: { label: "Smoke test snippet", href: "/mcp#technical" },
		tone: "slate",
	},
];

const toneClasses: Record<
	Ide["tone"],
	{ letter: string; chip: string; rule: string }
> = {
	amber: {
		letter: "text-brand-warn",
		chip: "border-brand-warn-border text-brand-warn",
		rule: "border-brand-warn-border",
	},
	violet: {
		letter: "text-brand-violet",
		chip: "border-violet-400/30 text-brand-violet",
		rule: "border-violet-400/40",
	},
	sky: {
		letter: "text-brand-sky",
		chip: "border-sky-400/30 text-brand-sky",
		rule: "border-sky-400/40",
	},
	emerald: {
		letter: "text-brand-mcp",
		chip: "border-emerald-400/30 text-brand-mcp",
		rule: "border-emerald-400/40",
	},
	slate: {
		letter: "text-text-secondary/90",
		chip: "border-slate-300/30 text-foreground",
		rule: "border-slate-300/40",
	},
};

type Group = {
	num: string;
	title: string;
	tagline: string;
	ides: Ide[];
	aside: string;
};

const groups: Group[] = [
	{
		num: "01",
		title: "AI-native editors",
		tagline: "Agent loops built in",
		aside:
			"Native chat + tool calls. Pasting the MCP snippet wires AADM directly into the agent.",
		ides: aiNative,
	},
	{
		num: "02",
		title: "VS Code extensions",
		tagline: "Editor you already use",
		aside:
			"Bring AADM into VS Code via an extension's MCP servers panel — no editor switch required.",
		ides: vscodeExtensions,
	},
	{
		num: "03",
		title: "General editors",
		tagline: "JetBrains · Zed · more",
		aside:
			"IDEs whose AI assistants support MCP servers. The universal snippet is the starting point.",
		ides: general,
	},
	{
		num: "04",
		title: "Web · headless · scripts",
		tagline: "Not an IDE — still works",
		aside:
			"claude.ai Connectors (web) and raw curl (CI, custom hosts). Both speak the same Streamable HTTP wire.",
		ides: webHeadless,
	},
];

const totalIdes =
	aiNative.length +
	vscodeExtensions.length +
	general.length +
	webHeadless.length;
---

<Layout
	title="AADM — every MCP-capable IDE, same wire"
	description="Cursor, Claude Code, Windsurf, Cline, Continue, JetBrains AI, Zed, claude.ai Connectors, raw curl — every MCP-capable client connects to AADM over Streamable HTTP."
	headerActiveNav="ides"
>
	<main id="main" class="relative isolate overflow-x-clip bg-surface-deep text-text-primary">

		<!-- =============================================================
		     §00 — Hero
		     ============================================================= -->
		<section class="relative border-b border-border">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[length:28px_28px] [mask-image:radial-gradient(ellipse_at_top,black_55%,transparent_85%)]"></div>
			<div aria-hidden="true" class="absolute right-0 top-0 -z-10 h-[36rem] w-[36rem] translate-x-1/3 -translate-y-1/3 rounded-full bg-emerald-500/[0.07] blur-3xl"></div>
			<div aria-hidden="true" class="absolute left-0 top-40 -z-10 h-[32rem] w-[32rem] -translate-x-1/3 rounded-full bg-violet-500/[0.06] blur-3xl"></div>

			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 pb-20 pt-10 sm:px-8 sm:pb-28 sm:pt-16">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ 00</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">IDEs</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<p class="font-mono-cta mb-10 text-[13px] normal-case tracking-[0.01em] text-muted-foreground">
						<span class="text-brand-mcp">▸</span> {totalIdes} clients · one Streamable HTTP endpoint · no per-team forks
					</p>

					<h1 class="font-display max-w-[18ch] text-balance text-[clamp(2.4rem,8vw,6.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						Any MCP-capable IDE. <span class="font-light italic text-muted-foreground"> Same standard.</span><br />
						<span class="relative inline-block">
							<span class="relative z-10 text-brand-mcp">Same wire.</span>
							<span aria-hidden="true" class="absolute inset-x-0 bottom-[0.1em] -z-0 h-[0.18em] bg-emerald-300/30"></span>
						</span>
					</h1>

					<div class="mt-14 grid grid-cols-12 gap-6">
						<div class="col-span-12 sm:col-span-4">
							<div class="border-l border-brand-mcp-border pl-5">
								<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">The wire</p>
								<p class="mt-3 text-[0.95rem] leading-relaxed text-text-secondary">
									One endpoint, one transport, one config. Cursor, Claude Code, Windsurf, Cline, JetBrains AI, Zed,
									claude.ai Connectors, even raw curl — they all paste the same MCP server URL.
								</p>
							</div>
						</div>
						<div class="col-span-12 sm:col-span-8">
							<p class="text-pretty text-lg leading-[1.65] text-text-secondary sm:text-xl">
								AADM is delivered over <span class="text-foreground">Streamable HTTP MCP</span>. Anything that can speak the protocol
								gets the same workflows, gates, doctrine, and tools — so your team's discipline is no longer
								<span class="font-light italic text-muted-foreground"> per-engineer or per-editor.</span>
							</p>
							<p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted-foreground">
								The harness is the part of the stack that decides what your agent can actually run.{' '}
								<a
									href="/about"
									class="font-semibold text-text-secondary underline decoration-border underline-offset-4 transition hover:text-brand-mcp hover:decoration-brand-mcp"
									>Agentic engineering</a
								>{' '}
								covers why swapping harnesses should change nothing about how the work is governed.
							</p>
						</div>
					</div>

					<div class="mt-14 flex flex-col flex-wrap items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
						<a
							href="#universal"
							class="group inline-flex items-center gap-3 bg-foreground px-6 py-3.5 text-sm font-semibold tracking-tight text-background outline-none transition duration-200 hover:bg-brand-mcp hover:text-brand-mcp-fg focus-visible:ring-2 focus-visible:ring-brand-mcp focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>The universal snippet</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href={urlMcpMarketing}
							class="inline-flex items-center gap-2 border border-border bg-transparent px-6 py-3.5 text-sm font-semibold text-foreground outline-none transition duration-200 hover:border-foreground/25 hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							Get access
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §UNIVERSAL — The one snippet to rule them all
		     ============================================================= -->
		<section id="universal" class="relative scroll-mt-24 border-b border-border bg-surface-mid sm:scroll-mt-28">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-20 sm:px-8 sm:py-24">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ U</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Universal snippet</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display text-[clamp(1.7rem,4vw,2.8rem)] font-bold leading-[1.05] tracking-[-0.01em] text-foreground">
						One snippet, <span class="font-light italic text-muted-foreground">every IDE.</span>
					</h2>
					<p class="mt-4 max-w-3xl text-base leading-relaxed text-muted-foreground">
						This is the canonical config. Most MCP-capable clients take this verbatim under their
						<code class="font-mono-cta text-brand-mcp"> mcpServers</code> key. Edit the<span class="text-foreground"> Authorization</span>
						header with your token.
					</p>

					<div class="mt-10 grid grid-cols-12 gap-6">
						<div class="col-span-12 lg:col-span-7">
							<div class="border border-border bg-surface-mid">
								<div class="flex items-center justify-between border-b border-border px-5 py-3">
									<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">mcpServers.aadm</span>
									<button
										type="button"
										id="universal-copy-btn"
										class="font-mono-cta border border-border bg-transparent px-3 py-1.5 text-[13px] normal-case tracking-[0.01em] text-foreground transition hover:border-foreground/25 hover:bg-accent"
									>
										Copy JSON
									</button>
								</div>
								<pre class="font-mono-cta overflow-x-auto p-5 text-xs leading-relaxed text-text-secondary sm:text-sm"><code id="universal-code">{universalSnippet}</code></pre>
							</div>
						</div>
						<div class="col-span-12 lg:col-span-5">
							<div class="border-l-2 border-brand-mcp-border pl-6">
								<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">Three universal rules</p>
								<ul class="mt-5 divide-y divide-white/[0.06] border-t border-border">
									<li class="grid grid-cols-[auto_1fr] items-baseline gap-3 py-3">
										<span class="font-mono-cta text-sm text-brand-mcp">01</span>
										<span class="text-sm leading-relaxed text-text-secondary">
											The URL must include <code class="font-mono-cta text-xs text-brand-mcp">/mcp</code>.
										</span>
									</li>
									<li class="grid grid-cols-[auto_1fr] items-baseline gap-3 py-3">
										<span class="font-mono-cta text-sm text-brand-mcp">02</span>
										<span class="text-sm leading-relaxed text-text-secondary">
											<code class="font-mono-cta text-xs text-brand-mcp">type: http</code> means Streamable HTTP, not stdio.
										</span>
									</li>
									<li class="grid grid-cols-[auto_1fr] items-baseline gap-3 py-3">
										<span class="font-mono-cta text-sm text-brand-mcp">03</span>
										<span class="text-sm leading-relaxed text-text-secondary">
											Use <code class="font-mono-cta text-xs text-brand-mcp">Bearer ak_…</code> for API keys,
											or just <code class="font-mono-cta text-xs text-brand-mcp">aadm_…</code> for dashboard tokens.
										</span>
									</li>
								</ul>
								<p class="mt-5 text-xs leading-relaxed text-muted-foreground">
									Some clients (claude.ai, Claude Code) prefer OAuth instead — see{' '}
									<a href="/mcp#connect-oauth" class="text-brand-mcp underline decoration-brand-mcp underline-offset-4 hover:decoration-brand-mcp">OAuth setup</a>.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<script is:inline>
			(function () {
				const btn = document.getElementById('universal-copy-btn');
				const code = document.getElementById('universal-code');
				if (!btn || !code) return;
				const def = btn.textContent || 'Copy JSON';
				btn.addEventListener('click', async function () {
					const t = (code.textContent || '').trim();
					try { await navigator.clipboard.writeText(t); btn.textContent = 'Copied!'; window.setTimeout(function() { btn.textContent = def; }, 2200); } catch { btn.textContent = 'Copy blocked'; window.setTimeout(function() { btn.textContent = def; }, 3000); }
				});
			})();
		</script>

		<!-- =============================================================
		     §01..§04 — IDE groups
		     ============================================================= -->
		{
			groups.map((g, groupIdx) => (
				<section
					class:list={[
						"relative border-b border-border",
						groupIdx % 2 === 0 ? "" : "bg-surface-mid",
					]}
				>
					<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:py-32 sm:px-8 sm:py-32">
						<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
							<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ {g.num}</span>
							<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">{g.tagline}</span>
						</aside>

						<div class="col-span-12 sm:col-span-10">
							<h2 class="font-display max-w-[24ch] text-[clamp(1.7rem,4vw,2.8rem)] font-bold leading-[1.05] tracking-[-0.01em] text-foreground">
								{g.title}.
							</h2>
							<p class="mt-4 max-w-3xl text-base leading-relaxed text-muted-foreground">{g.aside}</p>

							<ul class="mt-14 grid grid-cols-1 gap-px bg-white/[0.08] sm:grid-cols-2">
								{
									g.ides.map((ide) => {
										const t = toneClasses[ide.tone];
										return (
											<li
												class:list={[
													"group flex flex-col p-6 transition duration-300 hover:bg-secondary sm:p-8",
													groupIdx % 2 === 0 ? "bg-surface-deep" : "bg-surface-mid",
												]}
											>
												<div class="flex items-baseline gap-4">
													<span class:list={["font-display text-[3.5rem] font-light leading-[0.85]", t.letter]}>{ide.letter}</span>
													<div>
														<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">{ide.tagline}</p>
														<h3 class="font-display mt-1 text-xl font-bold leading-snug tracking-tight text-foreground sm:text-2xl">{ide.name}</h3>
													</div>
												</div>
												<p class="mt-6 text-[0.95rem] leading-relaxed text-text-secondary">{ide.body}</p>

												<div class:list={["mt-6 border-l pl-4", t.rule]}>
													<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Best for</p>
													<p class="mt-1.5 text-sm leading-relaxed text-text-secondary">{ide.bestFor}</p>
												</div>

												<div class="mt-5 flex flex-wrap gap-1.5">
													<span class:list={["border px-2 py-0.5 font-mono-cta text-[13px] normal-case tracking-[0.01em]", t.chip]}>
														{ide.auth === "bearer" ? "Bearer · ak_" : ide.auth === "oauth" ? "OAuth" : "Bearer · OAuth"}
													</span>
													{ide.configPath ? (
														<span class="border border-border bg-transparent px-2 py-0.5 font-mono-cta text-[13px] text-muted-foreground">
															{ide.configPath}
														</span>
													) : null}
												</div>

												<div class="mt-auto pt-6">
													<a
														href={ide.cta.href}
														class:list={[
															"group/cta font-mono-cta inline-flex items-center gap-2 text-sm normal-case tracking-[0.01em] underline decoration-white/20 underline-offset-[6px] transition",
															t.letter.replace("/85", "").replace("/90", ""),
															"hover:decoration-brand-mcp",
														]}
													>
														<span>{ide.cta.label}</span>
														<span aria-hidden="true" class="transition group-hover/cta:translate-x-0.5">→</span>
													</a>
												</div>
											</li>
										);
									})
								}
							</ul>
						</div>
					</div>
				</section>
			))
		}

		<!-- =============================================================
		     §05 — Universal pattern
		     ============================================================= -->
		<section class="relative border-b border-border">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:py-32 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ 05</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Setup pattern</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[24ch] text-[clamp(1.7rem,4vw,2.8rem)] font-bold leading-[1.05] tracking-[-0.01em] text-foreground">
						Same three steps, <span class="font-light italic text-muted-foreground">every time.</span>
					</h2>

					<ol class="mt-14 grid grid-cols-1 gap-px bg-white/[0.08] sm:grid-cols-3">
						{
							[
								{ num: "01", t: "Pick Bearer or OAuth", b: "Bearer: an ak_… key from Member area → API keys. OAuth: just the server URL — your client opens the AADM sign-in page.", link: { label: "Member area", href: "/mcp#two-ways" } },
								{ num: "02", t: "Paste the snippet", b: "Drop the universal mcpServers.aadm block into the IDE's MCP settings file or panel.", link: { label: "Universal snippet", href: "#universal" } },
								{ num: "03", t: "Reload", b: "Restart the IDE (or restart the MCP) so tools/list picks up the AADM server. Ask the agent for standard_brief to confirm.", link: { label: "Tools catalog", href: "/tools" } },
							].map((s) => (
								<li class="bg-surface-deep p-7 sm:p-9">
									<div class="flex items-baseline gap-4">
										<span class="font-display text-5xl font-light leading-none text-brand-mcp sm:text-6xl">{s.num}</span>
									</div>
									<h3 class="font-display mt-6 text-balance text-lg font-bold leading-snug tracking-tight text-foreground sm:text-xl">{s.t}</h3>
									<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{s.b}</p>
									<p class="mt-5">
										<a href={s.link.href} class="group font-mono-cta inline-flex items-center gap-2 text-sm normal-case tracking-[0.01em] text-brand-mcp underline decoration-brand-mcp underline-offset-[6px] hover:decoration-brand-mcp">
											<span>{s.link.label}</span>
											<span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
										</a>
									</p>
								</li>
							))
						}
					</ol>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §06 — Final CTA
		     ============================================================= -->
		<section class="relative bg-surface-deep">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_bottom,rgba(110,231,183,0.07),transparent_60%)]"></div>
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:py-32 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ 06</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Start here</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[18ch] text-balance text-[clamp(2rem,5.5vw,4.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						Pick an IDE. <span class="font-light italic text-muted-foreground">Paste a snippet.</span><br />
						<span class="relative inline-block">
							<span class="relative z-10 text-brand-mcp">Ship governed.</span>
							<span aria-hidden="true" class="absolute inset-x-0 bottom-[0.1em] -z-0 h-[0.18em] bg-emerald-300/30"></span>
						</span>
					</h2>
					<p class="mt-6 max-w-2xl text-base leading-relaxed text-text-secondary">
						The standard is free. The hosted MCP is a subscription. The IDE you already use is the one that connects.
					</p>

					<div class="mt-14 flex flex-col flex-wrap items-start gap-4 sm:flex-row sm:items-center sm:gap-5">
						<a
							href={urlMcpMarketing}
							class="group inline-flex items-center gap-3 bg-foreground px-7 py-4 text-sm font-semibold tracking-tight text-background outline-none transition duration-200 hover:bg-brand-mcp hover:text-brand-mcp-fg focus-visible:ring-2 focus-visible:ring-brand-mcp focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>See how the MCP works</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href={urlStandard}
							class="inline-flex items-center gap-2 border border-border bg-transparent px-7 py-4 text-sm font-semibold text-foreground outline-none transition duration-200 hover:border-foreground/25 hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							Read the standard
						</a>
						<a
							href="/tools"
							class="group font-mono-cta inline-flex items-center gap-2 text-sm normal-case tracking-[0.01em] text-muted-foreground underline decoration-border underline-offset-[6px] transition hover:text-brand-mcp hover:decoration-brand-mcp"
						>
							<span>Browse the tools catalog</span>
							<span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
						</a>
						<a
							href="/stacks"
							class="group font-mono-cta inline-flex items-center gap-2 text-sm normal-case tracking-[0.01em] text-muted-foreground underline decoration-border underline-offset-[6px] transition hover:text-brand-mcp hover:decoration-brand-mcp"
						>
							<span>See compatible stacks</span>
							<span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
						</a>
					</div>

					<!-- Colophon -->
					<div class="mt-24 grid grid-cols-12 gap-6 border-t border-border pt-8 font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">
						<div class="col-span-12 sm:col-span-4">
							<span class="text-muted-foreground">Clients listed</span> · {totalIdes}
						</div>
						<div class="col-span-12 sm:col-span-4">
							<span class="text-muted-foreground">Transport</span> · <span class="text-brand-mcp">Streamable HTTP / MCP</span>
						</div>
						<div class="col-span-12 sm:col-span-4">
							<span class="text-muted-foreground">Endpoint</span> · <span class="text-brand-mcp">{urlMcpRpcUrl}</span>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
