---
import Layout from "../layouts/Layout.astro";
import { getSiteUrlConfig } from "../lib/site-urls";

const {
	urlStandard,
	urlMcpMarketing,
	aadmConfigSchemaUrl: schemaUrl,
} = getSiteUrlConfig(import.meta.env);

const initCmd = `npx aadm-init-repo --full`;
const initMinimal = `npx aadm-init-repo --minimal`;

const verifyNoShadow = `ls /usr/local/bin/aadm-init-repo 2>/dev/null && echo "REMOVE THIS" || echo "OK"`;

const fixPermission = `sudo rm -f /usr/local/bin/aadm-init-repo
sudo rm -rf /usr/local/lib/node_modules/aadm-mcp`;

const multiRepo = `cd ~/projects/repo-a && npx aadm-init-repo --full
cd ~/projects/repo-b && npx aadm-init-repo --full
npx aadm-init-repo --full --target=~/projects/repo-c`;

/** Paste into Cursor / Claude Code with this repo open after \`npx aadm-init-repo --full\`. */
const customizeAgentPrompt = `You are customizing AADM governance for THIS repository only.

1. Read \`.aadm/config.json\` at the repo root (created by \`npx aadm-init-repo --full\`).
2. Inspect the real codebase layout (app/, src/, lib/, packages/, server/, etc.) and update \`udali_ownership.patterns\` so each UDALI band points at actual paths—not template placeholders like generic \`src/**\` or \`src/adapter/**\`.
3. Replace placeholder org/team strings (@org/..., example team slugs) with values that match this repo, or remove blocks we do not use yet.
4. In \`auth_ownership\` and \`seam_ownership\`, keep only AUTH-XX / SEAM-XX entries that apply to this product; fix or drop template IDs that do not match our stack.
5. In \`metadata\`: set accurate \`repo_name\`, \`primary_language\`, and \`description\` for this app.
6. Leave \`\${AADM_TOKEN}\` (or the template token placeholder) in the JSON—do NOT paste real API keys into \`.aadm/config.json\`. Secrets belong only in IDE MCP settings (~/.cursor/mcp.json).
7. Do not delete entire top-level sections unless they are clearly unused; prefer tightening placeholders over gutting the file.
8. When done, give me a short markdown summary: what you changed, what you left as TODO, and any paths you were unsure about.

Work in the open repo. Propose edits to \`.aadm/config.json\` only after you have grep/read evidence for folder structure. Do not run init again unless I ask.`;
---

<Layout
	title="AADM governance — init your repo"
	description="Optional. Run npx aadm-init-repo to create .aadm/config.json, then customize it for your codebase. The hosted MCP works fine without it."
	headerActiveNav="mcp"
>
	<main id="main" class="relative isolate overflow-x-clip bg-surface-deep text-text-primary">

		<!-- =============================================================
		     §00 — Hero
		     ============================================================= -->
		<section class="relative border-b border-border">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[length:28px_28px] [mask-image:radial-gradient(ellipse_at_top,black_55%,transparent_85%)]"></div>
			<div aria-hidden="true" class="absolute right-0 top-0 -z-10 h-[36rem] w-[36rem] translate-x-1/3 -translate-y-1/3 rounded-full bg-emerald-500/[0.06] blur-3xl"></div>

			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 pb-20 pt-10 sm:px-8 sm:pb-28 sm:pt-16">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ 00</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Governance</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<p class="font-mono-cta mb-10 text-[13px] normal-case tracking-[0.01em] text-muted-foreground">
						<span class="text-brand-warn">▸</span> Optional · the hosted MCP works fine without this
					</p>

					<h1 class="font-display max-w-[18ch] text-balance text-[clamp(2.4rem,8vw,6.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						Init your <span class="font-light italic text-muted-foreground">repo.</span>
					</h1>

					<div class="mt-14 grid grid-cols-12 gap-6">
						<div class="col-span-12 sm:col-span-4">
							<div class="border-l border-brand-warn-border pl-5">
								<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-warn">When to use this</p>
								<p class="mt-3 text-[0.95rem] leading-relaxed text-text-secondary">
									Only when you want a versioned <code class="font-mono-cta text-brand-warn">.aadm/config.json</code>
									in an application repo — <a href="/about#udali" class="text-brand-warn underline decoration-brand-warn underline-offset-4 hover:decoration-brand-warn">UDALI</a> paths, lane defaults, CI stubs. Skip otherwise.
								</p>
							</div>
						</div>
						<div class="col-span-12 sm:col-span-8">
							<p class="text-pretty text-lg leading-[1.65] text-text-secondary sm:text-xl">
								Run this in <span class="text-foreground">your application project</span> — not the MCP server repo. From the folder
								where you want <code class="font-mono-cta text-brand-mcp">.aadm/config.json</code> to live. Per-repo, not
								<span class="font-light italic text-muted-foreground"> per-laptop.</span>
							</p>
						</div>
					</div>

					<!-- Pre-check -->
					<div class="mt-14 border border-brand-warn-border bg-amber-950/[0.12] p-6">
						<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-warn">
							<span class="text-brand-warn">▸</span> Before init · run this once
						</p>
						<p class="mt-3 text-sm leading-relaxed text-text-secondary">
							Must print <code class="font-mono-cta text-brand-warn">OK</code>. If it says
							<code class="font-mono-cta text-red-300/90">REMOVE THIS</code>, run the cleanup further down first.
						</p>
						<pre class="font-mono-cta mt-4 overflow-x-auto border border-border bg-surface-mid p-4 text-xs text-text-secondary sm:text-sm"><code>{verifyNoShadow}</code></pre>
					</div>

					<!-- Init command -->
					<div class="mt-10">
						<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">
							<span class="text-brand-mcp">▸</span> The init command
						</p>
						<pre class="font-mono-cta mt-4 overflow-x-auto border border-brand-mcp-border bg-surface-mid p-6 text-base leading-relaxed text-brand-mcp sm:text-lg"><code>{initCmd}</code></pre>
						<p class="mt-4 text-sm text-muted-foreground">
							Faster template · <code class="font-mono-cta text-text-secondary">{initMinimal}</code> · npm package{' '}
							<a href="https://www.npmjs.com/package/aadm-init-repo" class="text-brand-mcp underline decoration-brand-mcp underline-offset-4 hover:decoration-brand-mcp" rel="noopener noreferrer" target="_blank">
								aadm-init-repo
							</a>
							· Node 22+
						</p>
						<p class="mt-4 max-w-3xl text-sm text-muted-foreground">
							Edit the JSON for <span class="text-text-secondary">your</span> paths and teams. Don't ship the template{' '}
							<code class="font-mono-cta text-text-secondary">src/adapter/**</code> defaults.
							<a href="#customize" class="ml-2 text-brand-mcp underline decoration-brand-mcp underline-offset-4 hover:decoration-brand-mcp">
								Customize checklist ↓
							</a>
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §01 — Many repos
		     ============================================================= -->
		<section
			id="many-repos"
			class="relative border-b border-border bg-surface-mid"
			aria-labelledby="many-repos-heading"
		>
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:py-32 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ 01</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Many repos</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 id="many-repos-heading" class="font-display max-w-[22ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						One machine. <span class="font-light italic text-muted-foreground">Many repos.</span>
					</h2>
					<p class="mt-5 max-w-3xl text-base leading-relaxed text-muted-foreground">
						Init is <span class="text-foreground">per repository</span>, not per laptop. Each project gets its own{' '}
						<code class="font-mono-cta text-brand-mcp">.aadm/config.json</code>, hooks, and workflow stub under that repo's
						root. Run the command once per app — customize each file for that codebase.
					</p>

					<pre class="font-mono-cta mt-10 overflow-x-auto border border-border bg-surface-mid p-5 text-sm text-text-secondary"><code>{multiRepo}</code></pre>

					<ul class="mt-14 grid grid-cols-1 gap-px bg-white/[0.08] sm:grid-cols-3">
						{
							[
								{ num: "A", title: "IDE MCP", body: "One connection in ~/.cursor/mcp.json (or Claude equivalent) points at hosted AADM for all repos." },
								{ num: "B", title: "Governance", body: "Each repo's agents read the .aadm/config.json next to the code you have open." },
								{ num: "C", title: "Re-init", body: "Use --force only inside the repo you mean to overwrite." },
							].map((item) => (
								<li class="bg-surface-mid p-6 sm:p-7">
									<div class="flex items-baseline gap-4">
										<span class="font-display text-[3rem] font-light leading-[0.85] text-brand-mcp">{item.num}</span>
									</div>
									<h3 class="font-display mt-6 text-balance text-base font-bold leading-snug tracking-tight text-foreground">
										{item.title}
									</h3>
									<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.body}</p>
								</li>
							))
						}
					</ul>

					<div class="mt-16 border-l-2 border-brand-warn-border pl-6">
						<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-warn">Permission denied?</p>
						<p class="mt-3 text-sm text-text-secondary">One-time machine fix (stale global install), then rerun init:</p>
						<pre class="font-mono-cta mt-4 max-w-md overflow-x-auto border border-border bg-surface-mid p-4 text-xs text-text-secondary"><code>{fixPermission}</code></pre>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §02 — Customize
		     ============================================================= -->
		<section id="customize" class="relative border-b border-border" aria-labelledby="customize-heading">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:py-32 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-violet">§ 02</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">After init</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 id="customize-heading" class="font-display max-w-[22ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						After init. <span class="font-light italic text-muted-foreground">Customize.</span>
					</h2>
					<p class="mt-5 max-w-3xl text-base leading-relaxed text-muted-foreground">
						The init command scaffolds a template. Replace the placeholder paths and teams with yours — the agent will help.
					</p>

					<ul class="mt-14 divide-y divide-white/[0.06] border-y border-border">
						{
							[
								{ num: "01", body: <>Map <code class="font-mono-cta text-xs text-brand-violet">udali_ownership.patterns</code> to real folders (<code class="font-mono-cta text-xs text-text-secondary">app/</code>, <code class="font-mono-cta text-xs text-text-secondary">lib/</code>, …).</> },
								{ num: "02", body: <>Replace placeholder GitHub teams and AUTH/SEAM entries with yours.</> },
								{ num: "03", body: <>Keep <code class="font-mono-cta text-xs text-brand-mcp">{"${AADM_TOKEN}"}</code> in config. Put the real token in IDE MCP settings only.</> },
								{ num: "04", body: <>Connect hosted MCP · <a href={urlMcpMarketing} class="text-brand-mcp underline decoration-brand-mcp underline-offset-4 hover:decoration-brand-mcp">aadm.io/mcp</a></> },
							].map((s) => (
								<li class="group grid grid-cols-[auto_1fr] items-baseline gap-5 py-4">
									<span class="font-mono-cta text-sm text-brand-violet">{s.num}</span>
									<span class="text-sm leading-relaxed text-text-secondary transition group-hover:text-foreground">{s.body}</span>
								</li>
							))
						}
					</ul>

					<!-- Agent prompt -->
					<div class="mt-14 border border-violet-400/30 bg-muted" aria-labelledby="customize-prompt-heading">
						<div class="flex flex-wrap items-start justify-between gap-4 border-b border-border px-7 py-5 sm:px-8">
							<div>
								<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-violet">Agent prompt</p>
								<h3 id="customize-prompt-heading" class="font-display mt-2 text-xl font-bold text-foreground sm:text-2xl">
									Customize this repo
								</h3>
								<p class="mt-3 max-w-2xl text-sm text-muted-foreground">
									Open one app repo in Cursor or Claude Code, then paste this into chat. The agent will edit{' '}
									<code class="font-mono-cta text-xs text-text-secondary">.aadm/config.json</code> using your real folder layout.
								</p>
							</div>
							<button
								type="button"
								id="governance-customize-copy-btn"
								class="font-mono-cta shrink-0 border border-border bg-transparent px-3 py-1.5 text-[13px] normal-case tracking-[0.01em] text-foreground transition hover:border-foreground/25 hover:bg-accent"
							>
								Copy prompt
							</button>
						</div>
						<pre
							class="font-mono-cta max-h-80 overflow-y-auto overflow-x-auto p-6 text-xs leading-relaxed text-text-secondary sm:text-sm"
							id="governance-customize-prompt-pre"
							role="region"
							aria-label="Customize AADM config agent prompt"
						><code id="governance-customize-prompt-code">{customizeAgentPrompt}</code></pre>
					</div>

					<div class="mt-14 grid grid-cols-1 gap-px bg-white/[0.08] sm:grid-cols-2">
						<a href={schemaUrl} class="group bg-surface-deep p-7 transition duration-300 hover:bg-surface-mid sm:p-8" target="_blank" rel="noopener noreferrer">
							<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">Reference</p>
							<h3 class="font-display mt-3 text-xl font-bold text-foreground">Config JSON Schema</h3>
							<p class="mt-3 text-sm leading-relaxed text-muted-foreground">The authoritative schema for <code class="font-mono-cta text-xs text-brand-mcp">.aadm/config.json</code>.</p>
							<span class="font-mono-cta mt-6 inline-flex items-center gap-2 text-sm normal-case tracking-[0.01em] text-brand-mcp">Open schema <span aria-hidden="true">↗</span></span>
						</a>
						<a href={urlStandard} class="group bg-surface-deep p-7 transition duration-300 hover:bg-surface-mid sm:p-8" target="_blank" rel="noopener noreferrer">
							<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-warn">Reference</p>
							<h3 class="font-display mt-3 text-xl font-bold text-foreground">Open standard</h3>
							<p class="mt-3 text-sm leading-relaxed text-muted-foreground">The public standard your engineers, security team, and partners can read.</p>
							<span class="font-mono-cta mt-6 inline-flex items-center gap-2 text-sm normal-case tracking-[0.01em] text-brand-warn">Open standard <span aria-hidden="true">↗</span></span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §03 — Final note
		     ============================================================= -->
		<section class="relative bg-surface-deep">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_bottom,rgba(110,231,183,0.06),transparent_60%)]"></div>
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:py-32 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ 03</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Next</span>
				</aside>
				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[20ch] text-balance text-[clamp(1.7rem,4vw,2.8rem)] font-bold leading-[1.05] tracking-[-0.01em] text-foreground">
						Now connect the agent.
					</h2>
					<p class="mt-5 max-w-2xl text-base leading-relaxed text-text-secondary">
						The <code class="font-mono-cta text-brand-mcp">.aadm/config.json</code> is just scaffolding. The actual
						discipline arrives when an MCP-capable IDE points at the hosted server.
					</p>
					<div class="mt-10 flex flex-col flex-wrap items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
						<a
							href={urlMcpMarketing}
							class="group inline-flex items-center gap-3 bg-foreground px-6 py-3.5 text-sm font-semibold tracking-tight text-background outline-none transition duration-200 hover:bg-brand-mcp hover:text-brand-mcp-fg focus-visible:ring-2 focus-visible:ring-brand-mcp focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>See how the MCP works</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href="/ides"
							class="inline-flex items-center gap-2 border border-border bg-transparent px-6 py-3.5 text-sm font-semibold text-foreground outline-none transition duration-200 hover:border-foreground/25 hover:bg-accent"
						>
							Pick an IDE
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<script is:inline>
		(function () {
			const btn = document.getElementById('governance-customize-copy-btn');
			const code = document.getElementById('governance-customize-prompt-code');
			if (!btn || !code) return;
			const defaultLabel = btn.textContent || 'Copy prompt';
			btn.addEventListener('click', async function () {
				const text = (code.textContent || '').trim();
				try {
					await navigator.clipboard.writeText(text);
					btn.textContent = 'Copied!';
					btn.classList.add('opacity-90');
					window.setTimeout(function () {
						btn.textContent = defaultLabel;
						btn.classList.remove('opacity-90');
					}, 2200);
				} catch {
					btn.textContent = 'Copy blocked';
					window.setTimeout(function () {
						btn.textContent = defaultLabel;
					}, 3200);
				}
			});
		})();
	</script>
</Layout>
