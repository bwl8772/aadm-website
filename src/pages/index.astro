---
import Layout from '../layouts/Layout.astro';
import { getSiteUrlConfig } from '../lib/site-urls';

const cfg = getSiteUrlConfig(import.meta.env);
const {
	urlStandard,
	urlMcpEndpoint,
	urlMcpMarketing,
	urlMcpCustomerDocs,
	hasMcpMarketingLink,
	healthUrl,
	discoveryUrl,
	curlInit,
} = cfg;
---

<Layout
	title="AADM — Agentic Authority Delivery Model"
	description="Open standard for governed software delivery with agents—read and adopt in public. Optional hosted MCP keeps your tooling versioned, online, and maintained."
	headerActiveNav="home"
>
	<main id="main">
		<section class="mx-auto max-w-6xl px-4 pb-20 pt-16 sm:px-6 sm:pt-24">
			<p
				class="mb-4 inline-flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-wider text-slate-400"
			>
				<span
					class="rounded-full border border-border-subtle bg-surface-card/60 px-3 py-1 text-accent-blue"
					>Open standard</span
				>
				<span class="rounded-full border border-border-subtle bg-surface-card/60 px-3 py-1 text-accent-violet"
					>Hosted MCP</span
				>
			</p>
			<h1
				class="font-display max-w-3xl text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl"
			>
				Keep agent-assisted delivery
				<span class="bg-gradient-to-r from-accent-violet to-accent-blue bg-clip-text text-transparent">
					aligned, current, and online
				</span>
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
				<strong class="font-semibold text-slate-300">The standard</strong> lives in the open—definitions,
				templates, and governance narrative you can read, adopt, and improve with everyone else shipping software
				the same way. <strong class="font-semibold text-slate-300">Hosted MCP access</strong> is separate: a
				private service so your agents get versioned tools and resources on infrastructure that stays updated and
				maintained—without requiring an open-source MCP implementation.
			</p>
			<div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
				<a
					href={urlStandard}
					class="inline-flex items-center justify-center rounded-xl border border-border-subtle bg-surface-card px-6 py-3.5 text-base font-semibold text-white shadow-sm transition hover:border-slate-500/40 hover:bg-surface-mid"
				>
					Read &amp; adopt the standard
				</a>
				<a
					href={urlMcpMarketing}
					class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-violet-600 via-violet-600 to-blue-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-violet-950/40 transition hover:brightness-110"
				>
					Connect production agents
				</a>
			</div>
			<p class="mt-4 text-sm text-slate-500">
				MCP carries context and workflows—it does not replace your production AUTH, gateways, tests, or CI as the
				source of truth.
			</p>
		</section>

		<section class="border-y border-border-subtle bg-surface-mid/40 py-16 sm:py-20">
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<h2 class="font-display text-center text-2xl font-bold text-white sm:text-3xl">
					Three agent lanes <span class="text-slate-500">(equal weight)</span>
				</h2>
				<p class="mx-auto mt-3 max-w-2xl text-center text-slate-400">
					Same vocabulary in the open standard; when you subscribe to hosted MCP, your tools expose three equal
					lanes so the right workflow matches the question you are actually asking.
				</p>
				<ul class="mt-12 grid gap-6 sm:grid-cols-3">
					<li
						class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20"
					>
						<h3 class="font-display text-lg font-bold text-accent-violet">Navigator</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">
							<strong class="text-slate-300">New or improved features.</strong> Delivery framing,
							mapping, and planning before code.
						</p>
						<ul class="mt-4 space-y-2 text-sm text-slate-400">
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent-violet"></span>
								<span>Scope work across UDALI layers so ownership is clear before the first commit</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent-violet"></span>
								<span>Map AUTH controls and acceptance criteria into the plan, not after the fact</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent-violet"></span>
								<span>Gate readiness with structured checklists instead of ad-hoc review threads</span>
							</li>
						</ul>
					</li>
					<li
						class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20"
					>
						<h3 class="font-display text-lg font-bold text-accent-blue">Investigator</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">
							<strong class="text-slate-300">Something broken vs expected.</strong> Call
							<code class="font-mono-cta text-xs text-slate-300">debug_defect</code> first.
						</p>
						<ul class="mt-4 space-y-2 text-sm text-slate-400">
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent-blue"></span>
								<span>Evidence-first recon: classify the failure before proposing any code change</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent-blue"></span>
								<span>Structured Path A / Path B flow prevents speculative rewrites and scope creep</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent-blue"></span>
								<span>Guardrails block timeout inflation, premature fixes, and multi-file drift</span>
							</li>
						</ul>
					</li>
					<li
						class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20"
					>
						<h3 class="font-display text-lg font-bold text-violet-300">Sentinel</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">
							<strong class="text-slate-300">Prove alignment with the standard.</strong> Assurance and
							audit-style tools.
						</p>
						<ul class="mt-4 space-y-2 text-sm text-slate-400">
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-violet-300"></span>
								<span>Trace AUTH controls, UDALI placement, and evidence across every seam</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-violet-300"></span>
								<span>Vertical and horizontal audit programs so releases are defensible, not vibes</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-violet-300"></span>
								<span>Findings hand off to Investigator or Navigator when action is needed</span>
							</li>
						</ul>
					</li>
				</ul>

				<div class="mt-16 grid gap-8 lg:grid-cols-2">
					<div class="rounded-2xl border border-border-subtle bg-surface-card/60 p-6">
						<h3 class="font-display text-base font-bold text-white">What it deliberately does not do</h3>
						<ul class="mt-4 space-y-2.5 text-sm text-slate-400">
							<li class="flex items-start gap-2">
								<span class="mt-1.5 block h-1 w-1 shrink-0 rounded-full bg-red-400/60"></span>
								Run business logic or mutate your database
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1.5 block h-1 w-1 shrink-0 rounded-full bg-red-400/60"></span>
								Issue compliance certificates or legal verdicts
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1.5 block h-1 w-1 shrink-0 rounded-full bg-red-400/60"></span>
								Replace code review, CI, or server-side authorization
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1.5 block h-1 w-1 shrink-0 rounded-full bg-red-400/60"></span>
								Store long-lived secrets in the standard repo &mdash; credentials are your deployment concern
							</li>
						</ul>
					</div>
					<div class="rounded-2xl border border-border-subtle bg-surface-card/60 p-6">
						<h3 class="font-display text-base font-bold text-white">When you'd use it</h3>
						<p class="mt-4 text-sm leading-relaxed text-slate-400">
							Connect the MCP in your IDE so the agent loads the same standard every session &mdash; UDALI
							placement, AUTH references, build intent, troubleshooter discipline &mdash; instead of
							improvising from random doc snippets.
						</p>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">
							Your <code class="font-mono-cta text-xs text-slate-300">~/.cursor/mcp.json</code> already
							has an <code class="font-mono-cta text-xs text-accent-violet">aadm</code> entry pointing at
							<code class="font-mono-cta text-xs text-accent-blue">https://mcp.aadm.io/mcp</code> with an
							API key &mdash; that's this kind of server (hosted), not the markdown files in the repo alone.
						</p>
						<ul class="mt-4 space-y-2.5 text-sm text-slate-400">
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent-blue"></span>
								<span><strong class="text-slate-300">Any MCP-capable IDE can connect</strong> &mdash; Streamable HTTP transport works with any client that speaks the protocol</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent-violet"></span>
								<span><strong class="text-slate-300">Cursor + AADM</strong> &mdash; add the server in <code class="font-mono-cta text-xs text-slate-300">~/.cursor/mcp.json</code> and agents pick up lanes, doctrine, and tools automatically</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="mt-1 block h-1.5 w-1.5 shrink-0 rounded-full bg-violet-300"></span>
								<span><strong class="text-slate-300">Claude Code + AADM</strong> &mdash; point the CLI at the same endpoint and get identical routing, troubleshooter discipline, and AUTH context</span>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section id="how-it-works" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
			<h2 class="font-display text-center text-2xl font-bold text-white sm:text-3xl">How it works</h2>
			<p class="mx-auto mt-4 max-w-3xl text-center text-lg leading-relaxed text-slate-400">
				A read-only <strong class="text-slate-300">"standard context" server</strong> for AI coding tools: it
				exposes AADM definitions, UDALI/AUTH doctrine, prompts, and structured tools so agents plan, route, and
				troubleshoot work the AADM way—without running your product or enforcing security in production.
			</p>

			<div class="mt-14">
				<h3 class="font-display mb-6 text-center text-lg font-semibold text-slate-300">Mental model</h3>
				<div class="mx-auto max-w-3xl space-y-3">
					<div class="flex items-start gap-4 rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/20">
						<span class="mt-0.5 shrink-0 rounded-lg bg-accent-blue/15 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-accent-blue">Your app repo</span>
						<p class="text-sm leading-relaxed text-slate-400">Real code, AUTH enforcement, tests, CI, evidence—the <strong class="text-slate-300">source of truth</strong>.</p>
					</div>
					<div class="flex items-start gap-4 rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/20">
						<span class="mt-0.5 shrink-0 rounded-lg bg-accent-violet/15 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-accent-violet">This MCP</span>
						<p class="text-sm leading-relaxed text-slate-400">Teaches and structures <strong class="text-slate-300">agent behavior</strong> against the AADM standard.</p>
					</div>
					<div class="flex items-start gap-4 rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/20">
						<span class="mt-0.5 shrink-0 rounded-lg bg-violet-300/15 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-violet-300">Public docs</span>
						<p class="text-sm leading-relaxed text-slate-400">Human-readable templates and education in the open <strong class="text-slate-300">aadm-standard</strong> repo.</p>
					</div>
				</div>
				<p class="mx-auto mt-6 max-w-2xl text-center text-sm text-slate-500">
					The MCP does not replace your application. It does not scan your repo for pass/fail compliance. It
					gives agents consistent framing and checklists.
				</p>
			</div>

			<div class="mt-16">
				<h3 class="font-display mb-8 text-center text-lg font-semibold text-slate-300">What it exposes over MCP</h3>
				<div class="grid gap-6 sm:grid-cols-3">
					<div class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20">
						<h4 class="font-display text-base font-bold text-accent-blue">Resources</h4>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">
							Markdown the agent can read: AADM definition, UDALI layers, AUTH and SEAM catalogs
							(<code class="font-mono-cta text-xs text-slate-300">aadm://auth/…</code>,
							<code class="font-mono-cta text-xs text-slate-300">aadm://seams/…</code>), TRACE spine, audit templates,
							troubleshooting modes, architecture doctrine slices.
						</p>
					</div>
					<div class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20">
						<h4 class="font-display text-base font-bold text-accent-violet">Prompts</h4>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">
							Packaged workflows the agent invokes directly—capabilities overview, troubleshooter mode,
							skill-library pairing, and more.
						</p>
					</div>
					<div class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20">
						<h4 class="font-display text-base font-bold text-violet-300">Tools</h4>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">
							JSON responses that guide the agent:
							<code class="font-mono-cta text-xs text-slate-300">standard_brief</code>,
							<code class="font-mono-cta text-xs text-slate-300">route_lane</code>,
							<code class="font-mono-cta text-xs text-slate-300">debug_defect</code>,
							<code class="font-mono-cta text-xs text-slate-300">plan_delivery</code>,
							<code class="font-mono-cta text-xs text-slate-300">map_feature</code>,
							<code class="font-mono-cta text-xs text-slate-300">fetch_auth</code>,
							<code class="font-mono-cta text-xs text-slate-300">fetch_seam</code>,
							audit outlines, Sentinel helpers, architecture lenses, and more.
						</p>
					</div>
				</div>
				<p class="mt-6 text-center text-sm text-slate-500">
					Transport is <strong class="text-slate-400">HTTP Streamable MCP</strong> at
					<code class="font-mono-cta text-slate-400">/mcp</code> (plus
					<code class="font-mono-cta text-slate-400">/health</code> for liveness). Connect from Cursor or
					another MCP client with your org's URL and auth.
				</p>
			</div>

			<div class="mt-16">
				<h3 class="font-display mb-6 text-center text-lg font-semibold text-slate-300">What you can do</h3>
				<p class="mx-auto mb-8 max-w-2xl text-center text-sm text-slate-400">
					Concrete outcomes engineers get from the MCP in their daily workflow:
				</p>
				<ol class="mx-auto max-w-3xl space-y-4">
					<li class="flex items-start gap-4 rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/20">
						<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-violet/15 text-xs font-bold text-accent-violet">1</span>
						<p class="text-sm leading-relaxed text-slate-300">
							<strong>Slice a feature into layer-aware work items</strong>
							<span class="text-slate-500"> &mdash; ordered vertical slices with UDALI placement, AUTH tags, and acceptance criteria per slice.</span>
						</p>
					</li>
					<li class="flex items-start gap-4 rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/20">
						<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-violet/15 text-xs font-bold text-accent-violet">2</span>
						<p class="text-sm leading-relaxed text-slate-300">
							<strong>Scope attestation dimensions per slice</strong>
							<span class="text-slate-500"> &mdash; declare vertical depth and horizontal seams so the agent knows what to check, not guess.</span>
						</p>
					</li>
					<li class="flex items-start gap-4 rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/20">
						<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-blue/15 text-xs font-bold text-accent-blue">3</span>
						<p class="text-sm leading-relaxed text-slate-300">
							<strong>Get required seam tiers back</strong>
							<span class="text-slate-500"> &mdash; know exactly which boundaries need proof before release, not "tests pass and we hope."</span>
						</p>
					</li>
					<li class="flex items-start gap-4 rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/20">
						<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-blue/15 text-xs font-bold text-accent-blue">4</span>
						<p class="text-sm leading-relaxed text-slate-300">
							<strong>Route defects through evidence-gated investigation</strong>
							<span class="text-slate-500"> &mdash; classify before fixing; no speculative rewrites, no premature code changes.</span>
						</p>
					</li>
					<li class="flex items-start gap-4 rounded-2xl border border-border-subtle bg-surface-card/80 p-5 shadow-lg shadow-black/20">
						<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-violet-300/15 text-xs font-bold text-violet-300">5</span>
						<p class="text-sm leading-relaxed text-slate-300">
							<strong>Prove alignment before release with structured audit programs</strong>
							<span class="text-slate-500"> &mdash; bind evidence per seam so releases are defensible, not vibes.</span>
						</p>
					</li>
				</ol>
			</div>
		</section>

		<section id="mcp-quickstart" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
			<h2 class="font-display text-2xl font-bold text-white sm:text-3xl">Wire your stack—quick MCP reference</h2>
			<p class="mt-4 max-w-3xl text-slate-400">
				When agents need stable, versioned access to the same resources your team already trusts, 				the MCP
				<strong class="text-slate-300">service</strong> at{' '}
				<code class="font-mono-cta text-sm text-accent-blue">{urlMcpEndpoint}</code> speaks
				<strong class="text-slate-300">Streamable HTTP</strong>:
				<code class="rounded bg-surface-card px-1.5 py-0.5 font-mono-cta text-sm text-accent-violet">POST</code>
				with <code class="font-mono-cta text-sm text-slate-300">Accept: application/json, text/event-stream</code>.
				Browser GET to the MCP path without that header often returns <strong class="text-slate-300">406</strong>—expected.
			</p>

			{
				urlMcpEndpoint ? (
					<div class="mt-8 space-y-6">
						<div class="flex flex-wrap gap-3">
							<a
								href={urlMcpMarketing}
								class="inline-flex items-center rounded-lg bg-gradient-to-r from-violet-600 to-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:brightness-110"
							>
								MCP marketing (aadm.io/mcp)
							</a>
							{healthUrl ? (
								<a
									href={healthUrl}
									class="inline-flex items-center rounded-lg border border-border-subtle bg-surface-card px-4 py-2 text-sm font-semibold text-white transition hover:bg-surface-mid"
								>
									GET /health
								</a>
							) : null}
							{discoveryUrl ? (
								<a
									href={discoveryUrl}
									class="inline-flex items-center rounded-lg border border-border-subtle bg-surface-card px-4 py-2 text-sm font-semibold text-white transition hover:bg-surface-mid"
								>
									GET / (discovery)
								</a>
							) : null}
						</div>
						<div>
							<p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">
								MCP service (JSON-RPC — not the marketing page)
							</p>
							<p class="break-all font-mono-cta text-sm text-accent-blue">{urlMcpEndpoint}</p>
						</div>
						<div>
							<p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">
								Smoke: initialize (JSON-RPC over HTTP)
							</p>
							<pre
								class="overflow-x-auto rounded-2xl border border-border-subtle bg-surface-card/90 p-4 font-mono-cta text-xs leading-relaxed text-slate-300 sm:text-sm"><code>{curlInit}</code></pre>
						</div>
						{hasMcpMarketingLink ? (
							<p class="text-sm text-slate-500">
								Subscription covers the running service, updates, and subscriber guides—read the public MCP
								marketing page at{' '}
								<a href={urlMcpMarketing} class="font-semibold text-accent-violet underline hover:text-accent-blue">
									{urlMcpMarketing}
								</a>
								(default production: <code class="font-mono-cta text-slate-400">https://aadm.io/mcp</code>).
							</p>
						) : (
							<p class="text-sm text-slate-500">
								Set <code class="font-mono-cta text-slate-400">PUBLIC_MCP_QUICKSTART_URL</code> to your MCP marketing
								URL (override default <code class="font-mono-cta text-slate-400">https://aadm.io/mcp</code> when needed).
							</p>
						)}
						{urlMcpCustomerDocs ? (
							<p class="text-sm text-slate-500">
								Additional material:{' '}
								<a href={urlMcpCustomerDocs} class="font-semibold text-accent-violet underline hover:text-accent-blue">
									Customer documentation
								</a>
							</p>
						) : null}
					</div>
				) : (
