---
import AadmThreadReplica from "../components/visuals/AadmThreadReplica.astro";
import Layout from "../layouts/Layout.astro";
import { getSiteUrlConfig } from "../lib/site-urls";

const cfg = getSiteUrlConfig(import.meta.env);
const {
	urlStandard,
	urlMcpEndpoint,
	urlMcpMarketing,
	urlMcpCustomerDocs,
	hasMcpMarketingLink,
	healthUrl,
	discoveryUrl,
	curlInit,
} = cfg;

type Lane = {
	num: string;
	name: string;
	tagline: string;
	plain: string;
	bullets: string[];
	tone: "violet" | "blue" | "emerald";
};

const lanes: Lane[] = [
	{
		num: "I",
		name: "Navigator",
		tagline: "Delivery · building something new",
		plain:
			"Turn a vague feature ask into layer-aware slices — with authorization, ownership, and acceptance criteria baked in before any code is written.",
		bullets: [
			"Scope work across UDALI layers so ownership is clear before the first commit",
			"Map AUTH controls and acceptance criteria into the plan, not after the fact",
			"Gate readiness with structured checklists instead of ad-hoc review threads",
		],
		tone: "violet",
	},
	{
		num: "II",
		name: "Investigator",
		tagline: "Defects · something is broken",
		plain:
			"Find what's actually wrong before changing anything. Path A recon classifies the failure; Path B diagnosis is gated until proof crosses the router.",
		bullets: [
			"Evidence-first recon: classify the failure before proposing any code change",
			"Structured Path A / Path B flow prevents speculative rewrites and scope creep",
			"Guardrails block timeout inflation, premature fixes, and multi-file drift",
		],
		tone: "blue",
	},
	{
		num: "III",
		name: "Sentinel",
		tagline: "Assurance · proving it's aligned",
		plain:
			"Show — in language an auditor or compliance lead accepts — that the controls you say you have are actually in place across every seam.",
		bullets: [
			"Trace AUTH controls, UDALI placement, and evidence across every seam",
			"Vertical and horizontal audit programs so releases are defensible, not vibes",
			"Findings hand off to Investigator or Navigator when action is needed",
		],
		tone: "emerald",
	},
];

const laneToneClasses: Record<
	Lane["tone"],
	{
		numeral: string;
		rule: string;
		chip: string;
		accent: string;
		glow: string;
		bullet: string;
	}
> = {
	violet: {
		numeral: "text-violet-300/90",
		rule: "border-violet-400/40",
		chip: "border-violet-400/30 text-violet-200",
		accent: "text-violet-200",
		glow: "bg-violet-500/[0.07]",
		bullet: "bg-violet-300",
	},
	blue: {
		numeral: "text-sky-300/90",
		rule: "border-sky-400/40",
		chip: "border-sky-400/30 text-sky-200",
		accent: "text-sky-200",
		glow: "bg-sky-500/[0.07]",
		bullet: "bg-sky-300",
	},
	emerald: {
		numeral: "text-emerald-300/90",
		rule: "border-emerald-400/40",
		chip: "border-emerald-400/30 text-emerald-200",
		accent: "text-emerald-200",
		glow: "bg-emerald-500/[0.07]",
		bullet: "bg-emerald-300",
	},
};

type MentalModelTier = {
	num: string;
	label: string;
	title: string;
	body: string;
	tone: "amber" | "emerald" | "white";
};

const mentalModel: MentalModelTier[] = [
	{
		num: "01",
		label: "Source of truth",
		title: "Your app repo",
		body: "Real code, authorization enforcement, tests, CI, evidence. This is where “done” is actually proven.",
		tone: "white",
	},
	{
		num: "02",
		label: "Governance context",
		title: "The hosted MCP",
		body: "Teaches and structures agent behavior against the AADM standard — workflows, doctrine, gates. Does not run your product.",
		tone: "emerald",
	},
	{
		num: "03",
		label: "Open document",
		title: "Public standard",
		body: "Human-readable templates, definitions, and education in the aadm-standard repo. Free to read, free to adopt.",
		tone: "amber",
	},
];

const mentalToneClasses: Record<
	MentalModelTier["tone"],
	{ numeral: string; pill: string; rule: string }
> = {
	amber: {
		numeral: "text-amber-300/90",
		pill: "border-amber-300/30 text-amber-200",
		rule: "border-amber-300/40",
	},
	emerald: {
		numeral: "text-emerald-300/90",
		pill: "border-emerald-300/30 text-emerald-200",
		rule: "border-emerald-300/40",
	},
	white: {
		numeral: "text-foreground/90",
		pill: "border-border text-foreground",
		rule: "border-white/30",
	},
};

type Surface = {
	letter: string;
	name: string;
	tagline: string;
	body: string;
	examples: string;
};

const surfaces: Surface[] = [
	{
		letter: "A",
		name: "Resources",
		tagline: "Markdown the agent reads",
		body: "AADM definition, UDALI layers, AUTH and SEAM catalogs, TRACE spine, audit templates, troubleshooting modes, architecture doctrine slices.",
		examples: "aadm://auth/… · aadm://seams/…",
	},
	{
		letter: "B",
		name: "Prompts",
		tagline: "Packaged workflows",
		body: "Capabilities overview, troubleshooter mode, skill-library pairing, and other packaged workflows the agent invokes directly.",
		examples: "Invoked from the IDE",
	},
	{
		letter: "C",
		name: "Tools",
		tagline: "Typed JSON responses",
		body: "Structured calls that guide the agent. Each returns deterministic JSON for orchestrators — names match the running server's tools/list.",
		examples:
			"standard_brief · route_lane · debug_defect · plan_delivery · fetch_auth",
	},
];

type Outcome = {
	num: string;
	title: string;
	body: string;
};

const outcomes: Outcome[] = [
	{
		num: "01",
		title: "Slice a feature into layer-aware work items",
		body: "Ordered vertical slices with UDALI placement, AUTH tags, and acceptance criteria per slice.",
	},
	{
		num: "02",
		title: "Scope attestation dimensions per slice",
		body: "Declare vertical depth and horizontal seams so the agent knows what to check, not guess.",
	},
	{
		num: "03",
		title: "Get required seam tiers back",
		body: "Know exactly which boundaries need proof before release — not “tests pass and we hope.”",
	},
	{
		num: "04",
		title: "Route defects through evidence-gated investigation",
		body: "Classify before fixing. No speculative rewrites, no premature code changes.",
	},
	{
		num: "05",
		title: "Prove alignment before release with structured audit programs",
		body: "Bind evidence per seam so releases are defensible, not vibes.",
	},
];
---

<Layout
	title="AADM — Agentic Authority Delivery Model"
	description="Open standard for governed software delivery with agents — read and adopt in public. Hosted MCP keeps your tooling versioned, online, and maintained."
	headerActiveNav="home"
>
	<main id="main" class="relative isolate overflow-x-clip bg-surface-deep text-text-primary">

		<!-- =============================================================
		     §00 — HERO
		     ============================================================= -->
		<section class="relative border-b border-border">
			<!-- Blueprint dot grid -->
			<div
				aria-hidden="true"
				class="absolute inset-0 -z-10 bg-[radial-gradient(rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[length:28px_28px] [mask-image:radial-gradient(ellipse_at_top,black_55%,transparent_85%)]"
			></div>
			<!-- Soft emerald + amber washes -->
			<div aria-hidden="true" class="absolute left-0 top-0 -z-10 h-[36rem] w-[36rem] -translate-x-1/3 -translate-y-1/3 rounded-full bg-emerald-500/[0.07] blur-3xl"></div>
			<div aria-hidden="true" class="absolute right-0 top-24 -z-10 h-[36rem] w-[36rem] translate-x-1/3 rounded-full bg-amber-500/[0.05] blur-3xl"></div>
			<!-- Diagonal hairline -->
			<svg aria-hidden="true" class="pointer-events-none absolute left-1/2 top-12 -z-10 hidden h-[120%] w-[1px] -translate-x-[18rem] rotate-[18deg] sm:block">
				<line x1="0" y1="0" x2="0" y2="100%" stroke="rgba(110,231,183,0.18)" stroke-dasharray="2 6" />
			</svg>

			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 pb-24 pt-10 sm:px-8 sm:pb-32 sm:pt-16">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-emerald-200/70">§ 00</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">AADM / Overview</span>
					<span class="hidden font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground sm:mt-auto sm:block">
						<span class="text-muted-foreground">Filed under</span><br />
						<span class="text-muted-foreground">Agent governance</span>
					</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<p class="font-mono-cta mb-10 flex flex-wrap items-center gap-3 text-[13px] normal-case tracking-[0.01em] text-muted-foreground">
						<span class="inline-flex items-center gap-2 border border-emerald-300/30 px-2.5 py-1 text-emerald-200/90">
							<span class="block h-1 w-1 rounded-full bg-emerald-300"></span> Open standard
						</span>
						<span class="inline-flex items-center gap-2 border border-amber-300/30 px-2.5 py-1 text-amber-200/90">
							<span class="block h-1 w-1 rounded-full bg-amber-300"></span> Hosted MCP
						</span>
					</p>

					<h1
						class="font-display max-w-[18ch] text-balance text-[clamp(2.4rem,8vw,6.6rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground"
					>
						The <span class="font-light italic text-muted-foreground">standard</span> your agents
						<br class="hidden sm:inline" />
						load on <span class="relative inline-block">
							<span class="relative z-10 text-emerald-300">every turn.</span>
							<span aria-hidden="true" class="absolute inset-x-0 bottom-[0.1em] -z-0 h-[0.18em] bg-emerald-300/30"></span>
						</span>
					</h1>

					<!-- Body + margin note -->
					<div class="mt-14 grid grid-cols-12 gap-6">
						<div class="col-span-12 sm:col-span-4">
							<div class="border-l border-emerald-300/40 pl-5">
								<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-emerald-200/80">Two products · one story</p>
								<p class="mt-3 text-[0.95rem] leading-relaxed text-text-secondary">
									<span class="text-foreground">The standard</span> is a public document anyone can read, adopt, and improve.
									<span class="text-foreground">The hosted MCP</span> is a subscription service that streams that standard to your
									agents as versioned tools and resources.
								</p>
							</div>
						</div>
						<div class="col-span-12 sm:col-span-8">
							<p class="text-pretty text-lg leading-[1.65] text-text-secondary sm:text-xl">
								Same vocabulary, three workflows: <span class="text-foreground">Navigator</span> for new features,
								<span class="text-foreground">Investigator</span> for defects, <span class="text-foreground">Sentinel</span> for assurance —
								loaded by whichever harness your engineers already use: Cursor, Claude Code, Windsurf, or anything that speaks
								MCP. The MCP carries <span class="font-light italic text-muted-foreground">context and workflows.</span> It does
								not replace your AUTH, gateways, tests, or CI.
							</p>
						</div>
					</div>

					<!-- CTAs -->
					<div class="mt-14 flex flex-col flex-wrap items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
						<a
							href={urlMcpMarketing}
							class="group inline-flex items-center gap-3 bg-white px-6 py-3.5 text-sm font-semibold tracking-tight text-slate-950 outline-none transition duration-200 hover:bg-emerald-200 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>See how the MCP works</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href={urlStandard}
							class="inline-flex items-center gap-2 border border-border bg-transparent px-6 py-3.5 text-sm font-semibold text-foreground outline-none transition duration-200 hover:border-white/40 hover:bg-accent focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
							<span>Read the Standard</span>
						</a>
						<a
							href="/why-aadm"
							class="group font-mono-cta inline-flex items-center gap-2 text-sm normal-case tracking-[0.01em] text-muted-foreground underline decoration-slate-700 underline-offset-[6px] transition hover:text-emerald-200 hover:decoration-emerald-300"
						>
							<span>Why AADM, vs raw loops</span>
							<span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
						</a>
					</div>

					<p class="mt-8 max-w-2xl text-sm leading-relaxed text-muted-foreground">
						New to the term? <a
							href="/about"
							class="font-semibold text-text-secondary underline decoration-slate-700 underline-offset-4 transition hover:text-emerald-200 hover:decoration-emerald-300"
							>Agentic engineering</a
						> is the discipline this standard serves — written for engineers who already know how software should be built.
					</p>
				</div>
			</div>
		</section>

		<!-- AADM thread replica (decorative, non-interactive) -->
		<section class="relative border-b border-border px-4 py-24 sm:px-8 sm:py-28">
			<div class="mx-auto max-w-3xl text-center">
				<h2 class="font-display text-balance text-[clamp(1.6rem,3.4vw,2.4rem)] font-bold leading-[1.15] text-foreground">
					What it looks like in your editor
				</h2>
				<p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
					Your agent works as usual. When the task needs governance, it calls AADM and follows what comes back.
				</p>
			</div>
			<div class="mt-12">
				<AadmThreadReplica />
			</div>
		</section>

		<!-- =============================================================
		     §01 — Three lanes
		     ============================================================= -->
		<section class="relative border-b border-border bg-surface-mid">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:py-32 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-violet-200/70">§ 01</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Three lanes</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[22ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						Three workflows. <span class="font-light italic text-muted-foreground">Equal weight.</span>
					</h2>
					<p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
						Every coding task is one of three things. AADM gives each its own lane — so the agent picks the right workflow for the
						question being asked, not whichever instinct fires first.
					</p>

					<div class="mt-16 space-y-px bg-white/[0.08]">
						{
							lanes.map((lane) => {
								const t = laneToneClasses[lane.tone];
								return (
									<article class="group relative overflow-hidden bg-surface-mid transition duration-300 hover:bg-secondary">
										<div aria-hidden="true" class:list={["pointer-events-none absolute -left-24 -top-24 -z-0 h-72 w-72 rounded-full blur-3xl opacity-50 transition duration-500 group-hover:opacity-100", t.glow]}></div>
										<div class="relative grid grid-cols-12 gap-6 px-1 py-12 sm:px-2 sm:py-14">
											<div class="col-span-12 sm:col-span-2">
												<p class:list={["font-display text-[5rem] font-light leading-[0.85] tracking-tight sm:text-[6.5rem]", t.numeral]}>
													{lane.num}
												</p>
												<div class:list={["mt-3 inline-flex items-center gap-2 border px-3 py-1.5 font-mono-cta text-[13px] normal-case tracking-[0.01em]", t.chip]}>
													<span class:list={["block h-1.5 w-1.5 rounded-full", t.bullet]}></span>
													{lane.name}
												</div>
											</div>

											<div class="col-span-12 sm:col-span-6">
												<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">{lane.tagline}</p>
												<p class="mt-5 text-[0.98rem] leading-[1.65] text-foreground">{lane.plain}</p>
											</div>

											<div class="col-span-12 sm:col-span-4">
												<div class:list={["border-l pl-5", t.rule]}>
													<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">What you get</p>
													<ul class="mt-4 space-y-3 text-sm leading-relaxed text-text-secondary">
														{lane.bullets.map((b) => (
															<li class="grid grid-cols-[auto_1fr] items-start gap-3">
																<span class:list={["mt-[0.5em] block h-1 w-1 rounded-full", t.bullet]}></span>
																<span>{b}</span>
															</li>
														))}
													</ul>
												</div>
											</div>
										</div>
									</article>
								);
							})
						}
					</div>

					<!-- Boundary statement chip -->
					<div class="mt-14 grid grid-cols-12 gap-6">
						<div class="col-span-12 lg:col-span-7">
							<div class="border-l-2 border-amber-300/40 pl-6">
								<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-amber-200/80">What it deliberately does not do</p>
								<ul class="mt-5 divide-y divide-white/[0.06] border-t border-border">
									{
										[
											"Run business logic or mutate your database",
											"Issue compliance certificates or legal verdicts",
											"Replace code review, CI, or server-side authorization",
											"Store long-lived secrets — credentials are your deployment concern",
										].map((item, idx) => (
											<li class="group grid grid-cols-[auto_1fr] items-baseline gap-4 py-3.5">
												<span class="font-mono-cta text-sm text-amber-300/80">{String(idx + 1).padStart(2, "0")}</span>
												<span class="text-sm leading-relaxed text-text-secondary transition group-hover:text-foreground">{item}</span>
											</li>
										))
									}
								</ul>
							</div>
						</div>
						<div class="col-span-12 lg:col-span-5">
							<div class="border border-border bg-muted p-6 sm:p-7">
								<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-emerald-200/80">When you'd use it</p>
								<p class="mt-4 text-[0.95rem] leading-relaxed text-text-secondary">
									Connect the MCP in your IDE so the agent loads the same standard every session — UDALI placement, AUTH
									references, build intent, troubleshooter discipline — instead of improvising from random doc snippets.
								</p>
								<p class="mt-3 text-sm leading-relaxed text-muted-foreground">
									Any MCP-capable IDE works. Cursor and Claude Code are the most common; Windsurf, Cline, and others connect the
									same way over Streamable HTTP.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §02 — Mental model (three tiers)
		     ============================================================= -->
		<section class="relative border-b border-border">
			<div
				aria-hidden="true"
				class="absolute inset-0 -z-10 bg-[linear-gradient(rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[length:64px_64px] [mask-image:radial-gradient(ellipse_at_center,black_45%,transparent_80%)]"
			></div>
			<div id="how-it-works" class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:py-32 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-emerald-200/70">§ 02</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Mental model</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[22ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						Three pieces. <span class="font-light italic text-muted-foreground">Each does one job.</span>
					</h2>
					<p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
