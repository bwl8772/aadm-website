---
import Layout from '../layouts/Layout.astro';
import { getSiteUrlConfig } from '../lib/site-urls';

const cfg = getSiteUrlConfig(import.meta.env);
const {
	urlStandard,
	urlMcpEndpoint,
	urlMcpMarketing,
	urlMcpCustomerDocs,
	hasMcpMarketingLink,
	healthUrl,
	discoveryUrl,
	curlInit,
} = cfg;
---

<Layout
	title="AADM — Agentic Authority Delivery Model"
	description="Open standard for governed software delivery with agents—read and adopt in public. Optional hosted MCP keeps your tooling versioned, online, and maintained."
	headerActiveNav="home"
>
	<main id="main">
		<section class="mx-auto max-w-6xl px-4 pb-20 pt-16 sm:px-6 sm:pt-24">
			<p
				class="mb-4 inline-flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-wider text-slate-400"
			>
				<span
					class="rounded-full border border-border-subtle bg-surface-card/60 px-3 py-1 text-accent-blue"
					>Open standard</span
				>
				<span class="rounded-full border border-border-subtle bg-surface-card/60 px-3 py-1 text-accent-violet"
					>Hosted MCP</span
				>
			</p>
			<h1
				class="font-display max-w-3xl text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl"
			>
				Keep agent-assisted delivery
				<span class="bg-gradient-to-r from-accent-violet to-accent-blue bg-clip-text text-transparent">
					aligned, current, and online
				</span>
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
				<strong class="font-semibold text-slate-300">The standard</strong> lives in the open—definitions,
				templates, and governance narrative you can read, adopt, and improve with everyone else shipping software
				the same way. <strong class="font-semibold text-slate-300">Hosted MCP access</strong> is separate: a
				private service so your agents get versioned tools and resources on infrastructure that stays updated and
				maintained—without requiring an open-source MCP implementation.
			</p>
			<div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
				<a
					href={urlStandard}
					class="inline-flex items-center justify-center rounded-xl border border-border-subtle bg-surface-card px-6 py-3.5 text-base font-semibold text-white shadow-sm transition hover:border-slate-500/40 hover:bg-surface-mid"
				>
					Read &amp; adopt the standard
				</a>
				<a
					href={urlMcpMarketing}
					class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-violet-600 via-violet-600 to-blue-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-violet-950/40 transition hover:brightness-110"
				>
					Connect production agents
				</a>
			</div>
			<p class="mt-4 text-sm text-slate-500">
				MCP carries context and workflows—it does not replace your production AUTH, gateways, tests, or CI as the
				source of truth.
			</p>
		</section>

		<section class="border-y border-border-subtle bg-surface-mid/40 py-16 sm:py-20">
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<h2 class="font-display text-center text-2xl font-bold text-white sm:text-3xl">
					Three ways your agents stay useful—not generic “bug chat”
				</h2>
				<p class="mx-auto mt-3 max-w-2xl text-center text-slate-400">
					Same vocabulary in the open standard; when you subscribe to hosted MCP, your tools expose three equal
					lanes so the right workflow matches the question you are actually asking.
				</p>
				<ul class="mt-12 grid gap-6 sm:grid-cols-3">
					<li
						class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20"
					>
						<h3 class="font-display text-lg font-bold text-accent-violet">Navigator</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">
							<strong class="text-slate-300">You ship planned work:</strong> scope, verify, and readiness for
							net-new or meaningful upgrades—without improvising a process each sprint.
						</p>
					</li>
					<li
						class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20"
					>
						<h3 class="font-display text-lg font-bold text-accent-blue">Investigator</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">
							<strong class="text-slate-300">You fix what is broken:</strong> evidence-first recon, then
							remediation once the failure is classified—fewer speculative rewrites.
						</p>
					</li>
					<li
						class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20"
					>
						<h3 class="font-display text-lg font-bold text-violet-300">Sentinel</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">
							<strong class="text-slate-300">You prove alignment:</strong> trace AUTH, UDALI, and evidence
							across seams so releases are defensible—not vibes.
						</p>
					</li>
				</ul>
			</div>
		</section>

		<section id="mcp-quickstart" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
			<h2 class="font-display text-2xl font-bold text-white sm:text-3xl">Wire your stack—quick MCP reference</h2>
			<p class="mt-4 max-w-3xl text-slate-400">
				When agents need stable, versioned access to the same resources your team already trusts, 				the MCP
				<strong class="text-slate-300">service</strong> at{' '}
				<code class="font-mono-cta text-sm text-accent-blue">{urlMcpEndpoint}</code> speaks
				<strong class="text-slate-300">Streamable HTTP</strong>:
				<code class="rounded bg-surface-card px-1.5 py-0.5 font-mono-cta text-sm text-accent-violet">POST</code>
				with <code class="font-mono-cta text-sm text-slate-300">Accept: application/json, text/event-stream</code>.
				Browser GET to the MCP path without that header often returns <strong class="text-slate-300">406</strong>—expected.
			</p>

			{
				urlMcpEndpoint ? (
					<div class="mt-8 space-y-6">
						<div class="flex flex-wrap gap-3">
							<a
								href={urlMcpMarketing}
								class="inline-flex items-center rounded-lg bg-gradient-to-r from-violet-600 to-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:brightness-110"
							>
								MCP marketing (aadm.io/mcp)
							</a>
							{healthUrl ? (
								<a
									href={healthUrl}
									class="inline-flex items-center rounded-lg border border-border-subtle bg-surface-card px-4 py-2 text-sm font-semibold text-white transition hover:bg-surface-mid"
								>
									GET /health
								</a>
							) : null}
							{discoveryUrl ? (
								<a
									href={discoveryUrl}
									class="inline-flex items-center rounded-lg border border-border-subtle bg-surface-card px-4 py-2 text-sm font-semibold text-white transition hover:bg-surface-mid"
								>
									GET / (discovery)
								</a>
							) : null}
						</div>
						<div>
							<p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">
								MCP service (JSON-RPC — not the marketing page)
							</p>
							<p class="break-all font-mono-cta text-sm text-accent-blue">{urlMcpEndpoint}</p>
						</div>
						<div>
							<p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">
								Smoke: initialize (JSON-RPC over HTTP)
							</p>
							<pre
								class="overflow-x-auto rounded-2xl border border-border-subtle bg-surface-card/90 p-4 font-mono-cta text-xs leading-relaxed text-slate-300 sm:text-sm"><code>{curlInit}</code></pre>
						</div>
						{hasMcpMarketingLink ? (
							<p class="text-sm text-slate-500">
								Subscription covers the running service, updates, and subscriber guides—read the public MCP
								marketing page at{' '}
								<a href={urlMcpMarketing} class="font-semibold text-accent-violet underline hover:text-accent-blue">
									{urlMcpMarketing}
								</a>
								(default production: <code class="font-mono-cta text-slate-400">https://aadm.io/mcp</code>).
							</p>
						) : (
							<p class="text-sm text-slate-500">
								Set <code class="font-mono-cta text-slate-400">PUBLIC_MCP_QUICKSTART_URL</code> to your MCP marketing
								URL (override default <code class="font-mono-cta text-slate-400">https://aadm.io/mcp</code> when needed).
							</p>
						)}
						{urlMcpCustomerDocs ? (
							<p class="text-sm text-slate-500">
								Additional material:{' '}
								<a href={urlMcpCustomerDocs} class="font-semibold text-accent-violet underline hover:text-accent-blue">
									Customer documentation
								</a>
							</p>
						) : null}
					</div>
				) : (
					<p class="mt-6 rounded-xl border border-dashed border-slate-600/50 bg-surface-mid/50 p-4 text-sm text-slate-500">
						Set <span class="font-mono-cta text-slate-400">PUBLIC_MCP_REPO_URL</span> in{' '}
						<code class="font-mono-cta text-slate-400">.env</code> to show your MCP endpoint, health link, and curl
						example.
					</p>
				)
			}
		</section>

		<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
			<div class="grid gap-10 lg:grid-cols-2 lg:items-start">
				<div>
					<h2 class="font-display text-2xl font-bold text-white sm:text-3xl">Open standard, hosted bridge</h2>
					<p class="mt-4 text-slate-400">
						<strong class="text-slate-300">One living standard, visible to everyone who ships with you.</strong>
						The text stays public so your org, partners, and community can discuss changes, propose updates, and
						stay on the same page—like any mature open project.
					</p>
					<p class="mt-4 text-slate-400">
						<strong class="text-slate-300">Pay for uptime and evolution, not a zip file.</strong> Hosted MCP is
						a separate subscription so the endpoint your agents call stays online, versioned, and maintained;
						you get operational continuity instead of self-hosting a moving target.
					</p>
					<p class="mt-4 text-sm text-slate-500">
						Your production AUTH, gateways, tests, and CI stay authoritative; MCP is how agents load the
						standard’s context and workflows predictably.
					</p>
				</div>
				<div class="space-y-4">
					<div class="rounded-2xl border border-border-subtle bg-surface-card/90 p-6">
						<h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">What you get</h3>
						<ul class="mt-4 space-y-3 text-sm text-slate-400">
							<li>
								<span class="font-semibold text-accent-blue">Open standard</span> — always readable,
								adoptable, and improvable in public; no paywall on the definitions.
							</li>
							<li>
								<span class="font-semibold text-accent-violet">Hosted MCP</span> — versioned tools and
								resources for subscribers’ agents; someone ships fixes and keeps the service current.
							</li>
						</ul>
					</div>
					<p class="rounded-2xl border border-dashed border-slate-600/50 bg-surface-mid/50 p-4 font-mono-cta text-xs leading-relaxed text-slate-500">
						Deploying this site? Set <span class="text-accent-violet">PUBLIC_STANDARD_REPO_URL</span>,{' '}
						<span class="text-accent-blue">PUBLIC_MCP_REPO_URL</span> to the MCP service (default{' '}
						<code class="text-slate-400">https://mcp.aadm.io</code>), and optionally{' '}
						<span class="text-accent-violet">PUBLIC_MCP_QUICKSTART_URL</span> for the marketing page (default{' '}
						<code class="text-slate-400">https://aadm.io/mcp</code>).
					</p>
				</div>
			</div>
		</section>

		<section
			id="aadm-planning"
			class="border-t border-border-subtle bg-surface-mid/30 py-16 sm:py-24"
			aria-labelledby="aadm-planning-heading"
		>
			<div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
				<div>
					<p
						class="mb-3 inline-flex rounded-full border border-border-subtle bg-surface-card/60 px-3 py-1 text-xs font-medium uppercase tracking-wider text-accent-violet"
					>
						Navigator lane
					</p>
					<h2 id="aadm-planning-heading" class="font-display text-2xl font-bold text-white sm:text-3xl">
						AADM for planning
					</h2>
					<p class="mt-4 text-lg leading-relaxed text-slate-400">
						The AADM MCP helps you <strong class="font-semibold text-slate-300">plan before implementation</strong>:
						turn vague goals into layer-aware work—who owns what across UDALI, which AUTH hooks matter, and in
						what order changes should land. Your agents get the same routing and handoff language your team
						uses, so “plan the sprint” and “classify the bug” do not collapse into one generic chat.
					</p>
					<p class="mt-4 text-slate-400">
						Tools like <code class="font-mono-cta text-sm text-accent-blue">plan_delivery</code> and{' '}
						<code class="font-mono-cta text-sm text-accent-blue">map_feature</code> sit in the{' '}
						<strong class="text-slate-300">Navigator</strong> path: scope, verify, and readiness—without
						guessing layer ownership after the fact.
					</p>
					<p class="mt-6">
						<a
							href={urlMcpMarketing}
							class="inline-flex items-center text-sm font-semibold text-accent-violet underline decoration-accent-violet/40 underline-offset-4 transition hover:text-accent-blue hover:decoration-accent-blue/50"
						>
							Connect agents to hosted MCP
						</a>
					</p>
				</div>
				<div>
					<figure
						class="overflow-hidden rounded-2xl border border-border-subtle bg-surface-card/50 shadow-2xl shadow-black/30"
					>
						<img
							src="/images/aadm-planning-example.png"
							width="1200"
							height="800"
							loading="lazy"
							decoding="async"
							class="h-auto w-full object-cover object-top"
							alt="Example AADM analysis: friction points mapped to UDALI layers and roles, with phased implementation order."
						/>
						<figcaption class="border-t border-border-subtle px-4 py-3 text-xs leading-relaxed text-slate-500">
							Example output: layer ownership matrix and phased implementation order from an agent-assisted planning pass.
						</figcaption>
					</figure>
				</div>
			</div>
		</section>

	</main>
</Layout>
