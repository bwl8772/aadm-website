---
import Layout from '../layouts/Layout.astro';

const trim = (v: string | undefined) => (typeof v === 'string' ? v.trim() : '');

const urlStandard = trim(import.meta.env.PUBLIC_STANDARD_REPO_URL) || '#configure-standard-url';
const urlMcpEndpoint = trim(import.meta.env.PUBLIC_MCP_REPO_URL);
const urlMcpQuickstart = trim(import.meta.env.PUBLIC_MCP_QUICKSTART_URL) || '#configure-quickstart-url';
const urlMcpCustomerDocs = trim(import.meta.env.PUBLIC_MCP_CUSTOMER_DOCS_URL);
const hasMcpDocsLink = urlMcpQuickstart.length > 0 && !urlMcpQuickstart.startsWith('#');

const urlClerkSignIn =
	trim(import.meta.env.PUBLIC_CLERK_SIGN_IN_URL) || 'https://accounts.aadm.io/sign-in';
const urlClerkSignUp =
	trim(import.meta.env.PUBLIC_CLERK_SIGN_UP_URL) || 'https://accounts.aadm.io/sign-up';

let healthUrl = '';
let discoveryUrl = '';
try {
	if (urlMcpEndpoint) {
		const u = new URL(urlMcpEndpoint);
		healthUrl = `${u.origin}/health`;
		discoveryUrl = `${u.origin}/`;
	}
} catch {
	/* ignore invalid PUBLIC_MCP_REPO_URL */
}

const curlInit = urlMcpEndpoint
	? `curl -s -X POST ${urlMcpEndpoint} \\
  -H "Content-Type: application/json" \\
  -H "Accept: application/json, text/event-stream" \\
  -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"smoke","version":"1.0.0"}}}'`
	: '';
---

<Layout title="AADM — Agentic Authority Delivery Model">
	<a
		href="#main"
		class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-violet-600 focus:px-4 focus:py-2 focus:text-white"
		>Skip to content</a
	>

	<header
		class="sticky top-0 z-40 border-b border-border-subtle bg-surface-deep/80 backdrop-blur-md"
	>
		<div
			class="mx-auto flex min-h-14 max-w-6xl items-center gap-2 px-3 py-2 sm:h-16 sm:gap-4 sm:px-6 sm:py-0"
		>
			<span class="shrink-0 font-display text-base font-bold tracking-tight text-white sm:text-lg">
				AADM
			</span>
			<nav
				class="scrollbar-none flex min-w-0 flex-1 flex-nowrap items-center justify-end gap-1.5 overflow-x-auto pb-0.5 sm:gap-2 sm:overflow-visible sm:pb-0 md:gap-3 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
				aria-label="Primary"
			>
				<a
					href={urlStandard}
					aria-label="View the AADM standard"
					class="shrink-0 whitespace-nowrap rounded-lg border border-border-subtle bg-surface-card/80 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:border-slate-500/40 hover:bg-surface-mid sm:px-3 sm:py-2 sm:text-sm md:px-4"
				>
					<span class="md:hidden">Standard</span>
					<span class="hidden md:inline">View the Standard</span>
				</a>
				<a
					href={urlMcpQuickstart}
					aria-label="Get MCP access"
					class="shrink-0 whitespace-nowrap rounded-lg bg-gradient-to-r from-violet-600 to-blue-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-lg shadow-violet-900/30 transition hover:brightness-110 sm:px-3 sm:py-2 sm:text-sm md:px-4"
				>
					<span class="md:hidden">MCP</span>
					<span class="hidden md:inline">Get MCP Access</span>
				</a>
				<a
					href={urlClerkSignIn}
					rel="noopener noreferrer"
					aria-label="Log in to your account"
					class="shrink-0 whitespace-nowrap rounded-lg border border-border-subtle px-2.5 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-slate-500/50 hover:bg-surface-card/60 hover:text-white sm:px-3 sm:py-2 sm:text-sm md:px-4"
				>
					<span class="sm:hidden">Login</span>
					<span class="hidden sm:inline">Log in</span>
				</a>
				<a
					href={urlClerkSignUp}
					rel="noopener noreferrer"
					class="shrink-0 whitespace-nowrap rounded-lg border border-violet-500/40 bg-violet-950/40 px-2.5 py-1.5 text-xs font-semibold text-white transition hover:border-violet-400/60 hover:bg-violet-900/50 sm:px-3 sm:py-2 sm:text-sm md:px-4"
				>
					<span class="sm:hidden">Join</span>
					<span class="hidden sm:inline">Sign up</span>
				</a>
			</nav>
		</div>
	</header>

	<main id="main">
		<section class="mx-auto max-w-6xl px-4 pb-20 pt-16 sm:px-6 sm:pt-24">
			<p
				class="mb-4 inline-flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-wider text-slate-400"
			>
				<span
					class="rounded-full border border-border-subtle bg-surface-card/60 px-3 py-1 text-accent-blue"
					>Published standard</span
				>
				<span class="rounded-full border border-border-subtle bg-surface-card/60 px-3 py-1 text-accent-violet"
					>MCP access</span
				>
			</p>
			<h1
				class="font-display max-w-3xl text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl"
			>
				Governed software delivery for
				<span class="bg-gradient-to-r from-accent-violet to-accent-blue bg-clip-text text-transparent">
					humans and agents
				</span>
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
				We <strong class="font-semibold text-slate-300">publish the standard</strong> in the open—definitions,
				templates, and governance narrative anyone can read and adopt.{' '}
				<strong class="font-semibold text-slate-300">MCP access</strong> is separate: a private, hosted service
				so subscribers’ agents get versioned tools and resources without us open-sourcing the MCP implementation.
			</p>
			<div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
				<a
					href={urlStandard}
					class="inline-flex items-center justify-center rounded-xl border border-border-subtle bg-surface-card px-6 py-3.5 text-base font-semibold text-white shadow-sm transition hover:border-slate-500/40 hover:bg-surface-mid"
				>
					View the Standard
				</a>
				<a
					href={urlMcpQuickstart}
					class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-violet-600 via-violet-600 to-blue-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-violet-950/40 transition hover:brightness-110"
				>
					Get MCP Access
				</a>
			</div>
			<p class="mt-4 text-sm text-slate-500">
				The MCP does not enforce production AUTH — your services, gateways, tests, and CI remain
				authoritative.
			</p>
		</section>

		<section class="border-y border-border-subtle bg-surface-mid/40 py-16 sm:py-20">
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<h2 class="font-display text-center text-2xl font-bold text-white sm:text-3xl">
					Three equal agent workflows
				</h2>
				<p class="mx-auto mt-3 max-w-2xl text-center text-slate-400">
					AADM MCP surfaces three equal workflows: pick the lane that matches the primary question — not
					everything is “bug chat.”
				</p>
				<ul class="mt-12 grid gap-6 sm:grid-cols-3">
					<li
						class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20"
					>
						<h3 class="font-display text-lg font-bold text-accent-violet">Navigator</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">
							Planned delivery — scope, verify, readiness for net new or material improvement.
						</p>
					</li>
					<li
						class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20"
					>
						<h3 class="font-display text-lg font-bold text-accent-blue">Investigator</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">
							Defects — evidence-gated recon before deep diagnosis; remediation when classified.
						</p>
					</li>
					<li
						class="rounded-2xl border border-border-subtle bg-surface-card/80 p-6 shadow-xl shadow-black/20"
					>
						<h3 class="font-display text-lg font-bold text-violet-300">Sentinel</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">
							Assurance — prove existing alignment with AUTH, UDALI, and evidence across seams.
						</p>
					</li>
				</ul>
			</div>
		</section>

		<section id="mcp-quickstart" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
			<h2 class="font-display text-2xl font-bold text-white sm:text-3xl">MCP access — quick reference</h2>
			<p class="mt-3 text-sm text-slate-500">
				URLs below come from your environment—use production subscriber endpoints when you ship this site.
			</p>
			<p class="mt-4 max-w-3xl text-slate-400">
				The hosted MCP service speaks <strong class="text-slate-300">MCP over Streamable HTTP</strong>:
				clients <code class="rounded bg-surface-card px-1.5 py-0.5 font-mono-cta text-sm text-accent-violet"
					>POST</code
				> to the MCP path with <code class="font-mono-cta text-sm text-slate-300">Accept: application/json, text/event-stream</code>.
				Use <code class="font-mono-cta text-sm text-slate-300">GET /health</code> for load balancers (not MCP protocol traffic). Opening the MCP path in a browser often returns <strong class="text-slate-300">406</strong> without that Accept header — that is expected.
			</p>

			{
				urlMcpEndpoint ? (
					<div class="mt-8 space-y-6">
						<div class="flex flex-wrap gap-3">
							<a
								href={urlMcpQuickstart}
								class="inline-flex items-center rounded-lg bg-gradient-to-r from-violet-600 to-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:brightness-110"
							>
								MCP documentation
							</a>
							{healthUrl ? (
								<a
									href={healthUrl}
									class="inline-flex items-center rounded-lg border border-border-subtle bg-surface-card px-4 py-2 text-sm font-semibold text-white transition hover:bg-surface-mid"
								>
									GET /health
								</a>
							) : null}
							{discoveryUrl ? (
								<a
									href={discoveryUrl}
									class="inline-flex items-center rounded-lg border border-border-subtle bg-surface-card px-4 py-2 text-sm font-semibold text-white transition hover:bg-surface-mid"
								>
									GET / (discovery)
								</a>
							) : null}
						</div>
						<div>
							<p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">
								MCP HTTP URL
							</p>
							<p class="break-all font-mono-cta text-sm text-accent-blue">{urlMcpEndpoint}</p>
						</div>
						<div>
							<p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">
								Smoke: initialize (JSON-RPC over HTTP)
							</p>
							<pre
								class="overflow-x-auto rounded-2xl border border-border-subtle bg-surface-card/90 p-4 font-mono-cta text-xs leading-relaxed text-slate-300 sm:text-sm"><code>{curlInit}</code></pre>
						</div>
						{hasMcpDocsLink ? (
							<p class="text-sm text-slate-500">
								Server implementation is proprietary; subscriber guides and setup live on the{' '}
								<a href={urlMcpQuickstart} class="font-semibold text-accent-violet underline hover:text-accent-blue">
									MCP documentation site
								</a>
								.
							</p>
						) : (
							<p class="text-sm text-slate-500">
								Set <code class="font-mono-cta text-slate-400">PUBLIC_MCP_QUICKSTART_URL</code> to your public
								subscriber docs (for example <code class="font-mono-cta text-slate-400">https://aadm.io/mcp</code>).
							</p>
						)}
						{urlMcpCustomerDocs ? (
							<p class="text-sm text-slate-500">
								Additional material:{' '}
								<a href={urlMcpCustomerDocs} class="font-semibold text-accent-violet underline hover:text-accent-blue">
									Customer documentation
								</a>
							</p>
						) : null}
					</div>
				) : (
					<p class="mt-6 rounded-xl border border-dashed border-slate-600/50 bg-surface-mid/50 p-4 text-sm text-slate-500">
						Set <span class="font-mono-cta text-slate-400">PUBLIC_MCP_REPO_URL</span> in{' '}
						<code class="font-mono-cta text-slate-400">.env</code> to show your MCP endpoint, health link, and curl
						example.
					</p>
				)
			}
		</section>

		<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
			<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
				<div>
					<h2 class="font-display text-2xl font-bold text-white sm:text-3xl">Published standard vs MCP</h2>
					<p class="mt-4 text-slate-400">
						The <strong class="text-slate-300">standard</strong> lives in the public repository for humans,
						tickets, and audits. <strong class="text-slate-300">MCP</strong> is subscriber infrastructure we
						operate as hosted infrastructure—connection details and SLAs come with access, not from a public server repo.
						Nothing here replaces your production AUTH, gateways, or CI.
					</p>
				</div>
				<div class="space-y-4">
					<div
						class="rounded-2xl border border-border-subtle bg-surface-card/90 p-5 font-mono-cta text-sm"
					>
						<p class="text-xs font-medium uppercase tracking-wide text-slate-500">Environment</p>
						<p class="mt-2 text-slate-300">
							Use <span class="text-accent-violet">PUBLIC_STANDARD_REPO_URL</span>,{' '}
							<span class="text-accent-blue">PUBLIC_MCP_REPO_URL</span> (MCP HTTP URL),{' '}
							<span class="text-accent-violet">PUBLIC_MCP_QUICKSTART_URL</span> (subscriber docs, e.g. /mcp on your main site). Optional:{' '}
							<span class="text-accent-blue">PUBLIC_MCP_CUSTOMER_DOCS_URL</span> (private subscriber docs). No spaces after{' '}
							<code class="text-slate-400">=</code>.
						</p>
					</div>
					<div
						class="rounded-2xl border border-dashed border-slate-600/50 bg-surface-mid/50 p-5 text-sm text-slate-500"
					>
						This repository is only the marketing shell. Point env vars at your public standard repo, MCP
						endpoint, operator portal, and (if you have one) a subscriber-only docs base URL.
					</div>
				</div>
			</div>
		</section>

		<footer class="border-t border-border-subtle py-10">
			<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 text-center text-sm text-slate-500 sm:flex-row sm:text-left sm:px-6">
				<span class="font-display font-semibold text-slate-400">AADM</span>
				<p>Static site — Astro. Not a substitute for organizational sign-off or audits.</p>
			</div>
		</footer>
	</main>
</Layout>
