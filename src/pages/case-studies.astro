			{ id: "repo_feature_map", label: "Map one feature from what is known" },
			{ id: "map_feature", label: "Map the feature and its blockers" },
		],
		tone: "sky",
	},
	{
		id: "28",
		app: "Granite Mutual",
		industry: "Insurance",
		title: "FDE: tools the customer keeps",
		situation:
			"The customer wanted their own agents to quote and file claims against your core backend, safely, after the FDE left.",
		decision:
			"Hand over raw API keys and a wiki page, or ship governed tools the customer can run themselves.",
		actions:
			"The FDE used AADM to design an MCP server, a small set of APIs and agent skills on top of the core: checked each tool's schema across model providers, scoped what every agent may do, and wrote the proof each tool needed before release.",
		impact:
			"The customer runs their own MCP, APIs and skills on your core, with permissions and tests they understand and can change.",
		hoursLow: 35,
		hoursHigh: 55,
		tools: [
			{
				id: "llm_tool_schema_compat",
				label: "Check tool schemas work across models",
			},
			{ id: "agent_op_contract_check", label: "Check what the agent may do" },
			{ id: "assurance_run", label: "Prove readiness one step at a time" },
		],
		tone: "violet",
	},
	{
		id: "29",
		app: "Northstar Retail",
		industry: "Retail",
		title: "Ten agents, one codebase",
		situation:
			"The team ran several coding agents at once and spent more time on merge conflicts than on features.",
		decision: "Run fewer agents, or split the work better.",
		actions:
			"The agent split work so no two agents touched the same files, checked each branch before merge, and recorded what each run got wrong.",
		impact:
			"Parallel work that merges cleanly, and agents that learn between runs.",
		hoursLow: 25,
		hoursHigh: 40,
		tools: [
			{ id: "fanout_guide", label: "Split work across agents" },
			{ id: "chunk_branch_check", label: "Check each branch before merge" },
			{ id: "lessons_register", label: "Record what each run got wrong" },
		],
		tone: "violet",
	},
];
const toneClasses: Record<
	Vignette["tone"],
	{ numeral: string; rule: string; chip: string; hour: string }
> = {
	violet: {
		numeral: "text-brand-violet",
		rule: "border-violet-400/40",
		chip: "border-violet-400/30 text-brand-violet",
		hour: "border-brand-violet/40 bg-accent text-brand-violet",
	},
	amber: {
		numeral: "text-brand-warn",
		rule: "border-brand-warn-border",
		chip: "border-brand-warn-border text-brand-warn",
		hour: "border-brand-warn-border bg-brand-warn-bg text-brand-warn",
	},
	sky: {
		numeral: "text-brand-sky",
		rule: "border-sky-400/40",
		chip: "border-sky-400/30 text-brand-sky",
		hour: "border-brand-sky/40 bg-accent text-brand-sky",
	},
	emerald: {
		numeral: "text-brand-mcp",
		rule: "border-brand-mcp-border",
		chip: "border-brand-mcp-border text-brand-mcp",
		hour: "border-brand-mcp-border bg-brand-mcp-bg text-brand-mcp",
	},
};

const totalLow = vignettes.reduce((s, v) => s + v.hoursLow, 0);
const totalHigh = vignettes.reduce((s, v) => s + v.hoursHigh, 0);

const toneCounts = { violet: 0, amber: 0, sky: 0, emerald: 0 };
for (const v of vignettes) toneCounts[v.tone]++;
const vignetteVisuals = gridVisualPlacements(vignettes.length, 2);

const industryRollup: Array<{ industry: Industry; count: number }> = (() => {
	const map = new Map<Industry, number>();
	for (const v of vignettes)
		map.set(v.industry, (map.get(v.industry) ?? 0) + 1);
	return Array.from(map.entries())
		.map(([industry, count]) => ({ industry, count }))
		.sort((a, b) => b.count - a.count);
})();
