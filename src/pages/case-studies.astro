					<!-- Colophon -->
					<div class="mt-24 grid grid-cols-12 gap-6 border-t border-white/[0.06] pt-8 font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-600">
						<div class="col-span-12 sm:col-span-4">
							<span class="text-slate-500">Catalog</span> · {vignettes.length} vignettes
						</div>
						<div class="col-span-12 sm:col-span-4">
							<span class="text-slate-500">Period</span> · <span class="text-emerald-300/80">2026-05-28 → 2026-06-27</span>
						</div>
						<div class="col-span-12 sm:col-span-4">
							<span class="text-slate-500">Hours band</span> · <span class="text-emerald-300/80">~{totalLow.toLocaleString()}–{totalHigh.toLocaleString()} engineer-hours redirected</span>
