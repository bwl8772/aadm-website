---
import Layout from "../../layouts/Layout.astro";
import { FIELD_HOME_PATH } from "../../lib/field-area";

/** Public Field marketing page. The signed-in app is `/field/main` (protected by middleware). */

const surfaces = [
	{
		num: "01",
		name: "My Field",
		job: "Where to act next, across every engagement: what's waiting on you, what's waiting on the customer, and why the top item is on top.",
	},
	{
		num: "02",
		name: "Engagement Workbench",
		job: "Where you act, with the right specialist agent, against one shared engagement record: outcome, baseline, target, and the next milestone in view.",
	},
	{
		num: "03",
		name: "Artifact Studio",
		job: "A workbench mode for one deliverable: review it, approve it, publish it. An agent saying it's done doesn't publish anything.",
	},
];

const lenses = [
	{ name: "Strategy", question: "Is this a valuable problem, with a baseline and a target?" },
	{ name: "Plan", question: "Is delivery scoped, sequenced, and owned?" },
	{ name: "Readiness", question: "Are the customer's data, people, and process ready?" },
	{ name: "Adopt", question: "Are users changing how they work?" },
	{ name: "Governance", question: "Who decides, who accepts, and who can see what?" },
];

const notList = [
	"a compliance console",
	"an uptime dashboard",
	"a CRM or PSA",
	"an IDE",
	"a chat archive",
];
---

<Layout
	title="AADM Field — from a business problem to an adopted AI solution"
	description="AADM Field keeps the decisions, customer commitments, artifacts, and delivery plan for an engagement in one record, so engineers know where to act next."
	headerActiveNav="field"
>
	<main id="main" class="relative isolate overflow-x-clip bg-surface-deep text-text-primary">

		<!-- =============================================================
		     §00 — Hero
		     ============================================================= -->
		<section class="relative border-b border-border">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[length:28px_28px] [mask-image:radial-gradient(ellipse_at_top,black_55%,transparent_85%)]"></div>
			<div aria-hidden="true" class="absolute left-0 top-0 -z-10 h-[36rem] w-[36rem] -translate-x-1/3 -translate-y-1/3 rounded-full bg-emerald-500/[0.06] blur-3xl"></div>

			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 pb-20 pt-10 sm:px-8 sm:pb-28 sm:pt-16">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ 00</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Field</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<p class="font-mono-cta mb-10 text-[13px] normal-case tracking-[0.01em] text-muted-foreground">
						<span class="text-brand-mcp">▸</span> For forward-deployed engineers · early access
					</p>

					<h1 class="font-display max-w-[18ch] text-balance text-[clamp(2.4rem,8vw,6.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						Know where to act. <span class="font-light italic text-muted-foreground">Then act.</span>
					</h1>

					<div class="mt-14 grid grid-cols-12 gap-6">
						<div class="col-span-12 sm:col-span-4">
							<div class="border-l border-brand-mcp-border pl-5">
								<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">One record</p>
								<p class="mt-3 text-[0.95rem] leading-relaxed text-text-secondary">
									Work from Field, Claude, or Slack. Every client reads and writes the same engagement, so nobody keeps a second plan.
								</p>
							</div>
						</div>
						<div class="col-span-12 sm:col-span-8">
							<p class="text-pretty text-lg leading-[1.65] text-text-secondary sm:text-xl">
								AADM Field holds the decisions, customer commitments, artifacts, and delivery plan that take an ambiguous business
								problem to an AI solution the customer actually uses. It tells you what's next, puts the right specialist in front of
								you, and records what changed —
								<span class="font-light italic text-muted-foreground"> without losing the plan along the way.</span>
							</p>
						</div>
					</div>

					<div class="mt-14 flex flex-col flex-wrap items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
						<a
							href={FIELD_HOME_PATH}
							class="group inline-flex items-center gap-3 bg-foreground px-6 py-3.5 text-sm font-semibold tracking-tight text-background outline-none transition duration-200 hover:bg-brand-mcp hover:text-brand-mcp-fg focus-visible:ring-2 focus-visible:ring-brand-mcp focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>Open Field</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href="#surfaces"
							class="inline-flex items-center gap-2 border border-border bg-transparent px-6 py-3.5 text-sm font-semibold text-foreground outline-none transition duration-200 hover:border-foreground/25 hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							See how it works
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §01 — Surfaces
		     ============================================================= -->
		<section id="surfaces" class="relative scroll-mt-24 border-b border-border bg-surface-mid sm:scroll-mt-28">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ 01</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">How it works</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[22ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						One click from priority <span class="font-light italic text-muted-foreground">to execution.</span>
					</h2>
					<p class="mt-5 max-w-3xl text-base leading-relaxed text-muted-foreground">
						Two screens and one studio mode. No overview page to click through before you can do anything.
					</p>

					<div class="mt-14 grid grid-cols-1 gap-px bg-border sm:grid-cols-3">
						{
							surfaces.map((s) => (
								<article class="group bg-surface-mid p-7 transition duration-300 hover:bg-secondary sm:p-9">
									<span class="font-display text-5xl font-light leading-none text-brand-mcp sm:text-6xl">{s.num}</span>
									<h3 class="font-display mt-7 text-balance text-xl font-bold leading-snug tracking-tight text-foreground">
										{s.name}
									</h3>
									<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{s.job}</p>
								</article>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §02 — Lenses
		     ============================================================= -->
		<section class="relative border-b border-border">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-warn">§ 02</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Five lenses</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[22ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						Five questions at once. <span class="font-light italic text-muted-foreground">Not one "current phase."</span>
					</h2>
					<p class="mt-5 max-w-3xl text-base leading-relaxed text-muted-foreground">
						Real engagements don't move in a straight line. Field shows each lens's status side by side, with the action that
						unblocks it, so a stalled plan never hides behind a healthy strategy.
					</p>

					<dl class="mt-14 grid grid-cols-1 gap-px bg-border sm:grid-cols-5">
						{
							lenses.map((l) => (
								<div class="bg-surface-deep p-6">
									<dt class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-warn">{l.name}</dt>
									<dd class="mt-3 text-sm leading-relaxed text-text-secondary">{l.question}</dd>
								</div>
							))
						}
					</dl>

					<div class="mt-16 border-l-2 border-brand-warn-border pl-6">
						<p class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-warn">Proof comes with the work</p>
						<p class="mt-3 max-w-2xl text-base leading-relaxed text-text-secondary">
							Decisions, evidence, and verdicts are recorded as the work runs and sit one click below the answer. You get the
							audit trail without filling anything in for it.
						</p>
						<p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
							Field is not {notList.slice(0, -1).join(", ")}, or {notList[notList.length - 1]}.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §03 — Final CTA
		     ============================================================= -->
		<section class="relative bg-surface-deep">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_bottom,rgba(110,231,183,0.07),transparent_60%)]"></div>
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-28 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-10 flex items-baseline justify-between gap-4 border-b border-border pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-border sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-brand-mcp">§ 03</span>
					<span class="font-mono-cta text-[13px] normal-case tracking-[0.01em] text-muted-foreground">Start here</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 class="font-display max-w-[18ch] text-balance text-[clamp(2rem,5.5vw,4.4rem)] font-bold leading-[1.08] tracking-[-0.01em] text-foreground">
						One engagement. <span class="font-light italic text-muted-foreground">One record.</span><br />
						<span class="relative inline-block">
							<span class="relative z-10 text-brand-mcp">Every client.</span>
							<span aria-hidden="true" class="absolute inset-x-0 bottom-[0.1em] -z-0 h-[0.18em] bg-emerald-300/30"></span>
						</span>
					</h2>
					<p class="mt-6 max-w-2xl text-base leading-relaxed text-text-secondary">
						Sign in with your AADM account to open Field. The hosted MCP gives your agents the same standard on every turn.
					</p>

					<div class="mt-14 flex flex-col flex-wrap items-start gap-4 sm:flex-row sm:items-center sm:gap-5">
						<a
							href={FIELD_HOME_PATH}
							class="group inline-flex items-center gap-3 bg-foreground px-7 py-4 text-sm font-semibold tracking-tight text-background outline-none transition duration-200 hover:bg-brand-mcp hover:text-brand-mcp-fg"
						>
							<span>Open Field</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href="/mcp"
							class="inline-flex items-center gap-2 border border-border bg-transparent px-7 py-4 text-sm font-semibold text-foreground outline-none transition duration-200 hover:border-foreground/25 hover:bg-accent"
						>
							See the hosted MCP
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
