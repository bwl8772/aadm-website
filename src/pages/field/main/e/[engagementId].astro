---
export const prerender = false;

import {
	StudioModelSchema,
	WorkbenchModelSchema,
} from "../../../../components/field/field-types";
import SessionWatch from "../../../../components/field/SessionWatch";
import ArtifactStudio from "../../../../components/field/studio/ArtifactStudio";
import EngagementWorkbench from "../../../../components/field/workbench/EngagementWorkbench";
import SessionGatePage from "../../../../components/SessionGatePage.astro";
import Layout from "../../../../layouts/Layout.astro";
import { getSignInUrlForRequest } from "../../../../lib/clerk-portal-urls";
import { FIELD_HOME_PATH } from "../../../../lib/field-area";
import { fieldFixture } from "../../../../lib/field-fixtures";

const { userId } = Astro.locals.auth();
const gate = Astro.locals.sessionGate;
const signInUrl = getSignInUrlForRequest(Astro.request, import.meta.env);
const { engagementId = "" } = Astro.params;

/** Example data only when PUBLIC_FIELD_FIXTURES=1; otherwise no data until the backend read model is wired. */
/** `?artifact={id}` opens Artifact Studio on the same route (FIELD-VISION §5). */
const artifactId = Astro.url.searchParams.get("artifact");
const workbenchHref = `/field/main/e/${engagementId}`;
const raw = artifactId
	? ((fieldFixture("studio") as Record<string, unknown> | null)?.[artifactId] ??
		null)
	: ((fieldFixture("workbench") as Record<string, unknown> | null)?.[
			engagementId
		] ?? null);
const studioParsed =
	raw && artifactId ? StudioModelSchema.safeParse(raw) : null;
const workbenchParsed =
	raw && !artifactId ? WorkbenchModelSchema.safeParse(raw) : null;
const parsed = studioParsed ?? workbenchParsed;
/** RES-05: a malformed model is a visible error, never "not found". */
const studio = studioParsed?.success ? studioParsed.data : null;
const workbench = workbenchParsed?.success ? workbenchParsed.data : null;
const model = studio ?? workbench;
const modelError = parsed && !parsed.success;
---

<Layout
	title={model ? `${model.customer} · ${model.name} — AADM Field` : "Engagement — AADM Field"}
	description="AADM Field engagement workbench."
	footerVariant="default"
	showHeader={false}
	showFooter={false}
>
	{
		userId ? (
			modelError ? (
				<main id="main" class="mx-auto w-full min-w-0 max-w-5xl px-4 py-10 sm:px-8 sm:py-16">
					<h1 class="text-2xl font-bold text-foreground">Something broke on our side</h1>
					<p class="mt-3 text-text-secondary">Engagement data did not match its contract.</p>
				</main>
			) : model ? (
				<>
					{studio ? (
						<ArtifactStudio client:load model={studio} workbenchHref={workbenchHref} />
					) : workbench ? (
						<EngagementWorkbench client:load model={workbench} />
					) : null}
					<SessionWatch client:load signInUrl={signInUrl} />
				</>
			) : (
				<main id="main" class="mx-auto w-full min-w-0 max-w-5xl px-4 py-10 sm:px-8 sm:py-16">
					<h1 class="text-2xl font-bold text-foreground">No such engagement for you</h1>
					<p class="mt-3 text-text-secondary">
						<a href={FIELD_HOME_PATH} class="text-accent-blue hover:underline">Back to My Field</a>
					</p>
				</main>
			)
		) : gate ? (
			<main id="main" class="mx-auto w-full min-w-0 max-w-5xl px-4 py-10 sm:px-8 sm:py-16">
				<SessionGatePage gate={gate} />
			</main>
		) : null
	}
</Layout>
