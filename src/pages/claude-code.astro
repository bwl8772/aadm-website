---
import { Show } from "@clerk/astro/components";
import Layout from "../layouts/Layout.astro";
import { getAccountPortalUrls } from "../lib/account-portal-urls";
import { getSiteUrlConfig } from "../lib/site-urls";

const cfg = getSiteUrlConfig(import.meta.env);
const { urlStandard, urlMcpMarketing, urlMcpRpcUrl, discoveryUrl } = cfg;
const {
	signInUrl,
	signUpUrl,
	memberAreaUrl,
	memberMcpOAuthUrl,
	memberSignInUrl,
	memberMcpOAuthSignInUrl,
} = getAccountPortalUrls(import.meta.env);

const claudeMcpConfigUrl = urlMcpRpcUrl;

const claudeMcpFullConfigSnippet = `{
  "mcpServers": {
    "aadm": {
      "type": "http",
      "url": "${claudeMcpConfigUrl}",
      "headers": {
        "Authorization": "<your token here>"
      }
    }
  }
}`;

const capabilities = [
	{
		letter: "A",
		name: "Navigator-style delivery",
		body: "Pull plan_delivery, doctrine slices, and AUTH cites while shaping a feature across layers.",
		tools: "plan_delivery",
	},
	{
		letter: "B",
		name: "Investigator defects",
		body: "Use debug_defect for gated recon and classification. Append evidence across turns without rewriting the brief.",
		tools: "debug_defect",
	},
	{
		letter: "C",
		name: "Sentinel assurance",
		body: "Run audit_run / audit_outline for seam language. Bind horizontal boundaries while Claude traces files locally.",
		tools: "audit_run · audit_outline",
	},
	{
		letter: "D",
		name: "AUTH literacy",
		body: "fetch_auth returns the real markdown for AUTH-XX so reviews cite governance text — not memory.",
		tools: "fetch_auth",
	},
	{
		letter: "E",
		name: "Orchestrator hooks",
		body: "route_lane, orchestrator_anchor, and standard_brief give deterministic branching for long sessions.",
		tools: "route_lane · orchestrator_anchor",
	},
	{
		letter: "F",
		name: "Proof stays local",
		body: "MCP never replaces CI. Claude runs tests you invoke; pass/fail remains authoritative in your pipeline.",
		tools: "your CI",
	},
];
---

<Layout
	title="AADM + Claude Code — MCP setup and workflows"
	description="Connect Claude Desktop and Claude Code CLI to the hosted AADM MCP: subscriber token, HTTP transport, Navigator / Investigator / Sentinel workflows, and illustrative deep-dive transcripts."
	headerActiveNav={null}
>
	<main id="main" class="relative isolate overflow-x-clip bg-surface-deep text-slate-100">

		<!-- =============================================================
		     §00 — Hero
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06]">
			<div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(rgba(148,163,184,0.06)_1px,transparent_1px)] bg-[length:28px_28px] [mask-image:radial-gradient(ellipse_at_top,black_55%,transparent_85%)]"></div>
			<div aria-hidden="true" class="absolute right-0 top-0 -z-10 h-[36rem] w-[36rem] translate-x-1/3 -translate-y-1/3 rounded-full bg-amber-500/[0.07] blur-3xl"></div>
			<div aria-hidden="true" class="absolute left-0 top-32 -z-10 h-[36rem] w-[36rem] -translate-x-1/3 rounded-full bg-violet-500/[0.06] blur-3xl"></div>

			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 pb-20 pt-10 sm:px-8 sm:pb-28 sm:pt-16">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-amber-200/70">§ 00</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">AADM + Claude Code</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<p class="font-mono-cta mb-8 flex flex-wrap items-center gap-3 text-[10px] uppercase tracking-[0.28em] text-slate-500">
						<span class="inline-flex items-center gap-2 border border-amber-300/30 px-2.5 py-1 text-amber-200/90">
							<span class="block h-1 w-1 rounded-full bg-amber-300"></span> AADM + Claude
						</span>
						<span class="inline-flex items-center gap-2 border border-violet-300/30 px-2.5 py-1 text-violet-200/90">
							<span class="block h-1 w-1 rounded-full bg-violet-300"></span> MCP · Streamable HTTP
						</span>
					</p>

					<h1 class="font-display max-w-[20ch] text-balance text-[clamp(2.3rem,7.5vw,6.2rem)] font-black leading-[0.9] tracking-[-0.04em] text-white">
						Standard in <span class="font-extralight italic text-slate-400">the cloud.</span><br />
						Claude Code in <span class="relative inline-block">
							<span class="relative z-10 text-amber-300">your repo.</span>
							<span aria-hidden="true" class="absolute inset-x-0 bottom-[0.1em] -z-0 h-[0.18em] bg-amber-300/30"></span>
						</span>
					</h1>

					<div class="mt-12 grid grid-cols-12 gap-6">
						<div class="col-span-12 sm:col-span-4">
							<div class="border-l border-amber-300/40 pl-5">
								<p class="font-mono-cta text-[10px] uppercase tracking-[0.25em] text-amber-200/80">The wire</p>
								<p class="mt-3 text-[0.95rem] leading-relaxed text-slate-300">
									Point Claude Desktop or Claude Code at the hosted MCP the same way you wire any HTTP MCP. Subscriber token,
									stable tools, your codebase still owns proof.
								</p>
							</div>
						</div>
						<div class="col-span-12 sm:col-span-8">
							<p class="text-pretty text-lg leading-[1.65] text-slate-300 sm:text-xl">
								Briefs and doctrine come from MCP. <span class="text-white">Tests, CI, and traces</span> stay in your repo. The
								result · Claude runs Navigator, Investigator, and Sentinel workflows with the same discipline a senior reviewer
								would demand.
							</p>
						</div>
					</div>

					<p class="mt-10 font-mono-cta text-[11px] uppercase tracking-[0.18em] text-slate-500">
						<span class="text-emerald-200/85">▸ Step 0</span> · <code class="font-mono-cta text-emerald-200/95">npx aadm-init-repo --full</code> ·
						<a href="/governance" class="text-emerald-300 underline decoration-emerald-300/40 underline-offset-[6px] hover:decoration-emerald-300">init guide</a>
					</p>

					<div class="mt-10 flex flex-col flex-wrap items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
						<a
							href="#connect-claude"
							class="group inline-flex items-center gap-3 bg-white px-6 py-3.5 text-sm font-semibold tracking-tight text-slate-950 outline-none transition duration-200 hover:bg-amber-200 focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							<span>Connection steps & copy-paste</span>
							<svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">
								<path d="M1 5h13M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
							</svg>
						</a>
						<a
							href={urlMcpMarketing}
							class="inline-flex items-center gap-2 border border-white/20 bg-transparent px-6 py-3.5 text-sm font-semibold text-white outline-none transition duration-200 hover:border-white/40 hover:bg-white/[0.04] focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-deep"
						>
							MCP overview & pricing
						</a>
						<a
							href={urlStandard}
							class="group font-mono-cta inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-slate-400 underline decoration-slate-700 underline-offset-[6px] transition hover:text-amber-200 hover:decoration-amber-300"
						>
							<span>Read the standard</span>
							<span aria-hidden="true" class="transition group-hover:translate-x-0.5">↗</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §01 — Connect (steps + JSON + where to paste)
		     ============================================================= -->
		<section
			id="connect-claude"
			class="relative scroll-mt-24 border-b border-white/[0.06] bg-[#06080f] sm:scroll-mt-28"
			aria-labelledby="connect-claude-heading"
		>
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-amber-200/70">§ 01</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Connect Claude</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 id="connect-claude-heading" class="font-display max-w-[22ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-black leading-[0.96] tracking-[-0.025em] text-white">
						Connect AADM MCP <span class="font-extralight italic text-slate-400">to Claude.</span>
					</h2>
					<p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-400">
						One subscriber token, one MCP endpoint. Paste an <code class="font-mono-cta text-slate-300">aadm_…</code> dashboard token
						or <code class="font-mono-cta text-slate-300">Bearer ak_…</code> account API key from your AADM dashboard. Never commit
						real secrets.
					</p>

					<div class="mt-12 grid grid-cols-12 gap-8">
						<!-- Steps -->
						<div class="col-span-12 lg:col-span-6">
							<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-amber-200/85">Steps</p>
							<ol class="mt-6 divide-y divide-white/[0.06] border-t border-white/[0.06]">
								<li class="group grid grid-cols-[auto_1fr] items-baseline gap-4 py-5">
									<span class="font-mono-cta text-[11px] text-amber-300/80">01</span>
									<span class="text-sm leading-relaxed text-slate-300">
										<Show when="signed-out">
											<span>
												<a href={signUpUrl} class="font-semibold text-amber-300 underline decoration-amber-400/40 underline-offset-4 hover:decoration-amber-300">Create an AADM account</a>
												{' '}or{' '}
												<a href={signInUrl} class="font-semibold text-amber-300 underline decoration-amber-400/40 underline-offset-4 hover:decoration-amber-300">sign in</a>,
												subscribe, then copy your OAuth client ID from{' '}
												<a href={memberMcpOAuthSignInUrl} class="text-emerald-300 underline decoration-emerald-300/40 underline-offset-4 hover:decoration-emerald-300">Member area → MCP OAuth</a>{' '}
												(or create an <code class="font-mono-cta text-xs text-slate-300">ak_…</code> key in{' '}
												<a href={memberSignInUrl} class="text-emerald-300 underline decoration-emerald-300/40 underline-offset-4 hover:decoration-emerald-300">Member area → API keys</a>).
											</span>
										</Show>
										<Show when="signed-in">
											<span>
												Create an <code class="font-mono-cta text-xs text-slate-300">ak_…</code> API key in{' '}
												<a href={memberAreaUrl} class="font-semibold text-emerald-300 underline decoration-emerald-300/40 underline-offset-4 hover:decoration-emerald-300">Member area → API keys</a>.
												For Claude OAuth, copy <span class="text-white">your client ID</span> from{' '}
												<a href={memberMcpOAuthUrl} class="font-semibold text-emerald-300 underline decoration-emerald-300/40 underline-offset-4 hover:decoration-emerald-300">Member area → MCP OAuth</a>.
											</span>
										</Show>
									</span>
								</li>
								<li class="group grid grid-cols-[auto_1fr] items-baseline gap-4 py-5">
									<span class="font-mono-cta text-[11px] text-amber-300/80">02</span>
									<span class="text-sm leading-relaxed text-slate-300">
										Merge the JSON below into your Claude config's <code class="font-mono-cta text-xs text-amber-200/85">mcpServers</code> object (see paths for Desktop vs Claude Code).
									</span>
								</li>
								<li class="group grid grid-cols-[auto_1fr] items-baseline gap-4 py-5">
									<span class="font-mono-cta text-[11px] text-amber-300/80">03</span>
									<span class="text-sm leading-relaxed text-slate-300">
										Use the raw token in <code class="font-mono-cta text-xs text-amber-200/85">Authorization</code>, or{' '}
										<code class="font-mono-cta text-xs text-amber-200/85">Bearer ak_…</code> if your build expects that prefix.
									</span>
								</li>
								<li class="group grid grid-cols-[auto_1fr] items-baseline gap-4 py-5">
									<span class="font-mono-cta text-[11px] text-amber-300/80">04</span>
									<span class="text-sm leading-relaxed text-slate-300">
										Fully quit and reopen <span class="text-white">Claude Desktop</span>, or start a{' '}
										<span class="text-white">new Claude Code session</span> in the terminal after saving — hosts do not always
										hot-reload MCP definitions.
									</span>
								</li>
								<li class="group grid grid-cols-[auto_1fr] items-baseline gap-4 py-5">
									<span class="font-mono-cta text-[11px] text-amber-300/80">05</span>
									<span class="text-sm leading-relaxed text-slate-300">
										In chat, ask Claude to use AADM tools — <code class="font-mono-cta text-xs text-emerald-200/85">standard_brief</code>,
										<code class="font-mono-cta text-xs text-emerald-200/85"> debug_defect</code>,
										<code class="font-mono-cta text-xs text-emerald-200/85"> fetch_auth</code>. Confirm{' '}
										<code class="font-mono-cta text-xs text-amber-200/85">tools/list</code> shows{' '}
										<code class="font-mono-cta text-xs text-amber-200/85">aadm</code>.
									</span>
								</li>
							</ol>

							<!-- Where to paste -->
							<div class="mt-10 border border-white/10 bg-[#070b13] p-6">
								<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-amber-200/85">Where to paste</p>
								<dl class="mt-5 space-y-5 text-sm text-slate-400">
									<div>
										<dt class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-amber-300/80">Claude Desktop</dt>
										<dd class="mt-2 font-mono-cta text-[11px] text-slate-500">macOS · ~/Library/Application Support/Claude/claude_desktop_config.json</dd>
										<dd class="mt-1 font-mono-cta text-[11px] text-slate-500">Windows · %APPDATA%\Claude\claude_desktop_config.json</dd>
										<dd class="mt-1 font-mono-cta text-[11px] text-slate-500">Linux · ~/.config/Claude/claude_desktop_config.json</dd>
									</div>
									<div>
										<dt class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-amber-300/80">Claude Code (CLI / IDE)</dt>
										<dd class="mt-2 text-[13px] leading-relaxed text-slate-400">
											User scope · <code class="font-mono-cta text-slate-300">~/.claude.json</code> — merge{' '}
											<code class="font-mono-cta text-slate-300">mcpServers</code>. Optional project file ·{' '}
											<code class="font-mono-cta text-slate-300">.mcp.json</code> in the repo root for teams that version a shared
											template (keep secrets out of git).
										</dd>
									</div>
								</dl>
								<p class="mt-5 text-xs leading-relaxed text-slate-500">
									Anthropic's filenames and reload rules can change by release — double-check current Claude docs if something
									doesn't register. Try <code class="font-mono-cta text-slate-400">claude mcp --help</code> on recent CLI builds.
								</p>
							</div>
						</div>

						<!-- JSON -->
						<div class="col-span-12 lg:col-span-6">
							<div class="border border-white/10 bg-[#050810]">
								<div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/[0.06] px-5 py-3">
									<span class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-slate-500">
										<code class="text-amber-200/85">mcpServers.aadm</code> · copy ready
									</span>
									<button
										type="button"
										id="claude-connect-copy-btn"
										class="font-mono-cta border border-white/20 bg-transparent px-3 py-1.5 text-[10px] uppercase tracking-[0.22em] text-white transition hover:border-white/40 hover:bg-white/[0.04]"
									>
										Copy JSON
									</button>
								</div>
								<pre
									class="font-mono-cta overflow-x-auto p-5 text-xs leading-relaxed text-slate-300 sm:text-sm"
									id="claude-connect-config-pre"
									role="region"
									aria-label="Example Claude MCP configuration JSON"
								><code id="claude-connect-config-code">{claudeMcpFullConfigSnippet}</code></pre>
							</div>
							<p class="mt-4 text-xs text-slate-500">
								<code class="font-mono-cta text-slate-300">url</code> must be{' '}
								<code class="font-mono-cta text-amber-300">{claudeMcpConfigUrl}</code> (include{' '}
								<code class="font-mono-cta text-slate-300">/mcp</code>).
								<br />
								Service discovery · <code class="font-mono-cta text-slate-300">{discoveryUrl || "https://mcp.aadm.io/"}</code>
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<script is:inline>
			(function () {
				const btn = document.getElementById('claude-connect-copy-btn');
				const code = document.getElementById('claude-connect-config-code');
				if (!btn || !code) return;
				const defaultLabel = btn.textContent || 'Copy JSON';
				btn.addEventListener('click', async function () {
					const text = (code.textContent || '').trim();
					try {
						await navigator.clipboard.writeText(text);
						btn.textContent = 'Copied!';
						btn.classList.add('opacity-90');
						window.setTimeout(function () {
							btn.textContent = defaultLabel;
							btn.classList.remove('opacity-90');
						}, 2200);
					} catch {
						btn.textContent = 'Copy blocked — select text';
						window.setTimeout(function () {
							btn.textContent = defaultLabel;
						}, 3200);
					}
				});
			})();
		</script>

		<!-- =============================================================
		     §02 — Desktop vs Terminal
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06]" aria-labelledby="claude-modes-heading">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-amber-200/70">§ 02</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">Desktop vs terminal</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
					<h2 id="claude-modes-heading" class="font-display max-w-[22ch] text-[clamp(1.9rem,4.2vw,3.4rem)] font-black leading-[0.96] tracking-[-0.025em] text-white">
						Desktop vs terminal. <span class="font-extralight italic text-slate-400">Same wire.</span>
					</h2>
					<p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-400">
						Both attach to the same HTTP MCP. The difference is where your files and shell session live — not what AADM ships
						over the wire.
					</p>

					<div class="mt-14 grid grid-cols-1 gap-px bg-white/[0.08] sm:grid-cols-2">
						<article class="bg-surface-deep p-7 sm:p-9">
							<div class="flex items-baseline gap-4">
								<span class="font-display text-5xl font-extralight leading-none text-amber-200/85 sm:text-6xl">D</span>
								<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-amber-200/85">Claude Desktop</p>
							</div>
							<p class="mt-7 text-[0.95rem] leading-relaxed text-slate-300">
								GUI app, broad integrations, good for docs-centric sessions and walking stakeholders through{' '}
								<code class="font-mono-cta text-amber-200/85 text-xs">standard_brief</code> outputs. Paste logs and HAR excerpts into
								chat; pair with local repos manually when you need file paths.
							</p>
						</article>
						<article class="bg-surface-deep p-7 sm:p-9">
							<div class="flex items-baseline gap-4">
								<span class="font-display text-5xl font-extralight leading-none text-violet-300/90 sm:text-6xl">T</span>
								<p class="font-mono-cta text-[10px] uppercase tracking-[0.22em] text-violet-200/85">Claude Code · terminal</p>
							</div>
							<p class="mt-7 text-[0.95rem] leading-relaxed text-slate-300">
								Runs against a working tree · read, search, diff, test commands, and multi-step refactors in one thread.
								Ideal for Investigator loops — MCP supplies gates and doctrine; the CLI supplies
								<span class="text-white"> evidence</span> from your machine.
							</p>
						</article>
					</div>
				</div>
			</div>
		</section>

		<!-- =============================================================
		     §03 — Capabilities (6)
		     ============================================================= -->
		<section class="relative border-b border-white/[0.06] bg-[#06080f]" aria-labelledby="claude-can-heading">
			<div class="mx-auto grid max-w-7xl grid-cols-12 gap-x-6 px-4 py-24 sm:px-8 sm:py-32">
				<aside class="col-span-12 mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4 sm:col-span-2 sm:mb-0 sm:flex-col sm:items-start sm:justify-start sm:gap-3 sm:border-b-0 sm:border-r sm:border-white/[0.08] sm:pb-0 sm:pr-4">
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-emerald-200/70">§ 03</span>
					<span class="font-mono-cta text-[10px] uppercase tracking-[0.28em] text-slate-500">What Claude can do</span>
				</aside>

				<div class="col-span-12 sm:col-span-10">
