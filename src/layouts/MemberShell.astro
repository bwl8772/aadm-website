---
import { SignOutButton } from "@clerk/astro/components";
import Layout from "../layouts/Layout.astro";
import { CLERK_ACCOUNTS_SIGN_IN } from "../lib/clerk-portal-urls";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Member area",
	description = "Connect with a bearer API key (Cursor, curl) or Connectors OAuth (Claude).",
} = Astro.props;
---

<Layout title={title} description={description} headerActiveNav={null} footerVariant="default" showFooter={false}>
	<main id="main" class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
		<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
			<div class="min-w-0 flex-1">
				<h1 class="font-display text-2xl font-bold text-white sm:text-3xl">Member area</h1>
				<p class="mt-2 text-sm text-slate-400">
					Two ways to connect AADM: a personal{" "}
					<strong class="text-slate-300">bearer API key</strong> (Cursor, curl) or{" "}
					<strong class="text-slate-300">Connectors OAuth</strong> (Claude Code / claude.ai). Sign-in
					is at <strong class="text-slate-300">accounts.aadm.io</strong>.
				</p>
			</div>
			<SignOutButton redirectUrl={CLERK_ACCOUNTS_SIGN_IN} asChild>
				<button
					type="button"
					class="shrink-0 rounded-lg border border-white/20 bg-white/5 px-4 py-2 text-sm font-semibold text-white hover:bg-white/10"
				>
					Log out
				</button>
			</SignOutButton>
		</div>
		<slot />
	</main>
</Layout>
