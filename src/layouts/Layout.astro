---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { marketingOriginFromEnv } from "../lib/clerk-portal-urls";
import { getSiteUrlConfig } from "../lib/site-urls";

type HeaderNav =
	| "home"
	| "about"
	| "mcp"
	| "why"
	| "tools"
	| "ides"
	| "stacks"
	| "enterprise"
	| "standard"
	| "stories"
	| "member"
	| null;

interface Props {
	title: string;
	description?: string;
	/** Highlights nav when MCP marketing route is active (`SiteHeader`). */
	headerActiveNav?: HeaderNav;
	/** Optional MCP chip href override (e.g. `#get-access` on `/mcp`). */
	headerMcpNavHref?: string;
	/** Footer variant — shorter tagline on MCP page. */
	footerVariant?: "default" | "mcp";
	/** Set to false to suppress the footer on this page. */
	showFooter?: boolean;
	/** Override OG title (defaults to `title`). */
	ogTitle?: string;
	/** Override OG description (defaults to `description`). */
	ogDescription?: string;
	/** Path or absolute URL for OG / Twitter card image. Defaults to /og-default.svg. */
	ogImage?: string;
	/** Open Graph type — usually "website" or "article". */
	ogType?: "website" | "article";
}

const {
	title,
	description = "Agentic Authority Delivery Model — governed architecture for humans and coding agents.",
	headerActiveNav = null,
	headerMcpNavHref,
	footerVariant = "default",
	showFooter = true,
	ogTitle,
	ogDescription,
	ogImage = "/og-default.png",
	ogType = "website",
} = Astro.props;

const { urlMcpMarketing } = getSiteUrlConfig(import.meta.env);

/** Deployed marketing origin — never use Astro.url.origin (Railway SSR sees localhost:8080). */
const siteOrigin = marketingOriginFromEnv(import.meta.env);

const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageUrl = ogImage.startsWith("http")
	? ogImage
	: new URL(ogImage, siteOrigin).toString();

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<script is:inline>
			(() => {
				const key = "aadm-theme";
				const stored = localStorage.getItem(key);
				const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				const theme =
					stored === "light" || stored === "dark"
						? stored
						: stored === "system"
							? systemDark
								? "dark"
								: "light"
							: "dark";
				const root = document.documentElement;
				root.classList.toggle("dark", theme === "dark");
				root.dataset.theme = theme;
				root.style.colorScheme = theme;
				const meta = document.querySelector('meta[name="theme-color"]');
				if (meta) meta.setAttribute("content", theme === "dark" ? "#05040a" : "#f6f4fb");
			})();
		</script>
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="AADM" />
		<meta property="og:title" content={resolvedOgTitle} />
		<meta property="og:description" content={resolvedOgDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="AADM — the standard your agents load on every turn" />

		<!-- Twitter / X Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={resolvedOgTitle} />
		<meta name="twitter:description" content={resolvedOgDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="AADM — the standard your agents load on every turn" />

		<!-- Theme color (mobile chrome / status bar) -->
		<meta name="theme-color" content="#05040a" />

		<!-- Fonts: weights chosen to support font-light (200/300) and font-bold (900) + italic counterpoint -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-none focus:bg-primary focus:px-4 focus:py-2 focus:font-semibold focus:text-primary-foreground"
			>Skip to content</a
		>
		<!--
			Header auth: sign-in on accounts.aadm.io; Member → /member — see docs/CLERK-AUTH.md
		-->
		<SiteHeader
			urlMcpMarketing={urlMcpMarketing}
			activeNav={headerActiveNav}
			mcpNavHref={headerMcpNavHref}
		/>
		<slot />
		{showFooter && <SiteFooter variant={footerVariant} />}
		<script is:inline>
			// Design standard: a heading's last line always has at least two words.
			// Join the final two words with a no-break space (covers <br /> headlines
			// and two-word names in narrow columns, which text-wrap: balance misses).
			for (const h of document.querySelectorAll("main h1, main h2, main h3, main h4")) {
				const walker = document.createTreeWalker(h, NodeFilter.SHOW_TEXT);
				let last = null;
				for (let n = walker.nextNode(); n; n = walker.nextNode()) {
					if (n.data.trim()) last = n;
				}
				if (last) last.data = last.data.replace(/\s+(\S+)\s*$/, "\u00a0$1");
			}
		</script>
		<script is:inline>
			(function bindThemeToggle() {
				const key = "aadm-theme";
				function apply(theme) {
					const root = document.documentElement;
					root.classList.toggle("dark", theme === "dark");
					root.dataset.theme = theme;
					root.style.colorScheme = theme;
					localStorage.setItem(key, theme);
					const meta = document.querySelector('meta[name="theme-color"]');
					if (meta) meta.setAttribute("content", theme === "dark" ? "#05040a" : "#f6f4fb");
					for (const btn of document.querySelectorAll("[data-theme-toggle]")) {
						btn.setAttribute(
							"aria-label",
							theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
						);
					}
				}
				document.addEventListener("click", function (event) {
					const btn = event.target instanceof Element ? event.target.closest("[data-theme-toggle]") : null;
					if (!btn) return;
					apply(document.documentElement.classList.contains("dark") ? "light" : "dark");
				});
				apply(document.documentElement.classList.contains("dark") ? "dark" : "light");
			})();
		</script>
	</body>
</html>
