# Copy to .env — no spaces after =.
# AUTH: docs/CLERK-AUTH.md — login on accounts.aadm.io; member area on aadm.io/member

PUBLIC_STANDARD_REPO_URL=https://github.com/your-org/aadm-standard
PUBLIC_MCP_REPO_URL=https://mcp.aadm.io
PUBLIC_MCP_QUICKSTART_URL=https://aadm.io/mcp

# Clerk (@clerk/astro)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Account Portal (sign-in/up only — CNAME on accounts.aadm.io)
PUBLIC_CLERK_SIGN_IN_URL=https://accounts.aadm.io/sign-in
PUBLIC_CLERK_SIGN_UP_URL=https://accounts.aadm.io/sign-up

# Member area (protected aadm.io/member — embedded UserProfile)
# PUBLIC_MEMBER_AREA_PATH=/member
CLERK_OAUTH_CLIENT_ID=your_clerk_oauth_client_id

PUBLIC_CLERK_AUTHORIZED_PARTIES=https://aadm.io,https://www.aadm.io
