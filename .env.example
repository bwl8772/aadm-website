# Copy to .env — no spaces after =.
PUBLIC_STANDARD_REPO_URL=https://github.com/your-org/aadm-standard
# Streamable HTTP MCP endpoint (path usually /mcp).
PUBLIC_MCP_REPO_URL=https://your-mcp-host.example.com/mcp
# Deploy landing or operator portal (shown on "Get MCP Access").
PUBLIC_MCP_QUICKSTART_URL=https://your-mcp-host.example.com/
# Optional: aadm-mcp source on GitHub (integration + setup links on the site).
PUBLIC_MCP_GITHUB_URL=https://github.com/your-org/aadm-mcp
