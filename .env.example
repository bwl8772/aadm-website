# Copy to .env — no spaces after =.

# Public standard (GitHub or site root).
PUBLIC_STANDARD_REPO_URL=https://github.com/your-org/aadm-standard

# MCP: Streamable HTTP endpoint — path must be /mcp (see discovery JSON at service root).
# Example: https://mcp.aadm.io/mcp
PUBLIC_MCP_REPO_URL=https://your-mcp-service.example.com/mcp

# Subscriber-facing documentation site — often your main domain, not the MCP API host.
# Example: https://aadm.io/mcp
PUBLIC_MCP_QUICKSTART_URL=https://your-site.example.com/mcp

# Optional: second doc base (internal playbook, Notion, etc.)
# PUBLIC_MCP_CUSTOMER_DOCS_URL=

# Astro marketing site (src/pages): header “Log in” / “Sign up” links — must use PUBLIC_ prefix.
PUBLIC_CLERK_SIGN_IN_URL=https://accounts.aadm.io/sign-in
PUBLIC_CLERK_SIGN_UP_URL=https://accounts.aadm.io/sign-up

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=Value

CLERK_SECRET_KEY=Value

# Auth URLs — production uses Clerk Account Portal on accounts.aadm.io.
# Use absolute https URLs so this app redirects to the portal; use /sign-in and /sign-up for embedded UI only.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://accounts.aadm.io/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://accounts.aadm.io/sign-up
# “Manage account” / UserButton → hosted user profile (Clerk Dashboard → Paths must allow your app return URLs).
NEXT_PUBLIC_CLERK_USER_PROFILE_URL=https://accounts.aadm.io/user
# After Account Portal sign-in/up when no redirect_url is present (omit or use / to default to Profile in app code).
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/profile
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/profile

# Unauthorized sign-in confirmation lives on the portal; path is configured in Clerk Dashboard → Paths
# (live: https://accounts.aadm.io/unauthorized-sign-in). No separate env var required in this app.

STRIPE_SECRET_KEY=Value

STRIPE_PRICE_ID=Value

STRIPE_WEBHOOK_SECRET=Value

