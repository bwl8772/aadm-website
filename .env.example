# Copy to .env — no spaces after =.

# Public standard (GitHub or site root).
PUBLIC_STANDARD_REPO_URL=https://github.com/your-org/aadm-standard

# MCP: Streamable HTTP endpoint — path must be /mcp (see discovery JSON at service root).
# Example: https://mcp.aadm.io/mcp
PUBLIC_MCP_REPO_URL=https://your-mcp-service.example.com/mcp

# Subscriber-facing documentation site — often your main domain, not the MCP API host.
# Example: https://aadm.io/mcp
PUBLIC_MCP_QUICKSTART_URL=https://your-site.example.com/mcp

# Optional: second doc base (internal playbook, Notion, etc.)
# PUBLIC_MCP_CUSTOMER_DOCS_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=Value

CLERK_SECRET_KEY=Value

# Dedicated auth routes (my-clerk-app). Set these so SignIn/SignUp and redirects resolve correctly.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

STRIPE_SECRET_KEY=Value

STRIPE_PRICE_ID=Value

STRIPE_WEBHOOK_SECRET=Value

