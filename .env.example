# Copy to .env — no spaces after =.
# AUTH: docs/CLERK-AUTH.md — login on accounts.aadm.io; member area on aadm.io/member

PUBLIC_STANDARD_REPO_URL=https://github.com/your-org/aadm-standard
PUBLIC_MCP_REPO_URL=https://mcp.aadm.io
PUBLIC_MCP_QUICKSTART_URL=https://aadm.io/mcp

# Narrated demo signup (standard-onboard) — never commit real passwords
# DEMO_SIGNUP_FIRST_NAME=Auto
# DEMO_SIGNUP_LAST_NAME=Composer
# DEMO_SIGNUP_EMAIL=auto.composer+clerk_test@your-domain.com
# DEMO_SIGNUP_PASSWORD=
# DEMO_SIGNUP_OTP=424242

# Clerk (@clerk/astro) — both keys from the SAME instance (pk_live + sk_live, or pk_test + sk_test).
# /health answers 503 when either is missing, they mismatch, or Clerk rejects the secret key,
# so Railway refuses the release instead of looping users between aadm.io and accounts.aadm.io.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Account Portal (sign-in/up only — CNAME on accounts.aadm.io)
PUBLIC_CLERK_SIGN_IN_URL=https://accounts.aadm.io/sign-in
PUBLIC_CLERK_SIGN_UP_URL=https://accounts.aadm.io/sign-up
PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=https://aadm.io/member
PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=https://aadm.io/member

# accounts.aadm.io is Account Portal on primary aadm.io — NOT a satellite domain
PUBLIC_CLERK_IS_SATELLITE=false

# Member area (protected aadm.io/member — embedded UserProfile; path is /member only)
CLERK_OAUTH_CLIENT_ID=your_clerk_oauth_client_id
# One shared Clerk OAuth app Client ID for all members (server-only — not PUBLIC_)

PUBLIC_CLERK_AUTHORIZED_PARTIES=https://aadm.io,https://www.aadm.io

# Field backend (server-only, never PUBLIC_). Unset = Field commands and live updates
# are off and /health reports backend.configured=false. The website speaks API version 1.
# FIELD_API_URL=https://api.aadm.io
# Example Field screens from src/components/field/fixtures/ (never in production)
# PUBLIC_FIELD_FIXTURES=1
# Reported in /health (ENV-05): dev | qa | prod
# AADM_ENV=dev
