# Copy to .env — no spaces after =.

# === Public site (Astro marketing) ==========================================

# Public standard (GitHub or site root).
PUBLIC_STANDARD_REPO_URL=https://github.com/your-org/aadm-standard

# MCP service (Streamable HTTP JSON-RPC). Origin only — default production: https://mcp.aadm.io (not aadm.io/mcp).
PUBLIC_MCP_REPO_URL=https://mcp.aadm.io

# MCP marketing page (default in code if unset: https://aadm.io/mcp). Uncomment to override, e.g. local:
# PUBLIC_MCP_QUICKSTART_URL=http://localhost:4321/mcp
PUBLIC_MCP_QUICKSTART_URL=https://aadm.io/mcp

# Optional: second doc base (internal playbook, Notion, etc.)
# PUBLIC_MCP_CUSTOMER_DOCS_URL=

# === Clerk (Astro SSR via @clerk/astro) =====================================
# Required at build + runtime. Sign-in / sign-up / sign-out are handled by Clerk
# components and middleware (no hand-rolled JS). Account Portal lives on
# accounts.<your-domain>.com — configure the same domain in the Clerk Dashboard.

PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Account Portal URLs for header/body auth links (defaults match accounts.aadm.io if unset).
# PUBLIC_CLERK_SIGN_IN_URL=https://accounts.aadm.io/sign-in
# PUBLIC_CLERK_SIGN_UP_URL=https://accounts.aadm.io/sign-up
# PUBLIC_CLERK_USER_PROFILE_URL=https://accounts.aadm.io/user

# Optional: comma-separated browser origins Clerk should treat as first-party for this app.
# Use when local dev or staging must not bounce to the Dashboard “Application URL” (e.g. https://aadm.io).
# Example: PUBLIC_CLERK_AUTHORIZED_PARTIES=http://localhost:4321,https://aadm.io
# PUBLIC_CLERK_AUTHORIZED_PARTIES=

# === Next app (`my-clerk-app`) ==============================================
# Same Clerk instance, Next.js naming.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY is shared with the Astro app (already set above).

NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://accounts.aadm.io/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://accounts.aadm.io/sign-up
NEXT_PUBLIC_CLERK_USER_PROFILE_URL=https://accounts.aadm.io/user

# Optional MCP overrides for the Next app:
# NEXT_PUBLIC_MCP_HTTP_URL=https://mcp.aadm.io
# NEXT_PUBLIC_MCP_REPO_URL=https://mcp.aadm.io

# Same Clerk OAuth Client ID — accounts portal only (accounts.aadm.io/user, /dashboard/tokens).
# Prefer CLERK_OAUTH_CLIENT_ID (runtime, same var as /oauth/mcp/start).
# CLERK_OAUTH_CLIENT_ID=your_clerk_oauth_client_id
# NEXT_PUBLIC_MCP_OAUTH_CLIENT_ID=your_clerk_oauth_client_id

# === Stripe (Next app) ======================================================

STRIPE_SECRET_KEY=Value
STRIPE_PRICE_ID=Value
STRIPE_WEBHOOK_SECRET=Value
