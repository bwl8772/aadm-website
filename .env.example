# Copy to .env — no spaces after =.
#
# Astro app only (repo root). Production: Astro SSR + @clerk/astro.

# === Public site (Astro) =====================================================

# Public standard (GitHub or site root).
PUBLIC_STANDARD_REPO_URL=https://github.com/your-org/aadm-standard

# MCP service (Streamable HTTP JSON-RPC). Origin only — default production: https://mcp.aadm.io (not aadm.io/mcp).
PUBLIC_MCP_REPO_URL=https://mcp.aadm.io

# MCP marketing page (default in code if unset: https://aadm.io/mcp). Uncomment to override, e.g. local:
# PUBLIC_MCP_QUICKSTART_URL=http://localhost:4321/mcp
PUBLIC_MCP_QUICKSTART_URL=https://aadm.io/mcp

# Optional: second doc base (internal playbook, Notion, etc.)
# PUBLIC_MCP_CUSTOMER_DOCS_URL=

# === Clerk (@clerk/astro on Astro SSR) ======================================
# Required at build + runtime. Sign-in / sign-up use Clerk Account Portal on
# accounts.<your-domain>.com — configure that domain in the Clerk Dashboard.

PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Account Portal URLs for header/body auth links (defaults match accounts.aadm.io if unset).
# PUBLIC_CLERK_SIGN_IN_URL=https://accounts.aadm.io/sign-in
# PUBLIC_CLERK_SIGN_UP_URL=https://accounts.aadm.io/sign-up
# PUBLIC_CLERK_USER_PROFILE_URL=https://accounts.aadm.io/user

# Shared Clerk OAuth application Client ID — shown on protected /account/mcp (not public /mcp, not Clerk /user).
# Same OAuth app as the MCP server (aadm-mcp). Prefer runtime on Railway:
# CLERK_OAUTH_CLIENT_ID=your_clerk_oauth_client_id
# Optional build-time fallback:
# PUBLIC_MCP_OAUTH_CLIENT_ID=your_clerk_oauth_client_id

# Optional: comma-separated browser origins for Clerk authorizedParties (local dev + production).
# Example: PUBLIC_CLERK_AUTHORIZED_PARTIES=http://localhost:4321,https://aadm.io
# PUBLIC_CLERK_AUTHORIZED_PARTIES=
